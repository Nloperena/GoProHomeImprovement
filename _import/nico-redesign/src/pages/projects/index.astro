---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { defaultTitle } from '../../lib/seo';

const projects = await getCollection('projects');
const title = defaultTitle('Our Work & Featured Projects');
const description = 'See real home improvement results from homes across Orlando and Central Florida. Painting, pressure washing, home theaters, and more.';
---

<Base title={title} description={description} path="/projects/">
	<section class="bg-cream/40 px-4 py-16 md:px-6 md:py-24 lg:px-8 border-b border-line">
		<div class="mx-auto max-w-content text-center">
			<h1 class="font-display text-4xl font-semibold text-ink md:text-5xl">Our Work</h1>
			<p class="mt-4 text-lg text-slate max-w-2xl mx-auto">
				Real results from real homes across Central Florida. Browse our featured projects.
			</p>
		</div>
	</section>

	<section class="px-4 py-16 md:px-6 md:py-24 lg:px-8">
		<div class="mx-auto max-w-content">
			{projects.length > 0 ? (
				<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
					{projects.map((project) => (
						<ProjectCard
							title={project.data.title}
							location={project.data.location}
							slug={project.id}
							image={project.data.heroImage}
						/>
					))}
				</div>
			) : (
				<div class="text-center py-20 bg-cream rounded-sm border border-line">
					<p class="text-slate text-lg">Project case studies are coming soon.</p>
				</div>
			)}
		</div>
	</section>
</Base>
