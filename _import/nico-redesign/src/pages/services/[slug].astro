---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import { absoluteUrl } from '../../lib/seo';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
	const services = await getCollection('services');
	return services.map((service) => ({
		params: { slug: service.id },
		props: { service },
	}));
}

const { service } = Astro.props;
const { Content } = await render(service);

const { data } = service;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: data.title,
	description: data.metaDescription,
	provider: {
		'@id': absoluteUrl('', Astro.site), // Reference the LocalBusiness
	},
	areaServed: {
		'@type': 'State',
		name: 'Florida',
	},
};

const faqSchema = data.faq.length > 0 ? {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: data.faq.map((f) => ({
		'@type': 'Question',
		name: f.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: f.body, // or answer
		},
	})),
} : null;

const schemas = [schema, faqSchema].filter(Boolean);
---

<Base
	title={data.metaTitle}
	description={data.metaDescription}
	path={`/services/${service.id}/`}
	ogImage={data.ogImage || data.heroImage}
	extraSchema={schemas as any}
>
	<article>
		<div class="bg-cream/40 border-b border-line px-4 py-8 md:px-6 lg:px-8">
			<div class="mx-auto max-w-content">
				<Breadcrumbs
					crumbs={[
						{ label: 'Services', href: '/services/' },
						{ label: data.shortTitle },
					]}
				/>
				<div class="mt-8 grid md:grid-cols-2 gap-12 items-center pb-12">
					<div>
						<h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-semibold text-ink leading-tight">
							{data.title}
						</h1>
						<p class="mt-6 text-lg text-slate leading-relaxed">
							{data.excerpt}
						</p>
						<div class="mt-8">
							<a
								href="/quote/"
								class="inline-flex items-center justify-center rounded-sm bg-orange px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-orange-deep"
							>
								Get a Free Quote
							</a>
						</div>
					</div>
					<div class="relative aspect-[4/3] w-full rounded-sm overflow-hidden bg-cream border border-line">
						<Image
							src={data.heroImage}
							alt={data.heroAlt}
							width={800}
							height={600}
							loading="eager"
							fetchpriority="high"
							class="absolute inset-0 h-full w-full object-cover"
						/>
					</div>
				</div>
			</div>
		</div>

		<div class="px-4 py-16 md:px-6 md:py-24 lg:px-8">
			<div class="mx-auto max-w-content grid lg:grid-cols-12 gap-12">
				<div class="lg:col-span-7 prose prose-lg prose-slate prose-headings:font-display prose-headings:font-semibold prose-a:text-orange hover:prose-a:text-orange-deep">
					<Content />
				</div>
				
				<div class="lg:col-span-5 space-y-12">
					{data.processSteps && data.processSteps.length > 0 && (
						<div class="bg-paper border border-line rounded-sm p-6 md:p-8">
							<h3 class="font-display text-2xl font-semibold mb-6">Our Process</h3>
							<ul class="space-y-6">
								{data.processSteps.map((step, i) => (
									<li class="flex gap-4">
										<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cream text-orange font-semibold text-sm">
											{i + 1}
										</div>
										<div>
											<h4 class="font-semibold text-ink">{step.title}</h4>
											<p class="mt-1 text-sm text-slate leading-relaxed">{step.body}</p>
										</div>
									</li>
								))}
							</ul>
						</div>
					)}

					<div class="bg-paper border border-line rounded-sm p-6 md:p-8">
						<h3 class="font-display text-2xl font-semibold mb-6">Scope Details</h3>
						
						{data.includes && data.includes.length > 0 && (
							<div class="mb-6">
								<h4 class="font-semibold text-ink flex items-center text-sm uppercase tracking-wide">
									<span class="text-green-600 mr-2">✓</span> What's Included
								</h4>
								<ul class="mt-3 space-y-2 text-sm text-slate">
									{data.includes.map(item => (
										<li class="pl-6 relative before:content-[''] before:absolute before:left-2 before:top-2 before:w-1.5 before:h-1.5 before:bg-line before:rounded-full">{item}</li>
									))}
								</ul>
							</div>
						)}

						{data.excludes && data.excludes.length > 0 && (
							<div>
								<h4 class="font-semibold text-ink flex items-center text-sm uppercase tracking-wide">
									<span class="text-red-500 mr-2">✕</span> What's Not Included
								</h4>
								<ul class="mt-3 space-y-2 text-sm text-slate">
									{data.excludes.map(item => (
										<li class="pl-6 relative before:content-[''] before:absolute before:left-2 before:top-2 before:w-1.5 before:h-1.5 before:bg-line before:rounded-full">{item}</li>
									))}
								</ul>
							</div>
						)}
					</div>

					{(data.startingPrice || data.typicalDuration) && (
						<div class="bg-cream border border-line rounded-sm p-6">
							<h3 class="font-display text-xl font-semibold mb-4">Project Expectations</h3>
							<dl class="space-y-4 text-sm">
								{data.startingPrice && (
									<div>
										<dt class="font-medium text-ink uppercase tracking-wide text-xs">Starting Price</dt>
										<dd class="mt-1 text-slate">{data.startingPrice}</dd>
									</div>
								)}
								{data.typicalDuration && (
									<div>
										<dt class="font-medium text-ink uppercase tracking-wide text-xs">Typical Duration</dt>
										<dd class="mt-1 text-slate">{data.typicalDuration}</dd>
									</div>
								)}
							</dl>
						</div>
					)}
				</div>
			</div>
		</div>

		{data.faq && data.faq.length > 0 && (
			<div class="bg-paper border-t border-line px-4 md:px-6 lg:px-8">
				<FAQ items={data.faq.map(f => ({ question: f.question, answer: f.body || '' }))} />
			</div>
		)}
		
		<section class="bg-orange px-4 py-16 md:px-6 md:py-24 lg:px-8 text-center text-white">
			<div class="mx-auto max-w-2xl">
				<h2 class="font-display text-3xl font-semibold md:text-4xl">Ready to get started?</h2>
				<p class="mt-4 text-white/90 text-lg">Contact us today for a free, scope-clear estimate on your project.</p>
				<a
					href="/quote/"
					class="mt-8 inline-flex items-center justify-center rounded-sm bg-white px-8 py-4 text-sm font-semibold text-orange transition-colors hover:bg-cream"
				>
					Get a Free Quote
				</a>
			</div>
		</section>
	</article>
</Base>
