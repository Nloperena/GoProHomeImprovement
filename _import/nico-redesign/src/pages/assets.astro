---
import Base from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

function getFiles(dir: string, fileList: string[] = []) {
	if (!fs.existsSync(dir)) return fileList;
	const files = fs.readdirSync(dir);
	for (const file of files) {
		const stat = fs.statSync(path.join(dir, file));
		if (stat.isDirectory()) {
			getFiles(path.join(dir, file), fileList);
		} else {
			fileList.push(path.join(dir, file));
		}
	}
	return fileList;
}

const publicDir = path.join(process.cwd(), 'public');
const imageDir = path.join(publicDir, 'images');
const allFiles = getFiles(imageDir);
const assets = allFiles.map(file => file.replace(publicDir, '').replace(/\\/g, '/'));
---

<Base title="Asset Manager" description="Manage project assets">
	<section class="px-4 py-12 md:px-6 lg:px-8">
		<div class="mx-auto max-w-content">
			<div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
				<div>
					<h1 class="font-display text-3xl font-semibold text-ink md:text-4xl">Asset Manager</h1>
					<p class="mt-2 text-slate">Click any asset to copy its absolute path for use in your content.</p>
				</div>
				<div class="text-sm font-medium text-slate bg-cream px-3 py-1 rounded-sm border border-line">
					{assets.length} assets found
				</div>
			</div>

			<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
				{assets.map((asset) => (
					<button
						type="button"
						class="asset-btn group flex flex-col overflow-hidden rounded-sm border border-line bg-paper p-2 text-left transition-colors hover:border-orange hover:shadow-sm"
						data-path={asset}
					>
						<div class="relative aspect-square w-full overflow-hidden rounded-sm bg-cream">
							<img
								src={asset}
								alt={asset}
								loading="lazy"
								class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
							/>
						</div>
						<div class="mt-2 w-full overflow-hidden">
							<p class="truncate font-mono text-xs text-slate" title={asset}>
								{asset.split('/').pop()}
							</p>
							<p class="truncate font-mono text-[10px] text-slate/60 mt-0.5" title={asset}>
								{asset.split('/').slice(0, -1).join('/')}
							</p>
						</div>
					</button>
				))}
			</div>
		</div>
	</section>

	<div id="toast" class="fixed bottom-6 right-6 translate-y-20 opacity-0 transition-all duration-300 bg-ink text-white px-5 py-3 rounded-sm text-sm font-medium shadow-lg z-50 flex items-center gap-2">
		<svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
		<span id="toast-msg">Copied to clipboard</span>
	</div>

	<script>
		const buttons = document.querySelectorAll('.asset-btn');
		const toast = document.getElementById('toast');
		const toastMsg = document.getElementById('toast-msg');
		let toastTimeout: ReturnType<typeof setTimeout>;

		buttons.forEach(btn => {
			btn.addEventListener('click', async () => {
				const path = btn.getAttribute('data-path');
				if (path) {
					try {
						await navigator.clipboard.writeText(path);
						if (toast && toastMsg) {
							toastMsg.textContent = `Copied: ${path}`;
							toast.classList.remove('translate-y-20', 'opacity-0');
							
							clearTimeout(toastTimeout);
							toastTimeout = setTimeout(() => {
								toast.classList.add('translate-y-20', 'opacity-0');
							}, 2000);
						}
					} catch (err) {
						console.error('Failed to copy text: ', err);
					}
				}
			});
		});
	</script>
</Base>
