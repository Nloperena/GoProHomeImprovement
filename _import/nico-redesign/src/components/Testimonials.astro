---
type Review = {
	text: string;
	author: string;
	location: string;
};

type Props = {
	reviews: Review[];
};

const { reviews } = Astro.props;
---

<section class="bg-cream px-4 py-16 md:px-6 md:py-24 lg:px-8">
	<div class="mx-auto max-w-content">
		<div class="text-center">
			<h2 class="font-display text-3xl font-semibold md:text-4xl">What our clients say</h2>
			<p class="mt-4 text-slate">Real reviews from homeowners across Central Florida.</p>
		</div>

		{reviews.length > 0 ? (
			<div class="mt-12 grid gap-8 md:grid-cols-3">
				{reviews.map((review) => (
					<div class="rounded-sm bg-paper p-6 shadow-sm border border-line">
						<div class="flex text-orange mb-4">
							{'★★★★★'.split('').map((star) => (
								<span>{star}</span>
							))}
						</div>
						<p class="text-slate italic">"{review.text}"</p>
						<div class="mt-6 font-medium text-ink">
							{review.author}
							<span class="block text-sm font-normal text-slate">{review.location}</span>
						</div>
					</div>
				))}
			</div>
		) : (
			<div class="mt-12 text-center text-slate">
				<p>Pulling Google reviews — add <code>reviewsSource</code> env var or wait for sync.</p>
			</div>
		)}
	</div>
</section>
