	>
		<div class="max-w-sm">
			<img src="/logo-footer.png" alt="Go Pro Home Improvements" class="h-12 w-auto brightness-0 invert opacity-90" />
			<p class="mt-4 text-sm text-paper/80">Serving all of Central Florida</p>
		</div>
		<div class="mt-8 text-sm md:mt-0">
			<p>
				<a href="tel:4072446873" class="text-paper hover:underline">(407) 244-6873</a>
			</p>
			<p class="mt-1">
				<a href="mailto:gopro4good@gmail.com" class="text-paper/80 hover:underline"
