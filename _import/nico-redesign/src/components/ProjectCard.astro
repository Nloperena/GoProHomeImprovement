---
import { Image } from 'astro:assets';

type Props = {
	title: string;
	location: string;
	slug: string;
	image: string;
};

const { title, location, slug, image } = Astro.props;
---

<a
	href={`/projects/${slug}/`}
	class="group relative block overflow-hidden rounded-sm bg-ink"
>
	<div class="aspect-[4/3] w-full opacity-80 transition-opacity duration-300 group-hover:opacity-100">
		<Image
			src={image}
			alt={title}
			width={800}
			height={600}
			class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
		/>
	</div>
	<div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/20 to-transparent"></div>
	<div class="absolute bottom-0 left-0 w-full p-5 md:p-6">
		<p class="text-xs font-medium uppercase tracking-wider text-orange">
			{location}
		</p>
		<h3 class="mt-1 font-display text-xl font-medium text-paper md:text-2xl">
			{title}
		</h3>
	</div>
</a>
