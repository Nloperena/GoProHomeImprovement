---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const nextSteps = [
  'You send this form, or you call.',
  'The owner calls you to go over the job.',
  'If we need to see the house, we set a time. Someone needs to be there.',
  'You get a written estimate. There is no charge for it.',
  'If you say yes, we schedule the work.',
];

const before = [
  ['Is the estimate free?', "Yes. The form and the phone call don't cost anything."],
  ['Who calls me back?', 'The owner. Not a salesperson.'],
  ['What if the job is small?', 'Call anyway. One room, a drywall patch, a TV mount, and a driveway wash are all jobs we do.'],
  ['Do I have to be home?', 'For a visit, yes. Someone needs to let us see the work. If photos are enough, text them to (407) 244-6873.'],
  ['Where do you work?', 'Kissimmee, Orlando, St. Cloud, Celebration, Poinciana, and nearby Central Florida.'],
];
---

<BaseLayout
  title="Free Estimate | Painting, Theaters, Drywall | Kissimmee & Orlando | Go Pro"
  description="Request a free estimate for painting, home theaters, drywall & more. Owner-operated, 15+ years serving Kissimmee, Orlando & Central Florida."
>
  <Header />
  <main id="main">
    <header class="page-intro">
      <div class="container-custom">
        <p class="kicker">04 / The price</p>
        <h1>Request a free estimate</h1>
        <p class="lede">Tell us the job and the city. The owner calls you back. Monday through Friday, 7 AM to 5 PM.</p>
      </div>
    </header>

    <section class="section-padding" style="padding-top: 1.5rem;">
      <div class="container-custom estimate-layout">
        <aside class="estimate-aside">
          <p class="kicker">Prefer to call?</p>
          <p class="mt-4 text-[1.35rem] leading-snug">
            <a href="tel:4072446873" class="text-link">(407) 244-6873</a>
          </p>
          <p class="mt-6 text-[var(--ink-soft)]">
            Call Monday through Friday, 7 AM to 5 PM. If we're on a job, leave a message and we'll call back.
          </p>
          <p class="mt-4 text-sm text-[var(--ink-soft)]">
            Email <a href="mailto:gopro4good@gmail.com" class="underline">gopro4good@gmail.com</a>
          </p>
        </aside>

        <div class="form-panel">
          <form id="estimate-form" class="space-y-7">
            <div class="grid md:grid-cols-2 gap-x-8 gap-y-7">
              <div>
                <label for="name" class="field-label">Full name <span class="req">*</span></label>
                <input class="field" type="text" id="name" name="name" required autocomplete="name" placeholder="John Smith" />
              </div>
              <div>
                <label for="phone" class="field-label">Phone number <span class="req">*</span></label>
                <input class="field" type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="(407) 555-1234" />
              </div>
            </div>

            <div>
              <label for="email" class="field-label">Email address <span class="req">*</span></label>
              <input class="field" type="email" id="email" name="email" required autocomplete="email" placeholder="john@example.com" />
            </div>

            <div class="grid md:grid-cols-2 gap-x-8 gap-y-7">
              <div>
                <label for="service" class="field-label">Service type <span class="req">*</span></label>
                <select class="field" id="service" name="service" required>
                  <option value="">Select a service...</option>
                  <option value="interior-exterior-painting">Painting (Interior & Exterior)</option>
                  <option value="movie-rooms">Home Theater / Movie Room</option>
                  <option value="drywall">Drywall (Repair & Installation)</option>
                  <option value="power-washing">Power Washing</option>
                  <option value="trim-crown-molding">Trim & Crown Molding</option>
                  <option value="murals">Custom Murals</option>
                  <option value="tv-mounting">TV Mounting</option>
                  <option value="wallpaper">Wallpaper</option>
                  <option value="demolition">Demolition</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label for="city" class="field-label">City <span class="req">*</span></label>
                <input class="field" type="text" id="city" name="city" required autocomplete="address-level2" placeholder="Kissimmee" />
              </div>
            </div>

            <div>
              <label for="message" class="field-label">Project details <span class="req">*</span></label>
              <textarea class="field" id="message" name="message" required rows="6" placeholder="What needs to be done, and roughly how big is it?"></textarea>
              <p class="text-sm text-[var(--ink-soft)] mt-3">
                Optional: You can also text photos of the project area to <a href="tel:4072446873" class="underline">(407) 244-6873</a>
              </p>
            </div>

            <div style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden;" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div>
              <button type="submit" class="btn-primary">Request my free estimate</button>
            </div>

            <p class="text-sm text-[var(--ink-soft)] border-t border-[var(--line)] pt-5">
              The estimate is free. You talk to the owner. Monday through Friday, 7 AM to 5 PM.
            </p>
          </form>

          <div id="form-success" class="hidden">
            <div class="py-8">
              <p class="kicker">Sent</p>
              <h2 class="text-4xl mt-3 mb-4">We got it.</h2>
              <p class="text-[var(--ink-soft)] mb-6">
                The owner will call you during business hours, Monday through Friday, 7 AM to 5 PM.
              </p>
              <p class="text-[var(--ink-soft)]">
                Questions in the meantime? Call <a href="tel:4072446873" class="underline">(407) 244-6873</a>
              </p>
            </div>
          </div>

          <div id="form-error" class="hidden">
            <div class="border-l-4 border-red-700 pl-4 py-2" role="alert">
              <p class="font-semibold mb-1">Submission error</p>
              <p class="text-red-800">
                There was a problem submitting your request. Please try again or call us directly at <a href="tel:4072446873" class="underline">(407) 244-6873</a>.
              </p>
            </div>
          </div>

          <div class="mt-16">
            <h2 class="text-3xl mb-6">What happens next</h2>
            <ol class="steps stack">
              {nextSteps.map((step, i) => (
                <li>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <p>{step}</p>
                </li>
              ))}
            </ol>
          </div>

          <div class="faq mt-16">
            <h2 class="text-3xl mb-2">Before you send it</h2>
            {before.map(([q, a]) => (
              <article>
                <h3>{q}</h3>
                <p>{a}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const form = document.getElementById('estimate-form') as HTMLFormElement;
    const formSuccess = document.getElementById('form-success');
    const formError = document.getElementById('form-error');

    const formStartedAt = Date.now();

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      (data as any).formStartedAt = formStartedAt;
      (data as any).website = (data as any).website || '';

      try {
        const response = await fetch('/api/estimate', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          form.classList.add('hidden');
          formSuccess?.classList.remove('hidden');
          formError?.classList.add('hidden');
        } else {
          let errorMessage = 'There was a problem submitting your request. Please try again or call us directly at <a href="tel:4072446873" class="underline">(407) 244-6873</a>.';
          try {
            const errorData = await response.json();
            if (errorData.error) {
              errorMessage = errorData.error;
            }
          } catch {
            // Use the default message if JSON parsing fails
          }

          const errorElement = formError?.querySelector('.text-red-800');
          if (errorElement) {
            errorElement.innerHTML = errorMessage;
          }
          formError?.classList.remove('hidden');
        }
      } catch (error) {
        console.error('Form submission error:', error);
        formError?.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
