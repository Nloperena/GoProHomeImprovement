---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Free Estimate | Painting, Theaters, Drywall | Kissimmee & Orlando | Go Pro"
  description="Request a free estimate for painting, home theaters, drywall & more. Owner-operated, 15+ years serving Kissimmee, Orlando & Central Florida."
>
  <Header />

  <section class="bg-gradient-to-br from-gopro-black to-gray-900 text-white py-12">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-display font-black uppercase mb-4 tracking-tight">Get Your Free Estimate</h1>
        <p class="text-xl text-gray-300 mb-6 font-sans">
          Owner-operated. 15+ years serving Kissimmee, Orlando, St. Cloud, Celebration & Poinciana.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <p class="text-gray-400 font-sans">Prefer to call?</p>
          <a href="tel:4072446873" class="bg-gopro-orange hover:bg-orange-600 text-gopro-black font-display font-bold uppercase px-8 py-4 rounded text-lg transition-colors inline-block shadow-lg tracking-wide">
            (407) 244-6873
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg p-8 md:p-12">
          <form id="estimate-form" class="space-y-6" novalidate>
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
                  Full Name <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  minlength="2"
                  maxlength="80"
                  aria-describedby="name-error"
                  class="w-full min-h-12 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gopro-orange focus:border-transparent transition-colors"
                  placeholder="John Smith"
                />
                <p id="name-error" class="hidden text-sm text-red-700 mt-1"></p>
              </div>

              <div>
                <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">
                  Phone Number <span class="text-red-500">*</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  autocomplete="tel"
                  inputmode="tel"
                  aria-describedby="phone-error"
                  class="w-full min-h-12 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gopro-orange focus:border-transparent transition-colors"
                  placeholder="(407) 555-1234"
                />
                <p id="phone-error" class="hidden text-sm text-red-700 mt-1"></p>
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
                Email Address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                inputmode="email"
                aria-describedby="email-error"
                class="w-full min-h-12 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gopro-orange focus:border-transparent transition-colors"
                placeholder="john@example.com"
              />
              <p id="email-error" class="hidden text-sm text-red-700 mt-1"></p>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="service" class="block text-sm font-semibold text-gray-700 mb-2">
                  Service Type <span class="text-red-500">*</span>
                </label>
                <select
                  id="service"
                  name="service"
                  required
                  aria-describedby="service-error"
                  class="w-full min-h-12 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gopro-orange focus:border-transparent transition-colors"
                >
                  <option value="">Select a service...</option>
                  <option value="interior-exterior-painting">Painting (Interior & Exterior)</option>
                  <option value="movie-rooms">Home Theater / Movie Room</option>
                  <option value="drywall">Drywall (Repair & Installation)</option>
                  <option value="power-washing">Power Washing</option>
                  <option value="trim-crown-molding">Trim & Crown Molding</option>
                  <option value="murals">Custom Murals</option>
                  <option value="tv-mounting">TV Mounting</option>
                  <option value="wallpaper">Wallpaper</option>
                  <option value="demolition">Demolition</option>
                  <option value="other">Other</option>
                </select>
                <p id="service-error" class="hidden text-sm text-red-700 mt-1"></p>
              </div>

              <div>
                <label for="city" class="block text-sm font-semibold text-gray-700 mb-2">
                  City <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="city"
                  name="city"
                  required
                  autocomplete="address-level2"
                  minlength="2"
                  maxlength="60"
                  aria-describedby="city-error"
                  class="w-full min-h-12 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gopro-orange focus:border-transparent transition-colors"
                  placeholder="Kissimmee"
                />
                <p id="city-error" class="hidden text-sm text-red-700 mt-1"></p>
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">
                Project Details <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                minlength="12"
                aria-describedby="message-hint message-error"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gopro-orange focus:border-transparent transition-colors"
                placeholder="Room or area, and what you want done"
              ></textarea>
              <p id="message-hint" class="text-sm text-gray-500 mt-2">A sentence is enough for us to call you back.</p>
              <p id="message-error" class="hidden text-sm text-red-700 mt-1"></p>
              <p class="text-sm text-gray-500 mt-2">
                Optional: You can also text photos of the project area to <a href="tel:4072446873" class="text-gopro-orange hover:underline">(407) 244-6873</a>
              </p>
            </div>

            <!-- Honeypot field - hidden from humans, visible to bots -->
            <div style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden;" aria-hidden="true">
              <label for="website">Website</label>
              <input
                type="text"
                id="website"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="pt-4 scroll-mb-28">
              <button
                type="submit"
                class="w-full btn-primary text-lg py-4 hover:shadow-lg disabled:opacity-70 disabled:cursor-wait"
              >
                Submit Estimate Request
              </button>
              <p class="text-sm text-gray-600 text-center mt-3 font-sans">
                We'll call you to discuss the project. Prefer to talk now?
                <a href="tel:4072446873" class="text-gopro-orange font-semibold hover:underline">(407) 244-6873</a>
              </p>
            </div>
            
            <div class="text-center mt-6 pt-6 border-t border-gray-200">
              <p class="text-sm text-gray-600 font-sans">
                Owner-operated • Serving Kissimmee, Orlando, St. Cloud, Celebration & Poinciana • 15+ years experience
              </p>
            </div>
          </form>

          <div id="form-success" class="hidden">
            <div class="text-center py-12">
              <svg class="w-20 h-20 text-green-500 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <h2 class="text-3xl font-bold text-gray-900 mb-4">Thank You!</h2>
              <p class="text-lg text-gray-600 mb-8">
                We've received your estimate request and will contact you shortly to discuss your project.
              </p>
              <div class="space-y-3 text-gray-600">
                <p>Questions in the meantime?</p>
                <p class="font-semibold">
                  Call us at <a href="tel:4072446873" class="text-gopro-orange hover:underline">(407) 244-6873</a>
                </p>
              </div>
            </div>
          </div>

          <div id="form-error" class="hidden mt-6" tabindex="-1" role="alert">
            <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded">
              <p class="text-red-800 font-semibold mb-2">Submission Error</p>
              <p id="form-error-message" class="text-red-700">
                There was a problem submitting your request. Please try again.
              </p>
              <p class="text-red-700 mt-2">
                Or call <a href="tel:4072446873" class="text-red-800 underline">(407) 244-6873</a>.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-12 grid md:grid-cols-2 gap-8">
          <div class="bg-gray-50 rounded-lg p-8">
            <h3 class="text-xl font-bold mb-4">What Happens Next?</h3>
            <ol class="space-y-3 text-gray-700">
              <li class="flex items-start">
                <span class="font-bold text-gopro-orange mr-3">1.</span>
                <span>We'll review your project details</span>
              </li>
              <li class="flex items-start">
                <span class="font-bold text-gopro-orange mr-3">2.</span>
                <span>We'll call you to discuss specifics and schedule a site visit if needed</span>
              </li>
              <li class="flex items-start">
                <span class="font-bold text-gopro-orange mr-3">3.</span>
                <span>You'll receive a detailed, accurate estimate</span>
              </li>
              <li class="flex items-start">
                <span class="font-bold text-gopro-orange mr-3">4.</span>
                <span>Once approved, we'll schedule your project</span>
              </li>
            </ol>
          </div>

          <div class="bg-gopro-orange text-gopro-black rounded-lg p-8">
            <h3 class="text-xl font-bold mb-4">Prefer to Call?</h3>
            <p class="mb-6">
              We're always available to discuss your project over the phone. Call us directly for immediate assistance.
            </p>
            <a href="tel:4072446873" class="bg-gopro-charcoal text-white hover:bg-gopro-black font-semibold px-6 py-3 rounded-lg transition-colors duration-200 inline-block">
              Call (407) 244-6873
            </a>
            <div class="mt-6 pt-6 border-t border-black/20">
              <p class="text-sm">
                Email: <a href="mailto:gopro4good@gmail.com" class="underline">gopro4good@gmail.com</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    import { initEstimateForm } from '../scripts/estimate-form';
    initEstimateForm();
  </script>
</BaseLayout>
