---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout
  title="Reviews & Testimonials | Go Pro Home Improvements"
  description="See what customers say about Go Pro Home Improvements. View our work gallery and follow us on Instagram for recent projects."
>
  <Header />

  <section class="bg-gradient-to-br from-gopro-black to-gray-900 text-white py-16">
    <div class="container-custom text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Reviews & Reputation</h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">
        Building trust through quality workmanship and reliable service.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            At Go Pro Home Improvements, we believe our work speaks for itself. For over 15 years, we've built our reputation on quality craftsmanship, honest communication, and delivering on our promises.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-16">
          <div class="text-center p-6 bg-gray-50 rounded-lg">
            <div class="text-4xl font-bold text-gopro-orange mb-2">15+</div>
            <div class="text-gray-600 font-semibold">Years in Business</div>
          </div>
          <div class="text-center p-6 bg-gray-50 rounded-lg">
            <div class="text-4xl font-bold text-gopro-orange mb-2">100%</div>
            <div class="text-gray-600 font-semibold">Owner-Operated</div>
          </div>
          <div class="text-center p-6 bg-gray-50 rounded-lg">
            <div class="text-4xl font-bold text-gopro-orange mb-2">Local</div>
            <div class="text-gray-600 font-semibold">Central Florida</div>
          </div>
        </div>

        <div class="bg-gopro-orange text-white rounded-lg p-12 mb-12 text-center">
          <h2 class="text-3xl font-bold mb-4">See Our Work</h2>
          <p class="text-xl mb-8 text-white/90">
            The best reviews come from the quality of the finished project. View our portfolio and recent work to see what we deliver.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/work" class="bg-white text-gopro-orange hover:bg-gray-100 font-semibold px-6 py-3 rounded-lg transition-colors duration-200 inline-block">
              View Our Gallery
            </a>
            <a
              href="https://www.instagram.com/gopro4good/"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-gopro-black hover:bg-gray-800 text-white font-semibold px-6 py-3 rounded-lg transition-colors duration-200 inline-block"
            >
              Follow on Instagram
            </a>
          </div>
        </div>

        <div class="bg-gray-50 border-l-4 border-gopro-orange p-8 mb-12">
          <h2 class="text-2xl font-bold mb-4">Why Customers Choose Go Pro</h2>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span><strong>Direct Communication:</strong> Owner-operated means you work directly with the person responsible for quality.</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span><strong>Transparent Pricing:</strong> Accurate, up-front estimates with no hidden fees or surprises.</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span><strong>Proven Experience:</strong> Over 15 years serving Central Florida homes and businesses.</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span><strong>Quality Materials:</strong> We use premium supplies to ensure lasting results.</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span><strong>Respect for Your Property:</strong> We treat your home with care and leave job sites clean.</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span><strong>Local & Reliable:</strong> Based in Kissimmee, we're part of the Central Florida community.</span>
            </li>
          </ul>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold mb-4 text-center">Have You Worked With Us?</h2>
          <p class="text-gray-600 text-center mb-6">
            If you've had a positive experience with Go Pro Home Improvements, we'd appreciate you sharing it. Your feedback helps us grow and helps future customers make informed decisions.
          </p>
          <div class="text-center">
            <p class="text-gray-600 mb-4">
              We're working on integrating Google reviews here. In the meantime, feel free to reach out directly or follow our recent work on Instagram.
            </p>
          </div>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6">
            Ready to experience quality home improvement services yourself?
          </p>
          <a href="/estimate" class="btn-primary">
            Get Free Estimate
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTASection />

  <Footer />
</BaseLayout>
