---
import Base from '../layouts/Base.astro';
import { defaultTitle } from '../lib/seo';

const title = defaultTitle('Get a Free Quote | Go Pro Home Improvements');
const description = 'Request a free, scope-clear estimate for your next home improvement project in Central Florida.';
---

<Base title={title} description={description} path="/quote/">
	<section class="bg-cream/40 px-4 py-12 md:px-6 lg:px-8 border-b border-line">
		<div class="mx-auto max-w-content text-center">
			<h1 class="font-display text-4xl font-semibold text-ink md:text-5xl">Get a Free Quote</h1>
			<p class="mt-4 text-lg text-slate max-w-2xl mx-auto">
				Fill out the form below and we'll get back to you within 1 business day to schedule a site walk.
			</p>
		</div>
	</section>

	<section class="px-4 py-12 md:px-6 lg:px-8 bg-paper">
		<div class="mx-auto max-w-3xl bg-white border border-line rounded-sm p-6 md:p-10 shadow-sm">
			<form action="https://formspree.io/f/placeholder" method="POST" class="space-y-8">
				<!-- Step 1: Service Type -->
				<div>
					<h3 class="text-xl font-display font-semibold mb-4 border-b border-line pb-2">1. What do you need help with?</h3>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						{['Interior Painting', 'Exterior Painting', 'Pressure Washing', 'TV Mounting', 'Home Theater', 'Drywall Repair', 'Trim & Crown Molding', 'Demolition', 'Other'].map(service => (
							<label class="flex items-center space-x-3 p-3 border border-line rounded-sm cursor-pointer hover:border-orange transition-colors">
								<input type="checkbox" name="services[]" value={service} class="h-4 w-4 text-orange focus:ring-orange border-line rounded" />
								<span class="text-sm font-medium text-ink">{service}</span>
							</label>
						))}
					</div>
				</div>

				<!-- Step 2: Project Details -->
				<div>
					<h3 class="text-xl font-display font-semibold mb-4 border-b border-line pb-2">2. Tell us about the project</h3>
					<div class="space-y-4">
						<div>
							<label for="project_scope" class="block text-sm font-medium text-ink mb-2">Scope of work</label>
							<textarea id="project_scope" name="project_scope" rows="4" placeholder="E.g., I need the exterior of my 2,000 sq ft home painted, plus the driveway pressure washed..." class="w-full rounded-sm border border-line bg-white px-4 py-3 text-sm focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange"></textarea>
						</div>
						<div class="grid sm:grid-cols-2 gap-4">
							<div>
								<label for="timeline" class="block text-sm font-medium text-ink mb-2">Desired Timeline</label>
								<select id="timeline" name="timeline" class="w-full rounded-sm border border-line bg-white px-4 py-3 text-sm focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange">
									<option>As soon as possible</option>
									<option>Within 2-4 weeks</option>
									<option>Within 1-3 months</option>
									<option>Just getting pricing for now</option>
								</select>
							</div>
							<div>
								<label for="budget" class="block text-sm font-medium text-ink mb-2">Budget Range (Optional)</label>
								<select id="budget" name="budget" class="w-full rounded-sm border border-line bg-white px-4 py-3 text-sm focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange">
									<option>Not sure</option>
									<option>Under $1,000</option>
									<option>$1,000 - $3,000</option>
									<option>$3,000 - $10,000</option>
									<option>$10,000+</option>
								</select>
							</div>
						</div>
					</div>
				</div>

				<!-- Step 3: Contact Info -->
				<div>
					<h3 class="text-xl font-display font-semibold mb-4 border-b border-line pb-2">3. Your Contact Details</h3>
					<div class="grid sm:grid-cols-2 gap-4 mb-4">
						<div>
							<label for="first_name" class="block text-sm font-medium text-ink mb-2">First Name</label>
							<input type="text" id="first_name" name="first_name" required class="w-full rounded-sm border border-line bg-white px-4 py-3 text-sm focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
						</div>
						<div>
							<label for="last_name" class="block text-sm font-medium text-ink mb-2">Last Name</label>
							<input type="text" id="last_name" name="last_name" required class="w-full rounded-sm border border-line bg-white px-4 py-3 text-sm focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
						</div>
					</div>
					<div class="grid sm:grid-cols-2 gap-4 mb-4">
						<div>
							<label for="email" class="block text-sm font-medium text-ink mb-2">Email Address</label>
							<input type="email" id="email" name="email" required class="w-full rounded-sm border border-line bg-white px-4 py-3 text-sm focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
						</div>
						<div>
							<label for="phone" class="block text-sm font-medium text-ink mb-2">Phone Number</label>
							<input type="tel" id="phone" name="phone" required class="w-full rounded-sm border border-line bg-white px-4 py-3 text-sm focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
						</div>
					</div>
					<div>
						<label for="address" class="block text-sm font-medium text-ink mb-2">Property Address / City</label>
						<input type="text" id="address" name="address" placeholder="E.g., Winter Park, FL" required class="w-full rounded-sm border border-line bg-white px-4 py-3 text-sm focus:border-orange focus:outline-none focus:ring-1 focus:ring-orange" />
					</div>
				</div>

				<div class="pt-4">
					<button type="submit" class="w-full rounded-sm bg-orange px-6 py-4 text-base font-semibold text-white transition-colors hover:bg-orange-deep flex items-center justify-center space-x-2">
						<span>Submit Request</span>
						<span>→</span>
					</button>
					<p class="text-center text-slate text-xs mt-4">By submitting this form, you agree to be contacted via phone or email regarding your project.</p>
				</div>
			</form>
		</div>
	</section>
</Base>
