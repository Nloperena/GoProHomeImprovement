---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHeader from '../components/home/HomeHeader.astro';
import HomeHero from '../components/home/HomeHero.astro';
import ProofBand from '../components/home/ProofBand.astro';
import BeforeAfter from '../components/home/BeforeAfter.astro';
import ServiceGrid from '../components/home/ServiceGrid.astro';
import PressureWash from '../components/home/PressureWash.astro';
import Reviews from '../components/home/Reviews.astro';
import OwnerSplit from '../components/home/OwnerSplit.astro';
import ProcessSteps from '../components/home/ProcessSteps.astro';
import AreasBand from '../components/home/AreasBand.astro';
import EstimateTicket from '../components/home/EstimateTicket.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import '../styles/home-base.css';
import '../styles/home-hero.css';
import '../styles/home-work.css';
import '../styles/reviews.css';
import '../styles/home-story.css';
import '../styles/home-close.css';
import '../styles/home-layout.css';
---

<BaseLayout
  variant="home"
  title="House Painting & Pressure Washing in Kissimmee, FL | Go Pro Home Improvements"
  description="Interior and exterior house painting, pressure washing, and handyman work in Kissimmee, St. Cloud, Celebration, Poinciana, and Orlando. Owner-run since 2014, 5.0 on Google. Free estimates: (407) 244-6873."
  ogImage="/images/generated/hero-1280.webp"
>
  <HomeHeader />
  <main id="main">
    <HomeHero />
    <ProofBand />
    <BeforeAfter />
    <ServiceGrid />
    <PressureWash />
    <Reviews />
    <OwnerSplit />
    <ProcessSteps />
    <AreasBand />
    <EstimateTicket />
  </main>
  <HomeFooter />
</BaseLayout>

<script>
  const showReveals = () => {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
  };

  const boot = () => {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        import('../scripts/home-motion')
          .then((mod) => mod.startHomeMotion())
          .catch(showReveals);
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>
