---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import HeroHome from '../components/HeroHome.astro';

const rail = [
  { href: '/services/interior-exterior-painting', label: 'Painting' },
  { href: '/services/drywall', label: 'Drywall' },
  { href: '/services/power-washing', label: 'Power washing' },
  { href: '/services/trim-crown-molding', label: 'Trim' },
  { href: '/services/movie-rooms', label: 'Theaters' },
  { href: '/services/murals', label: 'Murals' },
  { href: '/services/wallpaper', label: 'Wallpaper' },
  { href: '/services/tv-mounting', label: 'TV mounting' },
];

const whyChooseUs = [
  {
    title: 'You talk to the owner',
    description: 'The person who quotes the job is the person responsible for it. No salesperson in the middle.'
  },
  {
    title: 'Here since 2014',
    description: 'A Florida corporation based in Kissimmee. We work homes in Orlando, St. Cloud, Celebration, and Poinciana.'
  },
  {
    title: 'Price in writing',
    description: 'You get an estimate before any work starts. If the scope changes, we talk about it first.'
  },
  {
    title: 'We finish the work',
    description: 'Prep, the job itself, and a cleanup when we leave. Monday through Friday, 7 AM to 5 PM.'
  }
];

const services = [
  {
    name: 'Painting',
    href: '/services/interior-exterior-painting',
    description: 'Rooms that look finished. Exteriors that hold up in the sun.',
    image: '/images/bedroom-paint.jpg',
    icon: 'paint',
    alt: 'Painted bedroom with a striped accent wall'
  },
  {
    name: 'Home Theaters',
    href: '/services/movie-rooms',
    description: 'A room set up for movies, not a TV on a stand.',
    image: '/images/movie-room.jpg',
    icon: 'theater',
    alt: 'Home theater seating'
  },
  {
    name: 'Drywall',
    href: '/services/drywall',
    description: 'Holes and water stains patched so the wall matches.',
    image: '/images/drywall.jpg',
    icon: 'drywall',
    alt: 'Drywall repair'
  },
  {
    name: 'Power Washing',
    href: '/services/power-washing',
    description: 'Algae and dirt off the house, driveway, and pool deck.',
    image: '/images/power-washing.jpg',
    icon: 'wash',
    alt: 'Power washing a driveway'
  },
  {
    name: 'Trim & Molding',
    href: '/services/trim-crown-molding',
    description: 'Crown and baseboards that finish the room.',
    image: '/images/trim-navy-wall.jpg',
    icon: 'trim',
    alt: 'White trim on a navy wall'
  },
  {
    name: 'Custom Murals',
    href: '/services/murals',
    description: "A hand-painted wall for a kid's room or a feature wall.",
    image: '/images/nemo-mural.jpg',
    icon: 'mural',
    alt: 'Hand-painted mural'
  }
];

const work = [
  { src: '/images/nemo-mural.jpg', alt: 'Finding Nemo custom mural', caption: 'Custom mural', wide: true },
  { src: '/images/star-wars-theater.jpg', alt: 'Star Wars home theater', caption: 'Home theater' },
  { src: '/images/bedroom-paint.jpg', alt: 'Painted bedroom', caption: 'Interior painting' },
  { src: '/images/wood-floor.jpg', alt: 'Wood-look floor with border trim', caption: 'Flooring' },
  { src: '/images/movie-room.jpg', alt: 'Home theater with tiered seating', caption: 'Movie room' },
];

const steps = [
  'Call (407) 244-6873 or request a free estimate.',
  'The owner talks through the job with you.',
  'You get a written price before any work starts.',
  'If you say yes, we schedule the work. Monday through Friday, 7 AM to 5 PM.',
];

const questions = [
  ['What work do you do?', 'Painting, drywall, power washing, trim, wallpaper, murals, TV mounting, movie rooms, and interior demolition.'],
  ['Who do I talk to?', 'The owner. Not a salesperson.'],
  ['Is the estimate free?', "Yes. The call and the form don't cost anything."],
  ['When can I reach you?', 'Monday through Friday, 7 AM to 5 PM, at (407) 244-6873.'],
  ['Where do you work?', 'Kissimmee, Orlando, St. Cloud, Celebration, Poinciana, and nearby Central Florida.'],
];
---

<BaseLayout
  title="Home Improvement in Kissimmee & Central Florida | Go Pro"
  description="Owner-operated contractor serving Kissimmee, Orlando & Central Florida for 15+ years. Home theaters, murals, painting, power washing, trim, drywall & more."
>
  <Header />
  <main id="main">
    <HeroHome />

    <nav class="index-rail" aria-label="Services">
      <div class="container-custom">
        <ol>
          {rail.map((item, i) => (
            <li>
              <a href={item.href}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <section class="section-padding band-paper">
      <div class="container-custom">
        <div class="section-head">
          <p class="kicker">Recent projects</p>
          <h2>Our work</h2>
          <p class="lede">Real jobs across Central Florida: painting, home theaters, drywall, and more. Photos from jobs for Central Florida homeowners.</p>
        </div>
        <div class="work-grid">
          {work.map((item, i) => (
            <figure class:list={['work-card', item.wide && 'work-card-lead']}>
              <a href="/work">
                <img src={item.src} alt={item.alt} width="1920" height="1440" loading="lazy" decoding="async" />
              </a>
              <figcaption>
                <span>{String(i + 1).padStart(2, '0')}</span>
                <span>{item.caption}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-10">
          <a class="text-link" href="/work">View full gallery</a>
        </p>
      </div>
    </section>

    <section class="section-padding band-stone">
      <div class="container-custom">
        <div class="section-head">
          <p class="kicker">Why Go Pro</p>
          <h2>You call. The owner answers. You get a price before we start.</h2>
        </div>
        <div class="why-grid">
          {whyChooseUs.map((item, i) => (
            <article>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-custom service-layout">
        <div class="section-head">
          <p class="kicker">Our services</p>
          <h2>Painting, drywall, washing, trim, theaters, and the jobs in between.</h2>
          <p class="mt-8"><a class="text-link" href="/services">View all services</a></p>
        </div>
        <ul class="service-rows">
          {services.map((service, i) => (
            <li>
              <a href={service.href}>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <strong>{service.name}</strong>
                  <em>{service.description}</em>
                </span>
                <img src={service.image} alt="" width="160" height="120" decoding="async" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section-padding band-stone">
      <div class="container-custom">
        <div class="section-head">
          <h2>How a job starts</h2>
        </div>
        <ol class="steps">
          {steps.map((step, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <p>{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-custom">
        <div class="section-head">
          <h2>Questions homeowners ask</h2>
        </div>
        <div class="faq" style="max-width: 46rem;">
          {questions.map(([q, a]) => (
            <article>
              <h3>{q}</h3>
              <p>{a}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
