---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HeroSVG from '../components/HeroSVG.astro';

const services = [
  {
    name: 'Interior & Exterior Painting',
    href: '/services/interior-exterior-painting',
    description: 'Expert painting services to refresh and protect your property.',
    image: '/images/bedroom-paint.jpg'
  },
  {
    name: 'Home Theaters',
    href: '/services/movie-rooms',
    description: 'Complete home theater design and installation.',
    image: '/images/movie-room.jpg'
  },
  {
    name: 'Drywall',
    href: '/services/drywall',
    description: 'Drywall installation, repair, and texture services.',
    image: '/images/drywall.jpg'
  },
  {
    name: 'Power Washing',
    href: '/services/power-washing',
    description: 'Professional pressure washing for homes, driveways, and commercial properties.',
    image: '/images/power-washing.jpg'
  },
  {
    name: 'Trim & Crown Molding',
    href: '/services/trim-crown-molding',
    description: 'Custom trim work and crown molding installation for elegant finishes.',
    image: '/images/trim-navy-wall.jpg'
  },
  {
    name: 'Murals',
    href: '/services/murals',
    description: 'Custom mural design and installation for unique spaces.',
    image: '/images/nemo-mural.jpg'
  },
  {
    name: 'Demolition',
    href: '/services/demolition',
    description: 'Safe and efficient demolition for remodeling projects.',
    image: '/images/drywall.jpg'
  },
  {
    name: 'Wallpaper',
    href: '/services/wallpaper',
    description: 'Professional wallpaper installation and removal services.',
    image: '/images/bedroom-paint.jpg'
  },
  {
    name: 'TV Mounting',
    href: '/services/tv-mounting',
    description: 'Professional TV mounting and wire concealment.',
    image: '/images/trim-navy-wall.jpg'
  }
];

const whyChooseUs = [
  {
    title: 'Owner-Operated',
    description: 'Direct communication with the owner ensures quality control and personalized service on every project.'
  },
  {
    title: '15+ Years Experience',
    description: 'Over a decade and a half of proven expertise in home improvement across Central Florida.'
  },
  {
    title: 'Quality Workmanship',
    description: 'We stand behind our work with attention to detail and a commitment to excellence.'
  },
  {
    title: 'Fair Pricing',
    description: 'Transparent, competitive pricing with no hidden fees. You get quality without overpaying.'
  }
];
---

<Base
  title="Home Improvement in Kissimmee & Central Florida | Go Pro"
  description="Owner-operated contractor serving Kissimmee, Orlando & Central Florida for 15+ years. Home theaters, murals, painting, power washing, trim, drywall & more."
>
  <Hero
    title="Central Florida's owner-operated home improvement specialist."
    subtitle="Painting, home theaters, drywall, pressure washing, and more — across Orlando, Kissimmee, and greater Central Florida. Free estimates, quality work."
  >
    <HeroSVG slot="visual" />
  </Hero>

  <!-- Why Choose Us -->
  <section class="bg-paper px-4 py-16 md:px-6 md:py-20 lg:px-8">
    <div class="mx-auto max-w-content">
      <div class="text-center mb-12">
        <h2 class="font-display text-3xl font-semibold md:text-4xl">Why Go Pro</h2>
        <p class="mt-4 text-lg text-slate max-w-2xl mx-auto">
          Owner-operated. No salespeople. Fair prices. Quality work.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {whyChooseUs.map((item) => (
          <div class="text-center">
            <h3 class="font-display text-xl font-semibold text-ink mb-3">{item.title}</h3>
            <p class="text-slate leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="bg-cream/40 px-4 py-16 md:px-6 md:py-20 lg:px-8 border-y border-line">
    <div class="mx-auto max-w-content">
      <div class="text-center mb-12">
        <h2 class="font-display text-3xl font-semibold md:text-4xl">Our Services</h2>
        <p class="mt-4 text-slate max-w-2xl mx-auto">
          15+ years doing it all—painting, remodeling, theaters, power washing & more
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <a href={service.href} class="group relative h-80 rounded-sm overflow-hidden shadow-md hover:shadow-xl transition-all border border-line">
            <img src={service.image} alt={service.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="font-display text-2xl font-semibold mb-2">{service.name}</h3>
              <p class="text-white/90 text-sm">{service.description}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/services" class="inline-flex items-center justify-center rounded-sm bg-ink px-8 py-4 text-sm font-semibold text-white transition-colors hover:bg-orange border-2 border-orange">
          View All Services
        </a>
      </div>
    </div>
  </section>

  <!-- Work Showcase -->
  <section class="bg-paper px-4 py-16 md:px-6 md:py-20 lg:px-8">
    <div class="mx-auto max-w-content">
      <div class="text-center mb-12">
        <h2 class="font-display text-3xl font-semibold md:text-4xl">Our Work</h2>
        <p class="mt-4 text-slate max-w-2xl mx-auto">
          Real jobs, real results—see what we've built for Central Florida homeowners
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
        <div class="relative aspect-square rounded-sm overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/trim-navy-wall.jpg" alt="Navy paneled TV wall" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="relative aspect-square rounded-sm overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/movie-room.jpg" alt="Home theater installation" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="relative aspect-square rounded-sm overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/nemo-mural.jpg" alt="Finding Nemo custom mural" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="relative aspect-square rounded-sm overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/wood-accent-wall.jpg" alt="Wood accent wall" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="relative aspect-square rounded-sm overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/star-wars-theater.jpg" alt="Star Wars home theater" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="relative aspect-square rounded-sm overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/bedroom-paint.jpg" alt="Professional painting" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
      </div>
      <div class="text-center mt-12">
        <a href="/work" class="inline-flex items-center justify-center rounded-sm bg-ink px-8 py-4 text-sm font-semibold text-white transition-colors hover:bg-orange border-2 border-orange">
          View Full Gallery
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-gradient-to-br from-orange to-orange-deep text-white px-4 py-16 md:px-6 md:py-20 lg:px-8">
    <div class="mx-auto max-w-content text-center">
      <h2 class="font-display text-3xl font-semibold md:text-4xl mb-6">Ready to transform your space?</h2>
      <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
        Get a free estimate for your next home improvement project. Owner-operated, 15+ years serving Central Florida.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/estimate" class="inline-flex items-center justify-center rounded-sm bg-white px-8 py-4 text-sm font-semibold text-orange transition-colors hover:bg-cream">
          Get Free Estimate
        </a>
        <a href="tel:4072446873" class="inline-flex items-center justify-center rounded-sm border-2 border-white px-8 py-4 text-sm font-semibold text-white transition-colors hover:bg-white/10">
          Call (407) 244-6873
        </a>
      </div>
    </div>
  </section>
</Base>
