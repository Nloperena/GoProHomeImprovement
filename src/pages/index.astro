---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';

const whyChooseUs = [
  {
    title: 'You talk to the owner',
    description: 'The person who quotes the job is the person responsible for it. No salesperson in the middle.'
  },
  {
    title: 'Here since 2014',
    description: 'A Florida corporation based in Kissimmee. We work homes in Orlando, St. Cloud, Celebration, and Poinciana.'
  },
  {
    title: 'Price in writing',
    description: 'You get an estimate before any work starts. If the scope changes, we talk about it first.'
  },
  {
    title: 'We finish the work',
    description: 'Prep, the job itself, and a cleanup when we leave. Monday through Friday, 7 AM to 5 PM.'
  }
];
---

<BaseLayout
  title="Home Improvement in Kissimmee & Central Florida | Go Pro"
  description="Owner-operated contractor serving Kissimmee, Orlando & Central Florida for 15+ years. Home theaters, murals, painting, power washing, trim, drywall & more."
>
  <Header />

  <!-- Hero Section -->
  <section class="relative h-[600px] md:h-[700px] lg:h-[800px] overflow-hidden">
    <img 
      src="/images/movie-room.jpg" 
      alt="Professional home improvement work" 
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/70 to-black/40"></div>
    <div class="relative h-full container-custom flex items-center">
      <div class="max-w-3xl">
        <h1 class="text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-display font-black mb-6 text-white leading-[0.95] tracking-tight" style="font-weight: 900;">
          House work, priced before we start.
        </h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 font-sans leading-relaxed">
          Painting, drywall, power washing, trim, and more. You talk to the owner. Kissimmee and nearby.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/estimate" class="bg-gopro-orange hover:bg-orange-600 text-white font-display font-bold uppercase px-10 py-5 rounded-lg text-lg transition-all inline-block text-center shadow-xl tracking-wide">
            Request a free estimate
          </a>
          <a href="tel:4072446873" class="bg-transparent hover:bg-white/10 text-white font-display font-bold uppercase px-10 py-5 rounded-lg text-lg transition-all inline-block text-center border-2 border-white tracking-wide">
            Call (407) 244-6873
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Work Strip -->
  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-display font-black uppercase mb-4 tracking-tight">Recent Projects</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto font-sans">
          Real jobs across Central Florida: painting, home theaters, drywall, and more
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/movie-room.jpg" alt="Home theater installation" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
        </div>
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/bedroom-paint.jpg" alt="Professional painting" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
        </div>
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/drywall.jpg" alt="Drywall services" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
        </div>
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/trim-navy-wall.jpg" alt="Custom trim work" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
        </div>
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/star-wars-theater.jpg" alt="Star Wars home theater" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
        </div>
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow">
          <img src="/images/nemo-mural.jpg" alt="Custom mural" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
        </div>
      </div>
      <div class="text-center mt-10">
        <a href="/work" class="bg-gopro-charcoal hover:bg-gopro-black text-white font-display font-bold uppercase px-10 py-5 rounded-lg text-lg transition-colors inline-block shadow-lg tracking-wide border-2 border-gopro-orange">
          View Full Gallery
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display font-black uppercase mb-6 tracking-tight">Why Go Pro</h2>
        <p class="text-2xl text-gopro-charcoal max-w-3xl mx-auto font-sans font-semibold">
          You call. The owner answers. You get a price before we start.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {whyChooseUs.map((item) => (
          <div>
            <h3 class="text-xl font-display font-bold uppercase mb-3 text-gopro-orange tracking-wide">{item.title}</h3>
            <p class="text-gray-700 leading-relaxed font-sans">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display font-black uppercase mb-4 tracking-tight">Our Services</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto font-sans">
          Painting, drywall, washing, trim, theaters, and the jobs in between.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <a href="/services/interior-exterior-painting" class="group relative h-80 rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all">
          <img src="/images/bedroom-paint.jpg" alt="Interior & Exterior Painting" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="text-2xl font-display font-bold uppercase mb-2 tracking-wide">Painting</h3>
            <p class="text-white/90 text-sm font-sans">Rooms that look finished. Exteriors that hold up in the sun.</p>
          </div>
        </a>
        
        <a href="/services/movie-rooms" class="group relative h-80 rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all">
          <img src="/images/movie-room.jpg" alt="Home Theater Design" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="text-2xl font-display font-bold uppercase mb-2 tracking-wide">Home Theaters</h3>
            <p class="text-white/90 text-sm font-sans">A room set up for movies, not a TV on a stand.</p>
          </div>
        </a>
        
        <a href="/services/drywall" class="group relative h-80 rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all">
          <img src="/images/drywall.jpg" alt="Drywall Services" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="text-2xl font-display font-bold uppercase mb-2 tracking-wide">Drywall</h3>
            <p class="text-white/90 text-sm font-sans">Holes and water stains patched so the wall matches.</p>
          </div>
        </a>
        
        <a href="/services/power-washing" class="group relative h-80 rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all">
          <img src="/images/power-washing.jpg" alt="Power Washing" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="text-2xl font-display font-bold uppercase mb-2 tracking-wide">Power Washing</h3>
            <p class="text-white/90 text-sm font-sans">Algae and dirt off the house, driveway, and pool deck.</p>
          </div>
        </a>
        
        <a href="/services/trim-crown-molding" class="group relative h-80 rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all">
          <img src="/images/trim-navy-wall.jpg" alt="Trim & Crown Molding" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="text-2xl font-display font-bold uppercase mb-2 tracking-wide">Trim & Molding</h3>
            <p class="text-white/90 text-sm font-sans">Crown and baseboards that finish the room.</p>
          </div>
        </a>
        
        <a href="/services/murals" class="group relative h-80 rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all">
          <img src="/images/nemo-mural.jpg" alt="Custom Murals" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="text-2xl font-display font-bold uppercase mb-2 tracking-wide">Custom Murals</h3>
            <p class="text-white/90 text-sm font-sans">A hand-painted wall for a kid's room or a feature wall.</p>
          </div>
        </a>
      </div>
      <div class="text-center mt-12">
        <a href="/services" class="bg-gopro-charcoal hover:bg-gopro-black text-white font-display font-bold uppercase px-10 py-5 rounded text-lg transition-colors inline-block shadow-lg tracking-wide border-2 border-gopro-orange">
          View All Services
        </a>
      </div>
    </div>
  </section>

  <!-- Work Showcase -->
  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display font-black uppercase mb-4 tracking-tight">Our Work</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto font-sans">
          Photos from jobs for Central Florida homeowners.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <img src="/images/trim-navy-wall.jpg" alt="Navy paneled TV wall" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <img src="/images/movie-room.jpg" alt="Home theater installation" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <img src="/images/nemo-mural.jpg" alt="Finding Nemo custom mural" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <img src="/images/wood-accent-wall.jpg" alt="Wood accent wall" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <img src="/images/star-wars-theater.jpg" alt="Star Wars home theater" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <img src="/images/bedroom-paint.jpg" alt="Professional painting" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
      </div>
      <div class="text-center mt-12">
        <a href="/work" class="bg-gopro-charcoal hover:bg-gopro-black text-white font-display font-bold uppercase px-10 py-5 rounded text-lg transition-colors inline-block shadow-lg tracking-wide border-2 border-gopro-orange">
          View Full Gallery
        </a>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-display font-black uppercase mb-8 tracking-tight">How a job starts</h2>
        <ol class="space-y-4 text-lg text-gray-700 font-sans mb-16">
          <li><span class="font-bold text-gopro-orange mr-2">1.</span> Call (407) 244-6873 or request a free estimate.</li>
          <li><span class="font-bold text-gopro-orange mr-2">2.</span> The owner talks through the job with you.</li>
          <li><span class="font-bold text-gopro-orange mr-2">3.</span> You get a written price before any work starts.</li>
          <li><span class="font-bold text-gopro-orange mr-2">4.</span> If you say yes, we schedule the work. Monday through Friday, 7 AM to 5 PM.</li>
        </ol>

        <h2 class="text-4xl md:text-5xl font-display font-black uppercase mb-8 tracking-tight">Questions homeowners ask</h2>
        <div class="space-y-6 font-sans">
          <div class="border-l-4 border-gopro-orange pl-6">
            <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">What work do you do?</h3>
            <p class="text-gray-700">Painting, drywall, power washing, trim, wallpaper, murals, TV mounting, movie rooms, and interior demolition.</p>
          </div>
          <div class="border-l-4 border-gopro-orange pl-6">
            <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Who do I talk to?</h3>
            <p class="text-gray-700">The owner. Not a salesperson.</p>
          </div>
          <div class="border-l-4 border-gopro-orange pl-6">
            <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Is the estimate free?</h3>
            <p class="text-gray-700">Yes. The call and the form don't cost anything.</p>
          </div>
          <div class="border-l-4 border-gopro-orange pl-6">
            <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">When can I reach you?</h3>
            <p class="text-gray-700">Monday through Friday, 7 AM to 5 PM, at (407) 244-6873.</p>
          </div>
          <div class="border-l-4 border-gopro-orange pl-6">
            <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Where do you work?</h3>
            <p class="text-gray-700">Kissimmee, Orlando, St. Cloud, Celebration, Poinciana, and nearby Central Florida.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />

  <Footer />
</BaseLayout>
