---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHeader from '../components/home/HomeHeader.astro';
import ScrollPath from '../components/home/ScrollPath.astro';
import HomeHero from '../components/home/HomeHero.astro';
import ServiceDeck from '../components/home/ServiceDeck.astro';
import WorkReel from '../components/home/WorkReel.astro';
import ProcessStrip from '../components/home/ProcessStrip.astro';
import GuaranteeBand from '../components/home/GuaranteeBand.astro';
import Reviews from '../components/home/Reviews.astro';
import EstimateTicket from '../components/home/EstimateTicket.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import '../styles/home.css';
import '../styles/home-hero.css';
import '../styles/home-deck.css';
import '../styles/home-motion.css';
import '../styles/home-work.css';
import '../styles/home-reviews.css';
import '../styles/home-close.css';
---

<BaseLayout
  variant="editorial"
  title="Go Pro Home Improvements | Sprayed finishes in Kissimmee"
  description="Mike sprays the finish with an airbrush and a sprayer. Painting, murals, trim, drywall, power washing, wallpaper, movie rooms, TV mounting, and demolition. Kissimmee, established 2014. (407) 244-6873."
  ogImage="/images/trim-navy-wall.jpg"
>
  <HomeHeader />
  <ScrollPath />
  <main id="main">
    <HomeHero />
    <ServiceDeck />
    <WorkReel />
    <ProcessStrip />
    <GuaranteeBand />
    <Reviews />
    <EstimateTicket />
  </main>
  <HomeFooter />
</BaseLayout>
