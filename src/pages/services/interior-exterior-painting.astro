---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Interior & Exterior Painting in Kissimmee & Orlando | Go Pro"
  description="Owner-operated interior and exterior painting in Kissimmee, Orlando, and nearby cities. Free estimates. Call (407) 244-6873."
  ogImage="/images/bedroom-paint.jpg"
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HomeAndConstructionBusiness",
        "@id": "https://goprohomeimprovements.com/#business",
        "name": "Go Pro Home Improvements",
        "url": "https://goprohomeimprovements.com",
        "telephone": "(407) 244-6873",
        "email": "gopro4good@gmail.com",
        "image": "https://goprohomeimprovements.com/images/logo.png",
        "logo": {
          "@type": "ImageObject",
          "url": "https://goprohomeimprovements.com/images/logo.png"
        },
        "priceRange": "$$",
        "areaServed": [
          { "@type": "City", "name": "Kissimmee" },
          { "@type": "City", "name": "Orlando" },
          { "@type": "City", "name": "St. Cloud" },
          { "@type": "City", "name": "Celebration" },
          { "@type": "City", "name": "Poinciana" }
        ],
        "sameAs": [
          "https://www.instagram.com/gopro4good/"
        ]
      },
      {
        "@type": "Service",
        "@id": "https://goprohomeimprovements.com/services/interior-exterior-painting/#service",
        "serviceType": "Interior and Exterior Painting",
        "provider": {
          "@id": "https://goprohomeimprovements.com/#business"
        },
        "areaServed": [
          { "@type": "City", "name": "Kissimmee" },
          { "@type": "City", "name": "Orlando" },
          { "@type": "City", "name": "St. Cloud" },
          { "@type": "City", "name": "Celebration" },
          { "@type": "City", "name": "Poinciana" }
        ],
        "description": "Professional residential and commercial painting services for interior rooms, exterior siding, cabinets, and trim in Central Florida."
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://goprohomeimprovements.com/services/interior-exterior-painting/#breadcrumbs",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://goprohomeimprovements.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Services",
            "item": "https://goprohomeimprovements.com/services"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Interior & Exterior Painting",
            "item": "https://goprohomeimprovements.com/services/interior-exterior-painting"
          }
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "https://goprohomeimprovements.com/services/interior-exterior-painting/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How much does interior painting cost in Kissimmee?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Interior painting costs depend on square footage, ceiling height, and surface condition. A typical bedroom ranges $300-$600, living rooms $400-$900. We provide free estimates so you know the exact cost upfront."
            }
          },
          {
            "@type": "Question",
            "name": "How long does exterior paint last in Florida?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Florida sun and humidity are hard on exterior paint. Quality paint with proper prep typically lasts 5-7 years. Regular power washing and touch-ups can extend that. We use paints rated for Florida's climate."
            }
          },
          {
            "@type": "Question",
            "name": "Do you move furniture when painting?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "We move small furniture away from walls and cover it with drop cloths. Heavy furniture (beds, large dressers) we work around carefully. Let us know if you need help moving big pieces before the job starts."
            }
          },
          {
            "@type": "Question",
            "name": "Can you match my existing paint color?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. We can color-match from a sample chip or an existing painted surface. Many touch-up and single-room jobs need matching, and we do it routinely."
            }
          },
          {
            "@type": "Question",
            "name": "Do you paint cabinets and trim?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. We paint kitchen cabinets, bathroom vanities, baseboards, and crown molding. Cabinet painting requires careful prep and the right primer—we've done hundreds in Central Florida."
            }
          }
        ]
      }
    ]
  }}
>
  <Header />

  <!-- Hero Section -->
  <section class="relative h-[500px] md:h-[600px] lg:h-[700px] overflow-hidden">
    <img 
      src="/images/bedroom-paint.jpg" 
      alt="Interior painting in Kissimmee living room" 
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-transparent"></div>
    <div class="relative h-full container-custom flex items-center">
      <div class="max-w-3xl">
        <nav class="text-sm mb-6 font-sans">
          <a href="/" class="text-white/70 hover:text-gopro-orange transition-colors">Home</a>
          <span class="mx-2 text-white/50">/</span>
          <a href="/services" class="text-white/70 hover:text-gopro-orange transition-colors">Services</a>
          <span class="mx-2 text-white/50">/</span>
          <span class="text-white">Painting</span>
        </nav>
        <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-display font-black mb-6 text-white leading-[0.95] tracking-tight" style="font-weight: 900;">
          Interior & exterior painting in Kissimmee and Orlando
        </h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 font-sans leading-relaxed">
          Prep that lasts in Florida sun and humidity.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/estimate" class="bg-green-600 hover:bg-green-700 text-white font-display font-bold uppercase px-10 py-5 rounded-lg text-lg transition-all inline-block text-center shadow-xl tracking-wide flex items-center justify-center gap-2">
            Get free estimate
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a href="tel:4072446873" class="bg-transparent hover:bg-white/10 text-white font-display font-bold uppercase px-10 py-5 rounded-lg text-lg transition-all inline-block text-center border-2 border-white tracking-wide">
            Call (407) 244-6873
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6 font-sans">
            Painting is one of the fastest ways to refresh a home—and one of the easiest to mess up if you rush the prep. We <a href="/services/power-washing" class="text-gopro-orange hover:underline">power wash</a> exteriors before painting, patch and sand drywall, prime stains, and use quality paint that holds up in Florida's sun and humidity.
          </p>
          <p class="text-lg text-gray-600 mb-8 font-sans">
            Whether you're repainting a bedroom, freshening curb appeal before selling, or updating kitchen cabinets, we work clean, on schedule, and stand behind the finished job. Based in Kissimmee, serving Orlando and Central Florida.
          </p>
        </div>
        
        <!-- Work Examples -->
        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">Recent Painting Projects</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
            <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg">
              <img src="/images/bedroom-paint.jpg" alt="Interior painting in Kissimmee bedroom" class="w-full h-full object-cover" />
            </div>
            <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg">
              <img src="/images/trim-navy-wall.jpg" alt="Navy painted accent wall with trim" class="w-full h-full object-cover" />
            </div>
            <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg">
              <img src="/images/wood-accent-wall.jpg" alt="Accent wall with painted trim" class="w-full h-full object-cover" />
            </div>
          </div>
          <p class="text-center">
            <a href="/work" class="text-gopro-orange hover:underline font-semibold">View our full portfolio →</a>
          </p>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h2 class="text-xl font-display font-bold uppercase mb-3 tracking-wide">Florida Sun & Mildew</h2>
          <p class="text-gray-700 font-sans">
            Central Florida's UV rays fade exterior paint faster than cooler climates, and humidity feeds mildew on north-facing walls. We use paints with mildewcide and UV resistance, and we prep surfaces so paint bonds properly—not just covers the problem for six months.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">What We Paint</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Interior Rooms (bedrooms, living rooms, hallways)</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Exterior Siding (vinyl, stucco, wood, Hardie)</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Kitchen Cabinets & Vanities</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Trim, Baseboards, Crown Molding</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Ceilings (flat, textured)</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Doors & Window Frames</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Accent Walls</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Commercial Spaces</span>
            </div>
          </div>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-display font-black uppercase mb-8 tracking-tight">Common Questions</h2>
          <div class="space-y-6">
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">How much does interior painting cost in Kissimmee?</h3>
              <p class="text-gray-700 font-sans">
                Interior painting costs depend on square footage, ceiling height, and surface condition. A typical bedroom ranges $300-$600, living rooms $400-$900. We provide free estimates so you know the exact cost upfront.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">How long does exterior paint last in Florida?</h3>
              <p class="text-gray-700 font-sans">
                Florida sun and humidity are hard on exterior paint. Quality paint with proper prep typically lasts 5-7 years. Regular <a href="/services/power-washing" class="text-gopro-orange hover:underline">power washing</a> and touch-ups can extend that. We use paints rated for Florida's climate.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Do you move furniture when painting?</h3>
              <p class="text-gray-700 font-sans">
                We move small furniture away from walls and cover it with drop cloths. Heavy furniture (beds, large dressers) we work around carefully. Let us know if you need help moving big pieces before the job starts.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Can you match my existing paint color?</h3>
              <p class="text-gray-700 font-sans">
                Yes. We can color-match from a sample chip or an existing painted surface. Many touch-up and single-room jobs need matching, and we do it routinely.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Do you paint cabinets and trim?</h3>
              <p class="text-gray-700 font-sans">
                Yes. We paint kitchen cabinets, bathroom vanities, baseboards, and crown molding. Cabinet painting requires careful prep and the right primer—we've done hundreds in Central Florida.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Related Guides -->
        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h3 class="text-xl font-display font-bold uppercase mb-4 tracking-wide">Helpful Painting Guides</h3>
          <ul class="space-y-2 font-sans">
            <li>
              <a href="/guides/how-much-does-painting-cost-kissimmee" class="text-gopro-orange hover:underline">
                How Much Does Painting Cost in Kissimmee?
              </a>
            </li>
            <li>
              <a href="/guides/exterior-paint-colors-florida-sun" class="text-gopro-orange hover:underline">
                Choosing Exterior Paint Colors for Florida Sun
              </a>
            </li>
            <li>
              <a href="/guides/power-washing-before-painting-florida" class="text-gopro-orange hover:underline">
                Power Washing Before Painting in Florida
              </a>
            </li>
          </ul>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6 font-sans">Ready to refresh your home with quality painting?</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/estimate" class="btn-primary">
              Get Free Estimate
            </a>
            <a href="tel:4072446873" class="btn-secondary">
              Call (407) 244-6873
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Transform Your Space with Professional Painting"
    description="Quality prep, quality paint, and owner-operated care. Serving Kissimmee, Orlando & Central Florida."
  />

  <Footer />
</BaseLayout>
