---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Wallpaper Installation & Removal in Poinciana, FL"
  description="Professional wallpaper installation, removal & repair in Poinciana, FL. Precise pattern matching, textured walls. 15+ years experience."
  ogImage="/images/wallpaper.jpg"
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HomeAndConstructionBusiness",
        "@id": "https://goprohomeimprovements.com/#business",
        "name": "Go Pro Home Improvements",
        "legalName": "GO PRO HOME IMPROVEMENTS INC.",
        "url": "https://goprohomeimprovements.com",
        "telephone": "(407) 244-6873",
        "email": "gopro4good@gmail.com",
        "image": "https://goprohomeimprovements.com/images/logo.png",
        "logo": {
          "@type": "ImageObject",
          "url": "https://goprohomeimprovements.com/images/logo.png"
        },
        "priceRange": "$$",
        "areaServed": [
          { "@type": "City", "name": "Poinciana" }
        ],
        "sameAs": [
          "https://www.instagram.com/gopro4good/"
        ]
      },
      {
        "@type": "Service",
        "@id": "https://goprohomeimprovements.com/services/wallpaper-poinciana/#service",
        "serviceType": "Wallpaper Installation and Removal",
        "provider": {
          "@id": "https://goprohomeimprovements.com/#business"
        },
        "areaServed": { "@type": "City", "name": "Poinciana" },
        "description": "Professional wallpaper installation, removal, and repair with precise pattern matching and seam alignment in Poinciana, FL."
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://goprohomeimprovements.com/services/wallpaper-poinciana/#breadcrumbs",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://goprohomeimprovements.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Services",
            "item": "https://goprohomeimprovements.com/services"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Wallpaper Poinciana",
            "item": "https://goprohomeimprovements.com/services/wallpaper-poinciana"
          }
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "https://goprohomeimprovements.com/services/wallpaper-poinciana/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How much does wallpaper installation cost in Poinciana?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A wallpaper estimate in Poinciana comes from the pattern, the number of walls, and the prep under the paper. New drywall holds dust. Paste over that dust and the paper lets go, so primer comes first. We itemize the work after we see the space. We do not lock a price from a photo."
            }
          },
          {
            "@type": "Question",
            "name": "Do you remove old wallpaper?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. In Poinciana we strip the old paper, scrape the adhesive, patch the drywall, and prime before new paper or paint goes on. How long that takes depends on how many layers are on the wall and what adhesive was used. We quote removal after seeing it."
            }
          },
          {
            "@type": "Question",
            "name": "Can wallpaper be installed on textured walls?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, but results vary. Light texture (orange peel) shows through slightly. Heavy knockdown texture usually needs skim coating for a smooth finish. We prep walls properly so wallpaper adheres well and seams stay tight."
            }
          },
          {
            "@type": "Question",
            "name": "How long does wallpaper installation take?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A typical room (200-300 square feet of wall) takes 1-2 days—one day for wall prep and priming, one day for installation. Complex patterns with lots of matching take longer."
            }
          }
        ]
      }
    ]
  }}
>
  <Header />

  <section class="bg-gopro-charcoal text-white py-16 border-b-4 border-gopro-orange">
    <div class="container-custom">
      <nav aria-label="Breadcrumb" class="text-sm mb-6 font-sans">
        <a href="/" class="text-gray-400 hover:text-gopro-orange transition-colors">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/services" class="text-gray-400 hover:text-gopro-orange transition-colors">Services</a>
        <span class="mx-2 text-gray-500">/</span>
        <span class="text-white">Wallpaper in Poinciana</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-display font-black uppercase mb-4 tracking-tight">Wallpaper Installation & Removal in Poinciana, FL</h1>
      <p class="text-xl text-gray-300 max-w-3xl font-sans">
        Professional wallpaper hanging, removal, and repair. Precise pattern matching, invisible seams.
      </p>
    </div>
  </section>

  <section class="relative h-96 overflow-hidden">
    <img src="/images/wallpaper.jpg" alt="Professional wallpaper installation in Poinciana" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6 font-sans">
            New drywall in <a href="/areas/poinciana" class="text-gopro-orange hover:underline">Poinciana</a> holds construction dust. Paste over that dust and the paper lets go at the seams. We prime new or freshly repaired walls before any paper goes up, including after a builder paint job. The <a href="/guides/poinciana-new-construction-painting" class="text-gopro-orange hover:underline">new-construction notes</a> describe that dusty first finish.
          </p>
          <p class="text-lg text-gray-600 mb-8 font-sans">
            Accent walls are the usual request in these floor plans. If you would rather have color than paper, <a href="/services/painting-poinciana" class="text-gopro-orange hover:underline">interior painting</a> skips the seam work. If old builder stickers or spray texture are in the way, we deal with those before paste.
          </p>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h2 class="text-xl font-display font-bold uppercase mb-3 tracking-wide">Prime the new drywall first</h2>
          <p class="text-gray-700 font-sans">
            Order paper after we measure. New rooms look square and often are not, and a large repeat shows every bit of that on a long Poinciana wall.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">Wallpaper Services in Poinciana</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Wallpaper Installation (new)</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Wallpaper Removal & Stripping</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Pattern Matching & Seam Alignment</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Wall Prep & Skim Coating</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Wallpaper Repair (tears, bubbles)</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Accent Walls</span>
            </div>
          </div>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-display font-black uppercase mb-8 tracking-tight">Common Questions</h2>
          <div class="space-y-6">
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">How much does wallpaper installation cost in Poinciana?</h3>
              <p class="text-gray-700 font-sans">A wallpaper estimate in Poinciana comes from the pattern, the number of walls, and the prep under the paper. New drywall holds dust. Paste over that dust and the paper lets go, so primer comes first. We itemize the work after we see the space. <a href="/estimate" class="text-gopro-orange hover:underline">Request an estimate</a>. Related reading: <a href="/guides/poinciana-new-construction-painting" class="text-gopro-orange hover:underline">this guide</a>.</p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Do you remove old wallpaper?</h3>
              <p class="text-gray-700 font-sans">Yes. In Poinciana we strip the old paper, scrape the adhesive, patch the drywall, and prime before new paper or paint goes on. How long that takes depends on how many layers are on the wall and what adhesive was used. We quote removal after seeing it.</p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Can wallpaper be installed on textured walls?</h3>
              <p class="text-gray-700 font-sans">
                Yes, but results vary. Light texture (orange peel) shows through slightly. Heavy knockdown texture usually needs skim coating for a smooth finish. We prep walls properly so wallpaper adheres well and seams stay tight.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">How long does wallpaper installation take?</h3>
              <p class="text-gray-700 font-sans">
                A typical room (200-300 square feet of wall) takes 1-2 days—one day for wall prep and priming, one day for installation. Complex patterns with lots of matching take longer.
              </p>
            </div>
          </div>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6 font-sans">Ready to install or remove wallpaper in your Poinciana home?</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/estimate" class="btn-primary">
              Get Free Estimate
            </a>
            <a href="tel:4072446873" class="btn-secondary">
              Call (407) 244-6873
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Professional Wallpaper for Poinciana Homes"
    description="Precise pattern matching, invisible seams, quality installation. Serving Poinciana and Central Florida."
  />

  <Footer />
</BaseLayout>
