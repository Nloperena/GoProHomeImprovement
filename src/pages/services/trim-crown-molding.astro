---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Trim & Crown Molding Installation | Go Pro Home Improvements"
  description="Professional trim work, baseboards, and crown molding installation in Central Florida. Add elegant finishing touches to your home."
>
  <Header />

  <section class="bg-gradient-to-br from-gopro-black to-gray-900 text-white py-16">
    <div class="container-custom">
      <nav class="text-sm mb-6">
        <a href="/" class="text-gray-400 hover:text-white">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/services" class="text-gray-400 hover:text-white">Services</a>
        <span class="mx-2 text-gray-500">/</span>
        <span>Trim & Crown Molding</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Trim & Crown Molding</h1>
      <p class="text-xl text-gray-300 max-w-3xl">
        Add architectural elegance and refined finishing touches to your home.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            The difference between a good room and a great room often comes down to the details. Crown molding, baseboards, and custom trim work add a level of sophistication and completeness that elevates your entire space.
          </p>
          <p class="text-lg text-gray-600 mb-8">
            Go Pro specializes in precise trim carpentry that transforms ordinary rooms into polished, finished spaces. From classic crown molding to custom trim packages, we bring craftsmanship and attention to detail to every installation.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold mb-6">Trim Services</h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Crown Molding Installation</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Baseboards & Shoe Molding</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Door & Window Casing</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Chair Rails & Wainscoting</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Picture Frame Molding</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Custom Trim Packages</span>
            </li>
          </ul>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h3 class="text-xl font-bold mb-3">Precision Craftsmanship</h3>
          <p class="text-gray-700">
            Perfect trim work requires meticulous measuring, cutting, and fitting. Our experienced craftsmen ensure tight joints, smooth finishes, and installations that last. Whether you're upgrading builder-grade trim or adding architectural character, we deliver quality that shows in every detail.
          </p>
        </div>

        <div class="border-l-4 border-gopro-orange pl-6 mb-12">
          <h2 class="text-2xl font-bold mb-4">Our Service Promise</h2>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Complete, accurate, rock-solid up-front estimates
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Quick, careful work that accommodates your schedule
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Treat your property and belongings with utmost care and respect
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Do the job right—it's as simple as that
            </li>
          </ul>
        </div>

        <div class="text-center">
          <a href="/estimate" class="btn-primary">
            Get Free Estimate
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Ready to Add Elegant Details?"
    description="Professional trim and molding installation to elevate your home. Get your free estimate today."
  />

  <Footer />
</BaseLayout>
