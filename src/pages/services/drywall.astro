---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Drywall Installation & Repair | Go Pro Home Improvements"
  description="Professional drywall installation, repair, patching, and texture services in Central Florida. Smooth, flawless walls for new construction and repairs."
>
  <Header />

  <section class="bg-gradient-to-br from-gopro-black to-gray-900 text-white py-16">
    <div class="container-custom">
      <nav class="text-sm mb-6">
        <a href="/" class="text-gray-400 hover:text-white">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/services" class="text-gray-400 hover:text-white">Services</a>
        <span class="mx-2 text-gray-500">/</span>
        <span>Drywall</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Drywall Services</h1>
      <p class="text-xl text-gray-300 max-w-3xl">
        Professional drywall installation, repair, and finishing for smooth, flawless walls and ceilings.
      </p>
    </div>
  </section>

  <!-- Hero Image -->
  <section class="relative h-96 overflow-hidden">
    <img src="/images/drywall.jpg" alt="Professional drywall services" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            Quality drywall work is the foundation of any well-finished interior. Whether you're dealing with new construction, remodeling, or simply need to repair damaged walls, Go Pro delivers smooth, professional drywall installation and finishing.
          </p>
          <p class="text-lg text-gray-600 mb-8">
            From hanging new sheets to patching holes and matching existing textures, our skilled team ensures your walls and ceilings look perfect. We understand that proper mudding, taping, sanding, and finishing make all the difference between a DIY look and a professional result.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold mb-6">Drywall Services</h2>
          <ul class="space-y-4">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">New Drywall Installation</h3>
                <p class="text-gray-600">Complete hanging, taping, mudding, and finishing for new construction and additions.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Drywall Repair & Patching</h3>
                <p class="text-gray-600">Fix holes, cracks, water damage, and other wall imperfections.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Texture Matching</h3>
                <p class="text-gray-600">Match existing wall textures seamlessly—knockdown, orange peel, or smooth.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Ceiling Repair & Texture</h3>
                <p class="text-gray-600">Fix sagging, cracked, or water-damaged ceilings and reapply texture.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Skim Coating</h3>
                <p class="text-gray-600">Apply thin finishing layers for smooth, paint-ready surfaces.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Commercial Drywall</h3>
                <p class="text-gray-600">Office build-outs, retail spaces, and commercial renovations.</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h3 class="text-xl font-bold mb-3">Smooth Finishes, Lasting Results</h3>
          <p class="text-gray-700">
            Professional drywall work requires the right techniques, tools, and patience. We take the time to properly tape seams, apply multiple coats of joint compound, sand smooth, and match textures precisely. The result is walls and ceilings that look factory-smooth and ready for paint—no visible seams, bumps, or imperfections.
          </p>
        </div>

        <div class="border-l-4 border-gopro-orange pl-6 mb-12">
          <h2 class="text-2xl font-bold mb-4">Our Service Promise</h2>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Complete, accurate, rock-solid up-front estimates
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Quick, careful work that accommodates your schedule
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Treat your property and belongings with utmost care and respect
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Do the job right—it's as simple as that
            </li>
          </ul>
        </div>

        <div class="text-center">
          <a href="/estimate" class="btn-primary">
            Get Free Estimate
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Need Drywall Work?"
    description="Professional drywall installation and repair for smooth, flawless results. Get your free estimate today."
  />

  <Footer />
</BaseLayout>
