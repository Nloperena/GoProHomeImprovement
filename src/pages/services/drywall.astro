---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Drywall Repair & Installation in Kissimmee & Orlando | Go Pro"
  description="Drywall repair, water damage, and install in Kissimmee, Orlando, and nearby cities. Texture match. Free estimates. (407) 244-6873."
  ogImage="/images/drywall.jpg"
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HomeAndConstructionBusiness",
        "@id": "https://goprohomeimprovements.com/#business",
        "name": "Go Pro Home Improvements",
        "legalName": "GO PRO HOME IMPROVEMENTS INC.",
        "url": "https://goprohomeimprovements.com",
        "telephone": "(407) 244-6873",
        "email": "gopro4good@gmail.com",
        "foundingDate": "2014",
        "image": "https://goprohomeimprovements.com/images/logo.png",
        "logo": {
          "@type": "ImageObject",
          "url": "https://goprohomeimprovements.com/images/logo.png"
        },
        "priceRange": "$$",
        "areaServed": [
          { "@type": "City", "name": "Kissimmee" },
          { "@type": "City", "name": "Orlando" },
          { "@type": "City", "name": "St. Cloud" },
          { "@type": "City", "name": "Celebration" },
          { "@type": "City", "name": "Poinciana" }
        ],
        "sameAs": [
          "https://www.instagram.com/gopro4good/"
        ]
      },
      {
        "@type": "Service",
        "@id": "https://goprohomeimprovements.com/services/drywall/#service",
        "serviceType": "Drywall Installation and Repair",
        "provider": {
          "@id": "https://goprohomeimprovements.com/#business"
        },
        "areaServed": [
          { "@type": "City", "name": "Kissimmee" },
          { "@type": "City", "name": "Orlando" },
          { "@type": "City", "name": "St. Cloud" },
          { "@type": "City", "name": "Celebration" },
          { "@type": "City", "name": "Poinciana" }
        ],
        "description": "Professional drywall installation, repair, patching, texture matching, and finishing for residential and commercial properties in Central Florida."
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://goprohomeimprovements.com/services/drywall/#breadcrumbs",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://goprohomeimprovements.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Services",
            "item": "https://goprohomeimprovements.com/services"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Drywall",
            "item": "https://goprohomeimprovements.com/services/drywall"
          }
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "https://goprohomeimprovements.com/services/drywall/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How much does drywall repair cost in Kissimmee?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Drywall repair costs depend on damage size and complexity. Small patches (under 6 inches) typically run $75-$150, larger holes $150-$400. Full room drywall runs $1.50-$3 per square foot installed. We provide free estimates so you know the exact cost upfront."
            }
          },
          {
            "@type": "Question",
            "name": "Can you match existing wall texture?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. We match knockdown, orange peel, skip trowel, and other common Central Florida textures. Matching texture is critical for repairs to blend invisibly with the rest of the wall."
            }
          },
          {
            "@type": "Question",
            "name": "How long does drywall take to dry before painting?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Joint compound typically dries in 24 hours between coats in Florida's humidity. Full curing before painting takes 48-72 hours. We schedule jobs so you're not waiting—mudding one day, sanding the next, priming and painting after that."
            }
          },
          {
            "@type": "Question",
            "name": "Do you repair water-damaged drywall?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. We cut out water-damaged sections, let the framing dry, install new drywall, tape, mud, texture, and paint to match. Important: fix the leak first, or the repair won't last."
            }
          },
          {
            "@type": "Question",
            "name": "What causes drywall cracks in Florida homes?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Most cracks in Central Florida come from settling, temperature swings, or poor initial taping. Some older homes near Kissimmee have minor foundation movement from sandy soil. We assess the cause, repair the crack properly, and recommend fixes if it's structural."
            }
          }
        ]
      }
    ]
  }}
>
  <Header />

  <!-- Hero Section -->
  <section class="relative h-[500px] md:h-[600px] lg:h-[700px] overflow-hidden">
    <img 
      src="/images/drywall.jpg" 
      alt="Drywall repair in Kissimmee" 
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-transparent"></div>
    <div class="relative h-full container-custom flex items-center">
      <div class="max-w-3xl">
        <nav class="text-sm mb-6 font-sans">
          <a href="/" class="text-white/70 hover:text-gopro-orange transition-colors">Home</a>
          <span class="mx-2 text-white/50">/</span>
          <a href="/services" class="text-white/70 hover:text-gopro-orange transition-colors">Services</a>
          <span class="mx-2 text-white/50">/</span>
          <span class="text-white">Drywall</span>
        </nav>
        <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-display font-black mb-6 text-white leading-[0.95] tracking-tight" style="font-weight: 900;">
          Drywall repair and installation in Kissimmee and Orlando
        </h1>
        <p class="text-xl md:text-2xl mb-10 text-white/90 font-sans leading-relaxed">
          Install, patch, texture match — walls ready for paint.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          <a href="/estimate" class="bg-green-600 hover:bg-green-700 text-white font-display font-bold uppercase px-10 py-5 rounded-lg text-lg transition-all inline-block text-center shadow-xl tracking-wide flex items-center justify-center gap-2">
            Get free estimate
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a href="tel:4072446873" class="bg-transparent hover:bg-white/10 text-white font-display font-bold uppercase px-10 py-5 rounded-lg text-lg transition-all inline-block text-center border-2 border-white tracking-wide">
            Call (407) 244-6873
          </a>
        </div>
        <div class="flex items-start gap-3 text-white/80">
          <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
          </svg>
          <p class="text-sm font-sans leading-relaxed">
            Premium owner-operated drywall craftsmanship proudly serving Central Florida.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6 font-sans">
            Drywall work—hanging, taping, mudding, sanding, texture—is the foundation of every finished room. We install new drywall for additions and remodels, patch holes from <a href="/services/demolition" class="text-gopro-orange hover:underline">demolition</a> or accidents, match textures so repairs disappear, and prep walls smooth and ready for <a href="/services/interior-exterior-painting" class="text-gopro-orange hover:underline">paint</a>.
          </p>
          <p class="text-lg text-gray-600 mb-8 font-sans">
            Whether you're finishing a garage, repairing water damage, or need full-room drywall for a Kissimmee vacation rental, we handle it across Orlando and Central Florida.
          </p>
        </div>
        
        <!-- Work Example -->
        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">Drywall Work</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
            <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg">
              <img src="/images/drywall.jpg" alt="Drywall repair in Orlando" class="w-full h-full object-cover" />
            </div>
            <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg">
              <img src="/images/bedroom-paint.jpg" alt="Drywall installation in Kissimmee" class="w-full h-full object-cover" />
            </div>
            <div class="relative aspect-square rounded-lg overflow-hidden shadow-lg">
              <img src="/images/trim-navy-wall.jpg" alt="Drywall repair in Orlando bedroom" class="w-full h-full object-cover" />
            </div>
          </div>
          <p class="text-center">
            <a href="/work" class="text-gopro-orange hover:underline font-semibold">View our full portfolio →</a>
          </p>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h2 class="text-xl font-display font-bold uppercase mb-3 tracking-wide">Florida Humidity & Drying Time</h2>
          <p class="text-gray-700 font-sans">
            Central Florida's humidity slows joint compound drying, especially in summer. We schedule jobs so each coat has time to cure fully before the next—mudding one day, sanding the next, texture and prime after that. Rushing drywall guarantees cracks and poor adhesion.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">What We Do</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">New Drywall Installation (rooms, garages, additions)</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Drywall Repair & Patching (holes, cracks, dents)</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Texture Matching (knockdown, orange peel, smooth)</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Water Damage Repair</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Ceiling Repair & Texture</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Skim Coating (smooth finish over textured walls)</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Taping, Mudding & Sanding</span>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 font-sans">Commercial Drywall</span>
            </div>
          </div>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-display font-black uppercase mb-8 tracking-tight">Common Questions</h2>
          <div class="space-y-6">
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">How much does drywall repair cost in Kissimmee?</h3>
              <p class="text-gray-700 font-sans">
                Drywall repair costs depend on damage size and complexity. Small patches (under 6 inches) typically run $75-$150, larger holes $150-$400. Full room drywall runs $1.50-$3 per square foot installed. We provide free estimates so you know the exact cost upfront.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Can you match existing wall texture?</h3>
              <p class="text-gray-700 font-sans">
                Yes. We match knockdown, orange peel, skip trowel, and other common Central Florida textures. Matching texture is critical for repairs to blend invisibly with the rest of the wall.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">How long does drywall take to dry before painting?</h3>
              <p class="text-gray-700 font-sans">
                Joint compound typically dries in 24 hours between coats in Florida's humidity. Full curing before <a href="/services/interior-exterior-painting" class="text-gopro-orange hover:underline">painting</a> takes 48-72 hours. We schedule jobs so you're not waiting—mudding one day, sanding the next, priming and painting after that.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Do you repair water-damaged drywall?</h3>
              <p class="text-gray-700 font-sans">
                Yes. We cut out water-damaged sections, let the framing dry, install new drywall, tape, mud, texture, and paint to match. Important: fix the leak first, or the repair won't last.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">What causes drywall cracks in Florida homes?</h3>
              <p class="text-gray-700 font-sans">
                Most cracks in Central Florida come from settling, temperature swings, or poor initial taping. Some older homes near <a href="/areas/kissimmee" class="text-gopro-orange hover:underline">Kissimmee</a> have minor foundation movement from sandy soil. We assess the cause, repair the crack properly, and recommend fixes if it's structural.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Related Guides -->
        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h3 class="text-xl font-display font-bold uppercase mb-4 tracking-wide">Drywall Repair Guides</h3>
          <ul class="space-y-2 font-sans">
            <li>
              <a href="/guides/water-damage-drywall-repair-central-florida" class="text-gopro-orange hover:underline">
                Water Damage Drywall Repair in Central Florida
              </a>
            </li>
            <li>
              <a href="/guides/drywall-repair-cost-kissimmee" class="text-gopro-orange hover:underline">
                Drywall Repair Cost in Kissimmee
              </a>
            </li>
            <li>
              <a href="/guides/drywall-texture-matching-central-florida" class="text-gopro-orange hover:underline">
                Drywall Texture Matching in Central Florida
              </a>
            </li>
          </ul>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6 font-sans">Need drywall installation or repair?</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/estimate" class="btn-primary">
              Get Free Estimate
            </a>
            <a href="tel:4072446873" class="btn-secondary">
              Call (407) 244-6873
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Professional Drywall Installation & Repair"
    description="Smooth walls, invisible repairs, expert texture matching. Serving Kissimmee, Orlando & Central Florida."
  />

  <Footer />
</BaseLayout>
