---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="TV Mounting Services | Go Pro Home Improvements"
  description="Professional TV mounting and installation in Central Florida. Secure mounting with wire concealment and optimal viewing angles for any TV size."
>
  <Header />

  <section class="bg-gradient-to-br from-gopro-black to-gray-900 text-white py-16">
    <div class="container-custom">
      <nav class="text-sm mb-6">
        <a href="/" class="text-gray-400 hover:text-white">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/services" class="text-gray-400 hover:text-white">Services</a>
        <span class="mx-2 text-gray-500">/</span>
        <span>TV Mounting</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">TV Mounting</h1>
      <p class="text-xl text-gray-300 max-w-3xl">
        Professional TV mounting services with secure installation and clean wire concealment.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            A professionally mounted TV not only saves space and looks modern, it also provides the optimal viewing experience. Go Pro specializes in secure TV mounting that's done right—properly anchored, perfectly level, and with all wires concealed for a clean, finished look.
          </p>
          <p class="text-lg text-gray-600 mb-8">
            Whether you're mounting a TV in your living room, bedroom, office, or commercial space, we handle installations of all sizes and types. From basic fixed mounts to full-motion articulating brackets, we ensure your TV is secure and positioned exactly where you want it.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold mb-6">TV Mounting Services</h2>
          <ul class="space-y-4">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Wall Mounting</h3>
                <p class="text-gray-600">Secure mounting to studs or with proper anchors for any wall type.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Wire Concealment</h3>
                <p class="text-gray-600">Hide all cables in-wall or with cable management solutions.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Articulating Mounts</h3>
                <p class="text-gray-600">Full-motion mounts for flexible viewing angles.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Sound Bar Installation</h3>
                <p class="text-gray-600">Mount and connect sound bars for enhanced audio.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Component Integration</h3>
                <p class="text-gray-600">Connect cable boxes, streaming devices, and gaming consoles.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Commercial Installations</h3>
                <p class="text-gray-600">Multiple TV setups for businesses and waiting areas.</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h3 class="text-xl font-bold mb-3">Safe & Secure Installation</h3>
          <p class="text-gray-700">
            We take TV mounting seriously. Every installation is anchored to wall studs whenever possible, and we use the right hardware for your wall type (drywall, concrete, brick, or tile). The result? A secure, level mount that looks professional and gives you peace of mind. We handle TVs of all sizes and weights safely.
          </p>
        </div>

        <div class="border-l-4 border-gopro-orange pl-6 mb-12">
          <h2 class="text-2xl font-bold mb-4">Our Service Promise</h2>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Complete, accurate, rock-solid up-front estimates
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Quick, careful work that accommodates your schedule
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Treat your property and belongings with utmost care and respect
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Do the job right—it's as simple as that
            </li>
          </ul>
        </div>

        <div class="text-center">
          <a href="/estimate" class="btn-primary">
            Get Free Estimate
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Ready for a Professional TV Mount?"
    description="Secure, clean TV mounting with proper wire concealment. Get your free estimate today."
  />

  <Footer />
</BaseLayout>
