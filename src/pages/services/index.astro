---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';

const services = [
  {
    name: 'Power Washing',
    href: '/services/power-washing',
    description: 'Algae, mildew, and dirt off the house, driveway, sidewalk, and pool deck, so the outside is usable again.',
    image: '/images/power-washing.jpg',
    icon: 'wash',
    alt: 'Power washing'
  },
  {
    name: 'Interior & Exterior Painting',
    href: '/services/interior-exterior-painting',
    description: 'A room that looks finished, or an exterior that holds up in the Florida sun. One room or the whole house.',
    image: '/images/bedroom-paint.jpg',
    icon: 'paint',
    alt: 'Interior painting'
  },
  {
    name: 'Demolition',
    href: '/services/demolition',
    description: 'Kitchens, bathrooms, and walls torn out and hauled away so the remodel can start.',
    image: '/images/demolition.jpg',
    icon: 'demo',
    alt: 'Interior demolition'
  },
  {
    name: 'Trim & Crown Molding',
    href: '/services/trim-crown-molding',
    description: 'Crown, baseboards, and paneling installed and painted so the room looks finished.',
    image: '/images/trim-navy-wall.jpg',
    icon: 'trim',
    alt: 'Trim and crown molding'
  },
  {
    name: 'Wallpaper',
    href: '/services/wallpaper',
    description: 'Paper hung with seams that sit flat, or old paper stripped and the wall prepped for paint.',
    image: '/images/wallpaper.jpg',
    icon: 'wallpaper',
    alt: 'Wallpaper installation'
  },
  {
    name: 'Murals',
    href: '/services/murals',
    description: "A hand-painted wall for a kid's room, a nursery, or a feature wall.",
    image: '/images/nemo-mural.jpg',
    icon: 'mural',
    alt: 'Custom mural'
  },
  {
    name: 'TV Mounting',
    href: '/services/tv-mounting',
    description: 'The TV on the wall, level, with the wires out of sight.',
    image: '/images/wall-mount.jpg',
    icon: 'tv',
    alt: 'Wall-mounted television'
  },
  {
    name: 'Movie Rooms',
    href: '/services/movie-rooms',
    description: 'A spare room turned into a place to watch movies: dark walls, seating, sound, and the screen in the right spot.',
    image: '/images/movie-room.jpg',
    icon: 'theater',
    alt: 'Home theater'
  },
  {
    name: 'Drywall',
    href: '/services/drywall',
    description: 'New walls hung, or holes and water stains patched and textured so they disappear under paint.',
    image: '/images/drywall.jpg',
    icon: 'drywall',
    alt: 'Drywall repair'
  }
];
---

<BaseLayout
  title="Home Improvement Services | Go Pro Home Improvements"
  description="Professional home improvement services in Central Florida: painting, power washing, demolition, trim & molding, wallpaper, murals, TV mounting, home theaters, and drywall."
>
  <Header />
  <main id="main">
    <header class="page-intro">
      <div class="container-custom">
        <p class="kicker">03 / What we do</p>
        <h1>Our services</h1>
        <p class="lede">Painting, drywall, washing, trim, theaters, and the rest. Kissimmee and nearby. Free estimates.</p>
      </div>
    </header>

    <section class="section-padding" style="padding-top: 1.5rem;">
      <div class="container-custom">
        <ol class="service-index">
          {services.map((service, i) => (
            <li>
              <a href={service.href}>
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <img src={service.image} alt={service.alt} width="240" height="180" loading="lazy" decoding="async" />
                <span>
                  <h2>{service.name}</h2>
                  <p>{service.description}</p>
                </span>
                <span class="more-link">Learn more</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section-padding band-stone">
      <div class="container-custom">
        <div class="section-head">
          <h2>Not sure if we do it?</h2>
          <p class="lede">These are the jobs we take. If yours is on the list, call. If you're not sure, call and ask. We'll tell you yes or no.</p>
        </div>
        <a href="/estimate" class="btn-primary">Request a free estimate</a>
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
