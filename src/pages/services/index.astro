---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';

const services = [
  {
    name: 'Power Washing',
    href: '/services/power-washing',
    description: 'Algae, mildew, and dirt off the house, driveway, sidewalk, and pool deck, so the outside is usable again.'
  },
  {
    name: 'Interior & Exterior Painting',
    href: '/services/interior-exterior-painting',
    description: 'A room that looks finished, or an exterior that holds up in the Florida sun. One room or the whole house.'
  },
  {
    name: 'Demolition',
    href: '/services/demolition',
    description: 'Kitchens, bathrooms, and walls torn out and hauled away so the remodel can start.'
  },
  {
    name: 'Trim & Crown Molding',
    href: '/services/trim-crown-molding',
    description: 'Crown, baseboards, and paneling installed and painted so the room looks finished.'
  },
  {
    name: 'Wallpaper',
    href: '/services/wallpaper',
    description: 'Paper hung with seams that sit flat, or old paper stripped and the wall prepped for paint.'
  },
  {
    name: 'Murals',
    href: '/services/murals',
    description: 'A hand-painted wall for a kid\'s room, a nursery, or a feature wall.'
  },
  {
    name: 'TV Mounting',
    href: '/services/tv-mounting',
    description: 'The TV on the wall, level, with the wires out of sight.'
  },
  {
    name: 'Movie Rooms',
    href: '/services/movie-rooms',
    description: 'A spare room turned into a place to watch movies: dark walls, seating, sound, and the screen in the right spot.'
  },
  {
    name: 'Drywall',
    href: '/services/drywall',
    description: 'New walls hung, or holes and water stains patched and textured so they disappear under paint.'
  }
];
---

<BaseLayout
  title="Home Improvement Services | Go Pro Home Improvements"
  description="Professional home improvement services in Central Florida: painting, power washing, demolition, trim & molding, wallpaper, murals, TV mounting, home theaters, and drywall."
>
  <Header />

  <!-- Services Hero -->
  <section class="bg-gradient-to-br from-gopro-black to-gray-900 text-white py-16">
    <div class="container-custom text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Our Services</h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">
        Painting, drywall, washing, trim, theaters, and the rest. Kissimmee and nearby. Free estimates.
      </p>
    </div>
  </section>

  <!-- Services List -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <a
            href={service.href}
            class="group bg-white border-2 border-gray-200 hover:border-gopro-orange p-8 rounded-lg transition-all hover:shadow-xl"
          >
            <h2 class="text-2xl font-bold mb-4 group-hover:text-gopro-orange transition-colors">
              {service.name}
            </h2>
            <p class="text-gray-600 mb-6 leading-relaxed">{service.description}</p>
            <span class="text-gopro-orange font-semibold group-hover:underline inline-flex items-center">
              Learn More
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Additional Services Note -->
  <section class="section-padding bg-gray-50">
    <div class="container-custom text-center">
      <h2 class="text-3xl font-bold mb-4">Not sure if we do it?</h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-6">
        These are the jobs we take. If yours is on the list, call. If you're not sure, call and ask. We'll tell you yes or no.
      </p>
      <a href="/estimate" class="btn-primary">
        Request a Free Estimate
      </a>
    </div>
  </section>

  <CTASection />

  <Footer />
</BaseLayout>
