---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Home Theater & Movie Room Design | Go Pro Home Improvements"
  description="Professional home theater design and installation in Central Florida. Complete movie room setups with projector mounting, acoustic treatment, and lighting."
>
  <Header />

  <section class="bg-gradient-to-br from-gopro-black to-gray-900 text-white py-16">
    <div class="container-custom">
      <nav class="text-sm mb-6">
        <a href="/" class="text-gray-400 hover:text-white">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/services" class="text-gray-400 hover:text-white">Services</a>
        <span class="mx-2 text-gray-500">/</span>
        <span>Movie Rooms</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Home Theater & Movie Rooms</h1>
      <p class="text-xl text-gray-300 max-w-3xl">
        Complete home theater design and installation for the ultimate movie-watching experience.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            Get the movie room you've always dreamed of. Go Pro specializes in transforming ordinary spaces into immersive home theaters that rival commercial cinemas. From projector mounting and screen installation to acoustic treatment and ambient lighting, we handle every detail.
          </p>
          <p class="text-lg text-gray-600 mb-8">
            Whether you're converting a spare bedroom, finishing a basement, or building a dedicated theater room, we work with you to create a space that delivers an unforgettable viewing experience. Our installations integrate video, audio, lighting, and aesthetics into one cohesive entertainment environment.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold mb-6">Home Theater Services</h2>
          <ul class="space-y-4">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Projector Mounting & Setup</h3>
                <p class="text-gray-600">Professional ceiling or shelf mounting with proper alignment and calibration.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Screen Installation</h3>
                <p class="text-gray-600">Fixed or motorized projection screens sized perfectly for your space.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Surround Sound Setup</h3>
                <p class="text-gray-600">Speaker placement and wiring for immersive audio.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Acoustic Treatment</h3>
                <p class="text-gray-600">Sound panels and treatments to optimize audio quality.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Ambient Lighting</h3>
                <p class="text-gray-600">Dimmable lighting solutions for the perfect viewing environment.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Seating & Layout Design</h3>
                <p class="text-gray-600">Space planning for optimal viewing angles and comfort.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Wire Management</h3>
                <p class="text-gray-600">Clean, concealed wiring throughout the theater space.</p>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <div>
                <h3 class="font-bold text-gray-900">Aesthetic Finishing</h3>
                <p class="text-gray-600">Paint, trim, and decorative elements to complete the theater look.</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h3 class="text-xl font-bold mb-3">From Concept to Cinema</h3>
          <p class="text-gray-700 mb-3">
            Creating a home theater involves more than just mounting equipment. It requires thoughtful planning of sightlines, acoustics, lighting control, and aesthetic elements that work together to create an immersive experience.
          </p>
          <p class="text-gray-700">
            We guide you through the entire process—from choosing the right equipment for your space and budget to the final installation and calibration. Whether you want a simple projection setup or a full-scale cinema with tiered seating, we make it happen.
          </p>
        </div>

        <div class="border-l-4 border-gopro-orange pl-6 mb-12">
          <h2 class="text-2xl font-bold mb-4">Our Service Promise</h2>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Complete, accurate, rock-solid up-front estimates
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Quick, careful work that accommodates your schedule
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Treat your property and belongings with utmost care and respect
            </li>
            <li class="flex items-start">
              <span class="text-gopro-orange mr-2">•</span>
              Do the job right—it's as simple as that
            </li>
          </ul>
        </div>

        <div class="mb-12">
          <div class="grid md:grid-cols-2 gap-6">
            <img src="/images/movie-room.jpg" alt="Home theater with theater seating and projection screen" class="w-full rounded-lg shadow-lg" />
            <img src="/images/star-wars-theater.jpg" alt="Star Wars themed home theater" class="w-full rounded-lg shadow-lg" />
          </div>
        </div>

        <div class="text-center">
          <a href="/estimate" class="btn-primary">
            Get Free Estimate
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Ready to Build Your Dream Theater?"
    description="Transform your space into an immersive home cinema. Contact us to discuss your vision and get started."
  />

  <Footer />
</BaseLayout>
