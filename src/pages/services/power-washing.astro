---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Power Washing in Central Florida | Go Pro"
  description="Power washing across Central Florida. Driveways, pool decks, siding, patios. Remove algae & mildew. Owner-operated since 2014. Free estimates."
  ogImage="/images/power-washing.jpg"
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HomeAndConstructionBusiness",
        "@id": "https://goprohomeimprovements.com/#business",
        "name": "Go Pro Home Improvements",
        "url": "https://goprohomeimprovements.com",
        "telephone": "(407) 244-6873",
        "email": "gopro4good@gmail.com",
        "image": "https://goprohomeimprovements.com/images/logo.png",
        "logo": {
          "@type": "ImageObject",
          "url": "https://goprohomeimprovements.com/images/logo.png"
        },
        "priceRange": "$$",
        "areaServed": [
          { "@type": "City", "name": "Kissimmee" },
          { "@type": "City", "name": "Orlando" },
          { "@type": "City", "name": "St. Cloud" },
          { "@type": "City", "name": "Celebration" },
          { "@type": "City", "name": "Poinciana" }
        ],
        "sameAs": [
          "https://www.instagram.com/gopro4good/"
        ]
      },
      {
        "@type": "Service",
        "@id": "https://goprohomeimprovements.com/services/power-washing/#service",
        "serviceType": "Power Washing",
        "provider": {
          "@id": "https://goprohomeimprovements.com/#business"
        },
        "areaServed": [
          { "@type": "City", "name": "Kissimmee" },
          { "@type": "City", "name": "Orlando" },
          { "@type": "City", "name": "St. Cloud" },
          { "@type": "City", "name": "Celebration" },
          { "@type": "City", "name": "Poinciana" }
        ],
        "description": "Professional power washing for driveways, houses, pool decks, patios, and more in Central Florida."
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://goprohomeimprovements.com/services/power-washing/#breadcrumbs",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://goprohomeimprovements.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Services",
            "item": "https://goprohomeimprovements.com/services"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Power Washing",
            "item": "https://goprohomeimprovements.com/services/power-washing"
          }
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "https://goprohomeimprovements.com/services/power-washing/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How much does power washing cost in Kissimmee?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A washing estimate depends on the surface and how much growth is on it. We itemize after we see the property. Request a free estimate online."
            }
          },
          {
            "@type": "Question",
            "name": "Will power washing damage my siding or driveway?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Not when done correctly. We adjust pressure and technique for each surface—soft wash for vinyl siding, higher pressure for concrete. Owner-operated since 2014, we clean safely for the surface at hand."
            }
          },
          {
            "@type": "Question",
            "name": "How often should I power wash my home in Florida?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Florida's humidity and sun cause algae and mildew to grow faster. Most homes benefit from power washing every 12-18 months. Driveways and pool decks may need it more often depending on use and tree coverage."
            }
          },
          {
            "@type": "Question",
            "name": "Do you power wash before painting?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, absolutely. We power wash exterior surfaces before any painting project to remove dirt, mildew, and loose paint. It's essential for paint adhesion and long-lasting results."
            }
          }
        ]
      }
    ]
  }}
>
  <Header />

  <!-- Hero -->
  <section class="bg-gopro-charcoal text-white py-16 border-b-4 border-gopro-orange">
    <div class="container-custom">
      <nav class="text-sm mb-6 font-sans">
        <a href="/" class="text-gray-400 hover:text-gopro-orange transition-colors">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/services" class="text-gray-400 hover:text-gopro-orange transition-colors">Services</a>
        <span class="mx-2 text-gray-500">/</span>
        <span class="text-white">Power Washing</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-display font-black uppercase mb-4 tracking-tight">Power Washing in Central Florida</h1>
      <p class="text-xl text-gray-300 max-w-3xl font-sans mb-8">
        Driveways, pool decks, siding, patios. Remove algae, mildew & grime across Central Florida. For Kissimmee-specific jobs, see the Kissimmee power washing page.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/estimate" class="btn-primary">Get Free Estimate</a>
        <a href="tel:4072446873" class="btn-secondary">Call (407) 244-6873</a>
      </div>
    </div>
  </section>

  <!-- Hero Image -->
  <section class="relative h-96 overflow-hidden">
    <img src="/images/power-washing.jpg" alt="Professional power washing services" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
  </section>

  <!-- Content -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            There are many reasons power washing is essential for your property. Green algae growing on your home's exterior? Trying to sell and need maximum curb appeal? Pool area looking grimy after winter? Sidewalks and driveways turning black with buildup?
          </p>
          <p class="text-lg text-gray-600 mb-8">
            Whatever the reason, professional power washing can transform your property's appearance and protect your investment. We have the equipment and technique to safely clean exterior surfaces without damage. Looking for <a href="/services/power-washing-kissimmee" class="text-gopro-orange hover:underline">power washing in Kissimmee</a>? That city page is the primary local page.
          </p>
        </div>

        <div class="bg-white border border-gray-200 rounded-lg p-6 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-4 tracking-wide">Power Washing by City</h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 font-sans">
            <li><a href="/services/power-washing-kissimmee" class="text-gopro-orange hover:underline">Power washing in Kissimmee</a></li>
            <li><a href="/services/power-washing-orlando" class="text-gopro-orange hover:underline">Power washing in Orlando</a></li>
            <li><a href="/services/power-washing-st-cloud" class="text-gopro-orange hover:underline">Power washing in St. Cloud</a></li>
            <li><a href="/services/power-washing-celebration" class="text-gopro-orange hover:underline">Power washing in Celebration</a></li>
            <li><a href="/services/power-washing-poinciana" class="text-gopro-orange hover:underline">Power washing in Poinciana</a></li>
          </ul>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">How We Work</h2>
          <ol class="space-y-3 list-decimal list-inside text-gray-700 font-sans">
            <li><strong>Free estimate</strong> — Tell us the surfaces. We look at the property, then we price it.</li>
            <li><strong>Prep</strong> — Protect plants, windows, and nearby areas as needed.</li>
            <li><strong>Wash</strong> — Soft wash or pressure wash matched to the surface.</li>
            <li><strong>Walkthrough</strong> — You check the results with us before we wrap up.</li>
          </ol>
          <p class="mt-6 font-sans"><a href="/estimate" class="text-gopro-orange hover:underline font-semibold">Request a free estimate →</a></p>
        </div>

        <!-- Florida Context -->
        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h2 class="text-xl font-display font-bold uppercase mb-3 tracking-wide">Florida Humidity & Algae</h2>
          <p class="text-gray-700 font-sans">
            Florida's climate makes algae, mildew, and mold grow fast on driveways, siding, and pool decks. Regular power washing removes buildup before it stains permanently, protects your investment, and keeps your home looking sharp. Many <a href="/areas/kissimmee" class="text-gopro-orange hover:underline">Kissimmee</a> and <a href="/areas/orlando" class="text-gopro-orange hover:underline">Orlando</a> homeowners schedule annual washes to stay ahead of the green.
          </p>
        </div>

        <!-- Services List -->
        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">What We Wash</h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">House Exterior & Siding</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Driveways & Sidewalks</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Pool Decks & Patios</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Fences & Decks</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Parking Lots</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Commercial Buildings</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">Outdoor Furniture</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-gopro-orange mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700">And More</span>
            </li>
          </ul>
        </div>

        <!-- FAQ -->
        <div class="mb-12">
          <h2 class="text-3xl font-display font-black uppercase mb-8 tracking-tight">Common Questions</h2>
          <div class="space-y-6">
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">How much does power washing cost?</h3>
              <p class="text-gray-700 font-sans">
                Cost depends on the surface and growth. For Kissimmee jobs, see <a href="/services/power-washing-kissimmee" class="text-gopro-orange hover:underline">power washing in Kissimmee</a> or <a href="/estimate" class="text-gopro-orange hover:underline">request a free estimate</a>.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Will power washing damage my siding or driveway?</h3>
              <p class="text-gray-700 font-sans">
                Not when done correctly. We adjust pressure and technique for each surface—soft wash for vinyl siding, higher pressure for concrete. Owner-operated since 2014, we clean safely for the surface at hand.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">How often should I power wash my home in Florida?</h3>
              <p class="text-gray-700 font-sans">
                Florida's humidity and sun cause algae and mildew to grow faster. Most homes benefit from power washing every 12-18 months. Driveways and pool decks may need it more often depending on use and tree coverage.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Do you power wash before painting?</h3>
              <p class="text-gray-700 font-sans">
                Yes, absolutely. We <a href="/services/interior-exterior-painting" class="text-gopro-orange hover:underline">power wash exterior surfaces</a> before any painting project to remove dirt, mildew, and loose paint. It's essential for paint adhesion and long-lasting results.
              </p>
            </div>
          </div>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6 font-sans">Ready for a cleaner driveway, house, or pool deck?</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/estimate" class="btn-primary">
              Get Free Estimate
            </a>
            <a href="tel:4072446873" class="btn-secondary">
              Call (407) 244-6873
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Ready for a Cleaner Property?"
    description="Call us today for a free estimate. Transform your property's appearance with professional power washing."
  />

  <Footer />
</BaseLayout>
