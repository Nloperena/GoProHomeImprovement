---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';

const facts = [
  ['Who you talk to', 'The owner answers. No salesperson quotes the job and then sends someone else to do it.'],
  ['What the price covers', 'You get a written estimate before work starts. If the job changes, we talk about it before we add anything.'],
  ['When we work', 'Monday through Friday, 7 AM to 5 PM. Call or send the estimate form.'],
];

const reasons = [
  ['The owner is on the job', 'You can call the same person who wrote the estimate.'],
  ['Local jobs', 'Based in Kissimmee. We work in Orlando, St. Cloud, Celebration, Poinciana, and the rest of Central Florida.'],
  ['A price before we start', 'The estimate is free. You see the number before you say yes.'],
  ['The house is left clean', 'We treat the house with care and clean up when the job is done.'],
];

const commitments = [
  'You get a written estimate before work starts',
  'We work Monday through Friday, 7 AM to 5 PM',
  'We treat the house with care and clean up when we leave',
  'You talk to the owner, not a call center',
];
---

<BaseLayout
  title="About Us | Go Pro Home Improvements"
  description="Learn about Go Pro Home Improvements, an owner-operated home improvement contractor with 15+ years of experience serving Central Florida."
>
  <Header />
  <main id="main">
    <header class="page-intro">
      <div class="container-custom">
        <p class="kicker">02 / The company</p>
        <h1>About Go Pro</h1>
        <p class="lede">Owner-operated in Kissimmee since 2014. Monday through Friday, 7 AM to 5 PM.</p>
      </div>
    </header>

    <section class="section-padding" style="padding-top: 2rem;">
      <div class="container-custom">
        <div class="split">
          <figure class="about-frame">
            <div class="plate-photo">
              <img
                src="/images/crew-branded-shirt.jpg"
                alt="Go Pro crew installing flooring on a Central Florida job"
                width="1920"
                height="1440"
                decoding="async"
              />
              <div class="crop-marks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            </div>
            <figcaption>
              <span>On the job</span>
              <span>Kissimmee</span>
            </figcaption>
          </figure>
          <div class="prose-block">
            <p>
              Go Pro Home Improvements is an owner-operated Florida corporation, established in 2014 and based in Kissimmee. We paint inside and out, patch drywall, power wash, hang trim and wallpaper, mount TVs, build movie rooms, and paint murals.
            </p>
            <p>
              We're not a franchise. When you call, you talk to the owner. When we quote the job, that is the price we mean. When we show up, we finish the work. We do that in Kissimmee, Orlando, St. Cloud, Celebration, and Poinciana.
            </p>
            <p class="mt-8">
              <a class="btn-primary" href="/estimate">Get free estimate</a>
            </p>
          </div>
        </div>

        <div class="spec-grid">
          {facts.map(([title, copy]) => (
            <article>
              <h2>{title}</h2>
              <p>{copy}</p>
            </article>
          ))}
        </div>

        <div class="section-head" style="margin-top: 5rem;">
          <p class="kicker">Why Go Pro</p>
          <h2>You want the work done, and you want to know who is doing it.</h2>
        </div>
        <div class="why-grid">
          {reasons.map(([title, copy], i) => (
            <article>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>

        <div class="section-head" style="margin-top: 5rem;">
          <h2>Our commitment</h2>
        </div>
        <ul class="commit-list" style="max-width: 40rem;">
          {commitments.map((item) => <li>{item}</li>)}
        </ul>

        <p class="mt-10 text-[var(--ink-soft)]">
          Call or request an estimate when you know the job.
        </p>
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
