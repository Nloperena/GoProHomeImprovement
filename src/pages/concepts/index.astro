---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/concepts.css';

const concepts = [
  {
    href: '/concepts/a',
    mark: 'A',
    name: 'Call first',
    idea: 'The phone number is the headline. The room is proof underneath, not the point.',
  },
  {
    href: '/concepts/b',
    mark: 'B',
    name: 'The bid on the room',
    idea: 'The finished room stays full-bleed, and the offer sits on it like a job card you can act on.',
  },
  {
    href: '/concepts/c',
    mark: 'C',
    name: 'Proof, then the price',
    idea: 'The jobs fill the first screen. The offer is a rail beside them.',
  },
];
---

<BaseLayout
  noindex
  title="Homepage concepts | Go Pro Home Improvements"
  description="Three preview directions for the Go Pro homepage. The live homepage is unchanged."
>
  <Header />
  <main id="main" class="concept-index">
    <div class="container-custom">
      <p class="kicker">Previews</p>
      <h1>Three ways to open the site.</h1>
      <p class="concept-index-lede">The live homepage is unchanged. Pick a direction.</p>
      <ol>
        {concepts.map((item) => (
          <li>
            <a href={item.href}>
              <span>{item.mark}</span>
              <strong>{item.name}</strong>
              <em>{item.idea}</em>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </main>
  <Footer />
</BaseLayout>
