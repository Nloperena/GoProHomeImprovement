---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { defaultTitle } from '../../lib/seo';

const areas = await getCollection('service-areas');
areas.sort((a, b) => a.data.title.localeCompare(b.data.title));

const title = defaultTitle('Areas We Serve in Central Florida');
const description = 'Go Pro Home Improvements provides expert contractor services across Orlando, Kissimmee, Winter Park, and more.';
---

<Base title={title} description={description} path="/service-areas/">
	<section class="bg-cream/40 px-4 py-16 md:px-6 md:py-24 lg:px-8 border-b border-line">
		<div class="mx-auto max-w-content text-center">
			<h1 class="font-display text-4xl font-semibold text-ink md:text-5xl">Service Areas</h1>
			<p class="mt-4 text-lg text-slate max-w-2xl mx-auto">
				We proudly serve homeowners and businesses throughout Central Florida.
			</p>
		</div>
	</section>

	<section class="px-4 py-16 md:px-6 md:py-24 lg:px-8">
		<div class="mx-auto max-w-content">
			{areas.length > 0 ? (
				<div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
					{areas.map((area) => (
						<a 
							href={`/service-areas/${area.id}/`} 
							class="block rounded-sm bg-paper p-6 border border-line transition-shadow hover:border-orange/50 hover:shadow-sm group text-center"
						>
							<h2 class="font-semibold text-lg text-ink group-hover:text-orange">{area.data.title}</h2>
							<p class="mt-2 text-sm text-slate">Learn more →</p>
						</a>
					))}
				</div>
			) : (
				<div class="text-center py-20 bg-cream rounded-sm border border-line">
					<p class="text-slate text-lg">Area pages are coming soon.</p>
				</div>
			)}
		</div>
	</section>
</Base>
