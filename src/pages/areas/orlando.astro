---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Orlando Home Improvement | Painting, Theaters, Drywall | Go Pro"
  description="Owner-operated painting, home theaters, and drywall in Orlando, FL. Free estimates. Call (407) 244-6873."
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HomeAndConstructionBusiness",
        "@id": "https://goprohomeimprovements.com/#business",
        "name": "Go Pro Home Improvements",
        "url": "https://goprohomeimprovements.com",
        "telephone": "(407) 244-6873",
        "email": "gopro4good@gmail.com",
        "image": "https://goprohomeimprovements.com/images/logo.png",
        "logo": {
          "@type": "ImageObject",
          "url": "https://goprohomeimprovements.com/images/logo.png"
        },
        "priceRange": "$$",
        "areaServed": [
          { "@type": "City", "name": "Orlando", "containedIn": "Florida" }
        ],
        "sameAs": [
          "https://www.instagram.com/gopro4good/"
        ]
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://goprohomeimprovements.com/areas/orlando/#breadcrumbs",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://goprohomeimprovements.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Service Areas",
            "item": "https://goprohomeimprovements.com/areas"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Orlando",
            "item": "https://goprohomeimprovements.com/areas/orlando"
          }
        ]
      }
    ]
  }}
>
  <Header />

  <section class="bg-gopro-charcoal text-white py-16 border-b-4 border-gopro-orange">
    <div class="container-custom">
      <nav class="text-sm mb-6 font-sans">
        <a href="/" class="text-gray-400 hover:text-gopro-orange transition-colors">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/areas" class="text-gray-400 hover:text-gopro-orange transition-colors">Service Areas</a>
        <span class="mx-2 text-gray-500">/</span>
        <span class="text-white">Orlando</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-display font-black uppercase mb-4 tracking-tight">Home improvement in Orlando</h1>
      <p class="text-xl text-gray-300 max-w-3xl font-sans">
        Owner-operated contractor serving Orlando and Orange County. 15+ years serving Central Florida with painting, home theaters, drywall & more.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            Go Pro Home Improvements proudly serves Orlando and Orange County with comprehensive home improvement services. From downtown Orlando to Winter Park, College Park to the Dr. Phillips area, we bring over 15 years of professional experience to residential and commercial properties throughout Orange County.
          </p>
          <p class="text-lg text-gray-600 mb-8">
            Whether you own a home in one of Orlando's historic neighborhoods, a modern property near the attractions, or a commercial space anywhere in Orange County, we provide the same owner-operated quality and reliable service. Based nearby in Kissimmee, we've served hundreds of Orlando homeowners and businesses with painting, home theater installations, drywall repair, and more.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">Our Services in Orlando</h2>
          <p class="text-gray-700 mb-6">
            We specialize in three core services that homeowners and property managers in Orlando trust us for:
          </p>
          <div class="grid md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-6 rounded-lg border-l-4 border-gopro-orange">
              <h3 class="text-lg font-display font-bold uppercase mb-3 tracking-wide">Interior & Exterior Painting</h3>
              <p class="text-gray-600 text-sm mb-4">
                Quality painting for homes and businesses. From historic Orlando neighborhoods to modern properties, we prep right and use paint rated for Florida's climate.
              </p>
              <a href="/services/interior-exterior-painting" class="text-gopro-orange hover:underline font-semibold text-sm">Learn more →</a>
            </div>
            <div class="bg-white p-6 rounded-lg border-l-4 border-gopro-orange">
              <h3 class="text-lg font-display font-bold uppercase mb-3 tracking-wide">Home Theater Installation</h3>
              <p class="text-gray-600 text-sm mb-4">
                Full custom home theater builds throughout Orlando and Orange County—paint, trim, acoustic panels, AV coordination, and themed rooms.
              </p>
              <a href="/services/movie-rooms" class="text-gopro-orange hover:underline font-semibold text-sm">Learn more →</a>
            </div>
            <div class="bg-white p-6 rounded-lg border-l-4 border-gopro-orange">
              <h3 class="text-lg font-display font-bold uppercase mb-3 tracking-wide">Drywall Repair & Installation</h3>
              <p class="text-gray-600 text-sm mb-4">
                Water damage repair, texture matching, full room drywall, and invisible patches. Professional drywall work for Orlando homes and businesses.
              </p>
              <a href="/services/drywall" class="text-gopro-orange hover:underline font-semibold text-sm">Learn more →</a>
            </div>
          </div>
          <p class="text-center">
            <a href="/services" class="text-gray-700 hover:text-gopro-orange transition-colors font-semibold">View all our services →</a>
          </p>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h3 class="text-xl font-display font-bold uppercase mb-3 tracking-wide">Serving Orlando & Orange County</h3>
          <p class="text-gray-700">
            We work throughout Orlando and Orange County, including downtown Orlando, Winter Park, College Park, Dr. Phillips, Baldwin Park, and surrounding communities. Whether residential or commercial, we bring the same owner-operated care and professional results to every project.
          </p>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6">
            Ready to get started on your Orlando home improvement project?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/estimate" class="btn-primary">
              Get Free Estimate
            </a>
            <a href="tel:4072446873" class="btn-secondary">
              Call (407) 244-6873
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />

  <Footer />
</BaseLayout>
