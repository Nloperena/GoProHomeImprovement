---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Home Improvement Services in Orlando, FL | Go Pro"
  description="Professional home improvement contractor serving Orlando and Orange County. Painting, power washing, remodeling, and more. 15+ years experience in Central Florida."
>
  <Header />

  <section class="bg-gradient-to-br from-gopro-black to-gray-900 text-white py-16">
    <div class="container-custom">
      <nav class="text-sm mb-6">
        <a href="/" class="text-gray-400 hover:text-white">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/areas" class="text-gray-400 hover:text-white">Service Areas</a>
        <span class="mx-2 text-gray-500">/</span>
        <span>Orlando</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Home Improvement Services in Orlando</h1>
      <p class="text-xl text-gray-300 max-w-3xl">
        Professional home improvement services throughout Orlando and Orange County. Over 15 years of trusted local experience.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            Go Pro Home Improvements proudly serves Orlando and Orange County with comprehensive home improvement services. From downtown Orlando to the surrounding communities, we bring over 15 years of professional experience to residential and commercial properties.
          </p>
          <p class="text-lg text-gray-600 mb-8">
            Whether you own a home in a historic Orlando neighborhood, a modern property near the attractions, or a commercial space anywhere in Orange County, we provide the same quality workmanship and reliable service that has built our reputation across Central Florida.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold mb-6">Services in Orlando</h2>
          <div class="grid md:grid-cols-2 gap-4">
            <a href="/services/power-washing" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Power Washing
            </a>
            <a href="/services/interior-exterior-painting" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Interior & Exterior Painting
            </a>
            <a href="/services/demolition" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Demolition
            </a>
            <a href="/services/drywall" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Drywall
            </a>
            <a href="/services/trim-crown-molding" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Trim & Crown Molding
            </a>
            <a href="/services/wallpaper" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Wallpaper & Murals
            </a>
            <a href="/services/movie-rooms" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Home Theater Design
            </a>
            <a href="/services" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center font-semibold">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              View All Services
            </a>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6">
            <h3 class="text-xl font-bold mb-3">Residential Services</h3>
            <p class="text-gray-700">
              From single-family homes to condos and townhomes, we handle projects of all sizes throughout Orlando. Interior remodels, exterior maintenance, and everything in between.
            </p>
          </div>
          <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6">
            <h3 class="text-xl font-bold mb-3">Commercial Services</h3>
            <p class="text-gray-700">
              We also serve commercial properties including offices, retail spaces, and rental properties. Professional results with minimal disruption to your business.
            </p>
          </div>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6">
            Ready to get started on your Orlando home improvement project?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/estimate" class="btn-primary">
              Get Free Estimate
            </a>
            <a href="tel:4072446873" class="btn-secondary">
              Call (407) 244-6873
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />

  <Footer />
</BaseLayout>
