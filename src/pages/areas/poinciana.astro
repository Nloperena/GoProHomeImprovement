---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Poinciana Home Improvement Contractor | Go Pro"
  description="Home improvement contractor in Poinciana, FL. Painting, power washing, drywall, home theaters & more. Owner-operated, 15+ years serving Central Florida."
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HomeAndConstructionBusiness",
        "@id": "https://goprohomeimprovements.com/#business",
        "name": "Go Pro Home Improvements",
        "url": "https://goprohomeimprovements.com",
        "telephone": "(407) 244-6873",
        "email": "gopro4good@gmail.com",
        "image": "https://goprohomeimprovements.com/images/logo.png",
        "logo": {
          "@type": "ImageObject",
          "url": "https://goprohomeimprovements.com/images/logo.png"
        },
        "priceRange": "$$",
        "areaServed": [
          { "@type": "City", "name": "Poinciana", "containedIn": "Florida" }
        ],
        "knowsAbout": [
          "Power Washing",
          "Interior Painting",
          "Exterior Painting",
          "Home Theater Installation",
          "Drywall Repair",
          "TV Mounting"
        ],
        "sameAs": [
          "https://www.instagram.com/gopro4good/"
        ]
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://goprohomeimprovements.com/areas/poinciana/#breadcrumbs",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://goprohomeimprovements.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Service Areas",
            "item": "https://goprohomeimprovements.com/areas"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Poinciana",
            "item": "https://goprohomeimprovements.com/areas/poinciana"
          }
        ]
      }
    ]
  }}
>
  <Header />

  <section class="bg-gopro-charcoal text-white py-16 border-b-4 border-gopro-orange">
    <div class="container-custom">
      <nav class="text-sm mb-6 font-sans">
        <a href="/" class="text-gray-400 hover:text-gopro-orange transition-colors">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/areas" class="text-gray-400 hover:text-gopro-orange transition-colors">Service Areas</a>
        <span class="mx-2 text-gray-500">/</span>
        <span class="text-white">Poinciana</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-display font-black uppercase mb-4 tracking-tight">Poinciana Home Improvement Contractor</h1>
      <p class="text-xl text-gray-300 max-w-3xl font-sans">
        Serving Poinciana homeowners with painting, power washing, drywall, home theater installs & more. Fair prices, quality work.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6 font-sans">
            Poinciana spans Osceola and Polk counties southwest of <a href="/areas/kissimmee" class="text-gopro-orange hover:underline">Kissimmee</a>, with a mix of single-family homes, rental properties, and growing subdivisions. Go Pro serves Poinciana residents who need <a href="/services/interior-exterior-painting" class="text-gopro-orange hover:underline">painting</a>, <a href="/services/power-washing" class="text-gopro-orange hover:underline">power washing</a>, and interior upgrades that improve comfort and resale value.
          </p>
          <p class="text-lg text-gray-600 mb-8 font-sans">
            Whether you're upgrading a living room with a <a href="/services/movie-rooms" class="text-gopro-orange hover:underline">home theater setup</a>, refreshing faded exterior paint, or repairing drywall from Florida humidity, we bring 15+ years of owner-operated experience to every Poinciana project.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">Popular Services in Poinciana</h2>
          <div class="grid md:grid-cols-2 gap-4">
            <a href="/services/power-washing" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center font-sans">
              <svg class="w-5 h-5 mr-2 text-gopro-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>Power Washing (driveways, siding)</span>
            </a>
            <a href="/services/interior-exterior-painting" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center font-sans">
              <svg class="w-5 h-5 mr-2 text-gopro-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>Interior & Exterior Painting</span>
            </a>
            <a href="/services/movie-rooms" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center font-sans">
              <svg class="w-5 h-5 mr-2 text-gopro-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>Home Theater Installation</span>
            </a>
            <a href="/services/drywall" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center font-sans">
              <svg class="w-5 h-5 mr-2 text-gopro-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>Drywall Repair & Texture Match</span>
            </a>
            <a href="/services/tv-mounting" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center font-sans">
              <svg class="w-5 h-5 mr-2 text-gopro-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>TV Mounting</span>
            </a>
            <a href="/services" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center font-sans font-semibold">
              <svg class="w-5 h-5 mr-2 text-gopro-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>View All Services</span>
            </a>
          </div>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h3 class="text-xl font-display font-bold uppercase mb-3 tracking-wide">Local to Poinciana</h3>
          <p class="text-gray-700 font-sans">
            We're based in <a href="/areas/kissimmee" class="text-gopro-orange hover:underline">Kissimmee</a>, just northeast of Poinciana. Same owner-operated service, same straightforward pricing—no hidden fees or long-distance charges.
          </p>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6 font-sans">
            Ready to improve your Poinciana home?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/estimate" class="btn-primary">
              Get Free Estimate
            </a>
            <a href="tel:4072446873" class="btn-secondary">
              Call (407) 244-6873
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />

  <Footer />
</BaseLayout>
