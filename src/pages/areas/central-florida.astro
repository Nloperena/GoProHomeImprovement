---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Home Improvement Services in Central Florida | Go Pro"
  description="Professional home improvement contractor serving all of Central Florida. Painting, power washing, remodeling, and more. Over 15 years of trusted local experience."
>
  <Header />

  <section class="bg-gradient-to-br from-gopro-black to-gray-900 text-white py-16">
    <div class="container-custom">
      <nav class="text-sm mb-6">
        <a href="/" class="text-gray-400 hover:text-white">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/areas" class="text-gray-400 hover:text-white">Service Areas</a>
        <span class="mx-2 text-gray-500">/</span>
        <span>Central Florida</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Serving All of Central Florida</h1>
      <p class="text-xl text-gray-300 max-w-3xl">
        Professional home improvement services throughout the Central Florida region. Over 15 years of experience serving our community.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            Go Pro Home Improvements has been serving Central Florida for over 15 years. Based in Kissimmee, we've expanded our services throughout the region, bringing quality workmanship and reliable service to homeowners and businesses across multiple counties.
          </p>
          <p class="text-lg text-gray-600 mb-8">
            Our growing company has built a strong reputation by consistently delivering excellent results. Whether you're in Osceola County, Orange County, or the surrounding Central Florida area, we're equipped to handle your home improvement needs with professionalism and expertise.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <div class="bg-gray-50 rounded-lg p-8">
            <h2 class="text-xl font-bold mb-4 text-gopro-orange">Primary Service Areas</h2>
            <ul class="space-y-2 text-gray-700">
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Kissimmee & Osceola County
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Orlando & Orange County
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Surrounding Central Florida Communities
              </li>
            </ul>
          </div>

          <div class="bg-gray-50 rounded-lg p-8">
            <h2 class="text-xl font-bold mb-4 text-gopro-orange">What We Offer</h2>
            <ul class="space-y-2 text-gray-700">
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Owner-Operated Business
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                15+ Years of Experience
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Comprehensive Services
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Free Estimates
              </li>
            </ul>
          </div>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-bold mb-6">Services Throughout Central Florida</h2>
          <div class="grid md:grid-cols-2 gap-4">
            <a href="/services/power-washing" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Power Washing
            </a>
            <a href="/services/interior-exterior-painting" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Interior & Exterior Painting
            </a>
            <a href="/services/demolition" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Demolition
            </a>
            <a href="/services/drywall" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Drywall Installation & Repair
            </a>
            <a href="/services/trim-crown-molding" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Trim & Crown Molding
            </a>
            <a href="/services/wallpaper" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Wallpaper & Murals
            </a>
            <a href="/services/tv-mounting" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              TV Mounting
            </a>
            <a href="/services/movie-rooms" class="text-gray-700 hover:text-gopro-orange transition-colors flex items-center">
              <svg class="w-5 h-5 mr-2 text-gopro-orange" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Home Theater Design
            </a>
          </div>
          <div class="mt-6 text-center">
            <a href="/services" class="text-gopro-orange font-semibold hover:underline">
              View All Services →
            </a>
          </div>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h3 class="text-xl font-bold mb-3">Confirm Service in Your Area</h3>
          <p class="text-gray-700">
            While we primarily serve Kissimmee, Orlando, and the immediate Central Florida area, we're continually expanding. If you're in Central Florida and need home improvement services, give us a call. We'll confirm whether we can serve your location and provide a free estimate for your project.
          </p>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6">
            Ready to get started on your Central Florida home improvement project?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/estimate" class="btn-primary">
              Get Free Estimate
            </a>
            <a href="tel:4072446873" class="btn-secondary">
              Call (407) 244-6873
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />

  <Footer />
</BaseLayout>
