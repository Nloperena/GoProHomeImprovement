---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Kissimmee Home Improvement | Painting & Drywall | Go Pro"
  description="Owner-operated home improvement in Kissimmee, FL. Painting, home theaters, drywall, and power washing. Free estimates. Call (407) 244-6873."
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HomeAndConstructionBusiness",
        "@id": "https://goprohomeimprovements.com/#business",
        "name": "Go Pro Home Improvements",
        "url": "https://goprohomeimprovements.com",
        "telephone": "(407) 244-6873",
        "email": "gopro4good@gmail.com",
        "foundingDate": "2014",
        "image": "https://goprohomeimprovements.com/images/logo.png",
        "logo": {
          "@type": "ImageObject",
          "url": "https://goprohomeimprovements.com/images/logo.png"
        },
        "priceRange": "$$",
        "areaServed": [
          { "@type": "City", "name": "Kissimmee", "containedIn": "Florida" }
        ],
        "knowsAbout": [
          "Power Washing",
          "Interior Painting",
          "Exterior Painting",
          "Trim Installation",
          "Crown Molding",
          "Home Theater Installation",
          "Drywall Repair"
        ],
        "sameAs": [
          "https://www.instagram.com/gopro4good/"
        ]
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://goprohomeimprovements.com/areas/kissimmee/#breadcrumbs",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://goprohomeimprovements.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Service Areas",
            "item": "https://goprohomeimprovements.com/areas"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Kissimmee",
            "item": "https://goprohomeimprovements.com/areas/kissimmee"
          }
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "https://goprohomeimprovements.com/areas/kissimmee/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What home improvement services do you offer in Kissimmee?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Painting, drywall repair, power washing, home theaters, trim, wallpaper, murals, TV mounting, and demolition. Each service has a Kissimmee page with details and a free estimate option."
            }
          },
          {
            "@type": "Question",
            "name": "Are you based in Kissimmee?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Go Pro Home Improvements is owner-operated and based in Kissimmee, Osceola County, serving nearby Central Florida cities since 2014."
            }
          },
          {
            "@type": "Question",
            "name": "How do I get a free estimate in Kissimmee?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Request an estimate online or call (407) 244-6873. We look at the job, then price it. The estimate is free."
            }
          },
          {
            "@type": "Question",
            "name": "Do you work on Kissimmee vacation rentals?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. We paint, repair drywall, and refresh interiors for short-term rentals near the parks corridor, scheduled around guest turnovers when needed."
            }
          }
        ]
      }
    ]
  }}
>
  <Header />

  <section class="bg-gopro-charcoal text-white py-16 border-b-4 border-gopro-orange">
    <div class="container-custom">
      <nav class="text-sm mb-6 font-sans">
        <a href="/" class="text-gray-400 hover:text-gopro-orange transition-colors">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/areas" class="text-gray-400 hover:text-gopro-orange transition-colors">Service Areas</a>
        <span class="mx-2 text-gray-500">/</span>
        <span class="text-white">Kissimmee</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-display font-black uppercase mb-4 tracking-tight">Home Improvement in Kissimmee</h1>
      <p class="text-xl text-gray-300 max-w-3xl font-sans mb-8">
        Owner-operated contractor based in Kissimmee since 2014. Painting, power washing, drywall, home theaters, and more across Osceola County.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/estimate" class="btn-primary">Get Free Estimate</a>
        <a href="tel:4072446873" class="btn-secondary">Call (407) 244-6873</a>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            Go Pro Home Improvements is proud to call Kissimmee home. Based in Osceola County and owner-operated since 2014, we serve neighbors from Buenaventura Lakes to Old Town, Poinciana Boulevard to the vacation rental corridors near the Disney area.
          </p>
          <p class="text-lg text-gray-600 mb-8">
            As a local, owner-operated business, we understand Kissimmee homes—from Florida humidity that demands quality exterior prep to the vacation rental market's need for reliable turnarounds. Whether you own a single-family home or manage a rental near the 192 corridor, you get the same owner-run care on every job.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">Our Services in Kissimmee</h2>
          <p class="text-gray-700 mb-6">
            Start with the Kissimmee page for the service you need:
          </p>
          <div class="grid md:grid-cols-2 gap-6 mb-8">
            <div class="bg-white p-6 rounded-lg border-l-4 border-gopro-orange">
              <h3 class="text-lg font-display font-bold uppercase mb-3 tracking-wide">Interior & Exterior Painting</h3>
              <p class="text-gray-600 text-sm mb-4">
                Vacation rental refreshes, interior rooms, and exterior stucco that stands up to Florida sun and humidity.
              </p>
              <a href="/services/painting-kissimmee" class="text-gopro-orange hover:underline font-semibold text-sm">Painting in Kissimmee →</a>
            </div>
            <div class="bg-white p-6 rounded-lg border-l-4 border-gopro-orange">
              <h3 class="text-lg font-display font-bold uppercase mb-3 tracking-wide">Home Theater Installation</h3>
              <p class="text-gray-600 text-sm mb-4">
                Custom home theater builds—paint, trim, acoustic panels, AV coordination, and themed rooms.
              </p>
              <a href="/services/movie-rooms-kissimmee" class="text-gopro-orange hover:underline font-semibold text-sm">Home theaters in Kissimmee →</a>
            </div>
            <div class="bg-white p-6 rounded-lg border-l-4 border-gopro-orange">
              <h3 class="text-lg font-display font-bold uppercase mb-3 tracking-wide">Drywall Repair</h3>
              <p class="text-gray-600 text-sm mb-4">
                For holes, cracks, water damage, and texture matching in Kissimmee homes and rentals, use our dedicated drywall page.
              </p>
              <a href="/services/drywall-repair-kissimmee" class="text-gopro-orange hover:underline font-semibold text-sm">Drywall repair in Kissimmee →</a>
            </div>
            <div class="bg-white p-6 rounded-lg border-l-4 border-gopro-orange">
              <h3 class="text-lg font-display font-bold uppercase mb-3 tracking-wide">Power Washing</h3>
              <p class="text-gray-600 text-sm mb-4">
                Soft wash and pressure washing for driveways, stucco, roofs, and pool decks around Kissimmee.
              </p>
              <a href="/services/power-washing-kissimmee" class="text-gopro-orange hover:underline font-semibold text-sm">Power washing in Kissimmee →</a>
            </div>
          </div>
          <p class="text-center">
            <a href="/services" class="text-gray-700 hover:text-gopro-orange transition-colors font-semibold">View all our services →</a>
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">How We Work</h2>
          <ol class="space-y-3 list-decimal list-inside text-gray-700 font-sans">
            <li><strong>Free estimate</strong> — Tell us the job. We look at the house, then we price it.</li>
            <li><strong>Prep</strong> — Wash, scrape, patch drywall or stucco, caulk, mask, and prime as needed.</li>
            <li><strong>Work</strong> — Complete the painting, repair, wash, or theater build on schedule.</li>
            <li><strong>Walkthrough</strong> — You walk the job with us before it's called done.</li>
          </ol>
          <p class="mt-6 font-sans"><a href="/estimate" class="text-gopro-orange hover:underline font-semibold">Request a free estimate →</a></p>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h2 class="text-xl font-display font-bold uppercase mb-3 tracking-wide">Service Area</h2>
          <p class="text-gray-700 mb-3">
            We work throughout Kissimmee, including Buenaventura Lakes, Old Town, Celebration, Poinciana, and the vacation rental areas near the 192 corridor. Nearby cities we also serve: <a href="/areas/orlando" class="text-gopro-orange hover:underline">Orlando</a>, <a href="/areas/st-cloud" class="text-gopro-orange hover:underline">St. Cloud</a>, <a href="/areas/celebration" class="text-gopro-orange hover:underline">Celebration</a>, and <a href="/areas/poinciana" class="text-gopro-orange hover:underline">Poinciana</a>.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-display font-black uppercase mb-8 tracking-tight">Common Questions</h2>
          <div class="space-y-6">
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">What home improvement services do you offer in Kissimmee?</h3>
              <p class="text-gray-700 font-sans">
                Painting, <a href="/services/drywall-repair-kissimmee" class="text-gopro-orange hover:underline">drywall repair</a>, power washing, home theaters, trim, wallpaper, murals, TV mounting, and demolition. Each has a Kissimmee service page with details.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Are you based in Kissimmee?</h3>
              <p class="text-gray-700 font-sans">
                Yes. We are owner-operated and based in Kissimmee, Osceola County, serving nearby Central Florida since 2014.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">How do I get a free estimate?</h3>
              <p class="text-gray-700 font-sans">
                <a href="/estimate" class="text-gopro-orange hover:underline">Request an estimate online</a> or call (407) 244-6873. We look at the job, then price it. The estimate is free.
              </p>
            </div>
            <div class="bg-white border-l-4 border-gopro-orange p-6">
              <h3 class="text-xl font-display font-bold uppercase mb-2 tracking-wide">Do you work on Kissimmee vacation rentals?</h3>
              <p class="text-gray-700 font-sans">
                Yes. We paint, repair drywall, and refresh interiors for short-term rentals near the parks corridor, scheduled around guest turnovers when needed.
              </p>
            </div>
          </div>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6">
            Ready to get started on your Kissimmee home improvement project?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/estimate" class="btn-primary">
              Get Free Estimate
            </a>
            <a href="tel:4072446873" class="btn-secondary">
              Call (407) 244-6873
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Home Improvement in Kissimmee"
    description="Owner-operated since 2014. Painting, drywall, power washing, and more. Free estimates."
  />

  <Footer />
</BaseLayout>
