---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Kissimmee Home Improvement | Painting, Theaters, Drywall | Go Pro"
  description="Owner-operated painting, home theaters, and drywall in Kissimmee, FL. Free estimates. Call (407) 244-6873."
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HomeAndConstructionBusiness",
        "@id": "https://goprohomeimprovements.com/#business",
        "name": "Go Pro Home Improvements",
        "url": "https://goprohomeimprovements.com",
        "telephone": "(407) 244-6873",
        "email": "gopro4good@gmail.com",
        "image": "https://goprohomeimprovements.com/images/logo.png",
        "logo": {
          "@type": "ImageObject",
          "url": "https://goprohomeimprovements.com/images/logo.png"
        },
        "priceRange": "$$",
        "areaServed": [
          { "@type": "City", "name": "Kissimmee", "containedIn": "Florida" }
        ],
        "knowsAbout": [
          "Power Washing",
          "Interior Painting",
          "Exterior Painting",
          "Trim Installation",
          "Crown Molding",
          "Home Theater Installation",
          "Drywall Repair"
        ],
        "sameAs": [
          "https://www.instagram.com/gopro4good/"
        ]
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://goprohomeimprovements.com/areas/kissimmee/#breadcrumbs",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://goprohomeimprovements.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Service Areas",
            "item": "https://goprohomeimprovements.com/areas"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Kissimmee",
            "item": "https://goprohomeimprovements.com/areas/kissimmee"
          }
        ]
      }
    ]
  }}
>
  <Header />

  <section class="bg-gopro-charcoal text-white py-16 border-b-4 border-gopro-orange">
    <div class="container-custom">
      <nav class="text-sm mb-6 font-sans">
        <a href="/" class="text-gray-400 hover:text-gopro-orange transition-colors">Home</a>
        <span class="mx-2 text-gray-500">/</span>
        <a href="/areas" class="text-gray-400 hover:text-gopro-orange transition-colors">Service Areas</a>
        <span class="mx-2 text-gray-500">/</span>
        <span class="text-white">Kissimmee</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-display font-black uppercase mb-4 tracking-tight">Home improvement in Kissimmee</h1>
      <p class="text-xl text-gray-300 max-w-3xl font-sans">
        Owner-operated contractor based right here in Kissimmee. 15+ years serving Osceola County homes with painting, power washing, home theaters & more.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            Go Pro Home Improvements is proud to call Kissimmee home. Based right here in Osceola County, we've been serving our neighbors with reliable, professional home improvement services for over 15 years. From Buenaventura Lakes to Old Town, Poinciana Boulevard to the vacation rental corridors near the Disney area, we know the neighborhoods and the unique needs of Kissimmee homeowners.
          </p>
          <p class="text-lg text-gray-600 mb-8">
            As a local, owner-operated business, we understand Kissimmee homes—from the humid Florida climate that demands quality exterior prep to the vacation rental market's need for fast, reliable turnarounds. Whether you own a single-family home in one of Osceola County's growing neighborhoods or manage a rental property near the 192 corridor, we bring the same owner-operated care and 15+ years of experience to every job.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-8 mb-12">
          <h2 class="text-2xl font-display font-bold uppercase mb-6 tracking-wide">Our Services in Kissimmee</h2>
          <p class="text-gray-700 mb-6">
            We specialize in three core services that homeowners and property managers in Kissimmee trust us for:
          </p>
          <div class="grid md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-6 rounded-lg border-l-4 border-gopro-orange">
              <h3 class="text-lg font-display font-bold uppercase mb-3 tracking-wide">Interior & Exterior Painting</h3>
              <p class="text-gray-600 text-sm mb-4">
                From vacation rental refreshes to full exterior repaints that stand up to Florida sun and humidity. We prep right and use quality paint.
              </p>
              <a href="/services/interior-exterior-painting" class="text-gopro-orange hover:underline font-semibold text-sm">Learn more →</a>
            </div>
            <div class="bg-white p-6 rounded-lg border-l-4 border-gopro-orange">
              <h3 class="text-lg font-display font-bold uppercase mb-3 tracking-wide">Home Theater Installation</h3>
              <p class="text-gray-600 text-sm mb-4">
                Full custom home theater builds—paint, trim, acoustic panels, AV coordination, and themed rooms. From bonus rooms to dedicated theaters.
              </p>
              <a href="/services/movie-rooms" class="text-gopro-orange hover:underline font-semibold text-sm">Learn more →</a>
            </div>
            <div class="bg-white p-6 rounded-lg border-l-4 border-gopro-orange">
              <h3 class="text-lg font-display font-bold uppercase mb-3 tracking-wide">Drywall Repair & Installation</h3>
              <p class="text-gray-600 text-sm mb-4">
                Water damage repair, texture matching, full room drywall, and invisible patches. We handle drying times and Florida humidity right.
              </p>
              <a href="/services/drywall" class="text-gopro-orange hover:underline font-semibold text-sm">Learn more →</a>
            </div>
          </div>
          <p class="text-center">
            <a href="/services" class="text-gray-700 hover:text-gopro-orange transition-colors font-semibold">View all our services →</a>
          </p>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h3 class="text-xl font-display font-bold uppercase mb-3 tracking-wide">Local Knowledge, Professional Results</h3>
          <p class="text-gray-700">
            Being based in Kissimmee means we're never far away. We know the neighborhoods, we understand local building practices, and we're invested in our community's success. When you hire Go Pro, you're hiring neighbors who care about the quality of their work because our reputation lives here.
          </p>
        </div>

        <div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 mb-12">
          <h3 class="text-xl font-display font-bold uppercase mb-3 tracking-wide">Serving Kissimmee & Osceola County Neighborhoods</h3>
          <p class="text-gray-700 mb-3">
            We work throughout Kissimmee, including Buenaventura Lakes, Poinciana, Old Town, Celebration, and the vacation rental areas near the 192 corridor and Disney. As an owner-operated contractor based right here in Osceola County, we're never far away—and we understand the local market, building practices, and climate challenges.
          </p>
        </div>

        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6">
            Ready to get started on your Kissimmee home improvement project?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/estimate" class="btn-primary">
              Get Free Estimate
            </a>
            <a href="tel:4072446873" class="btn-secondary">
              Call (407) 244-6873
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />

  <Footer />
</BaseLayout>
