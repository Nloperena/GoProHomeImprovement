---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Service Areas in Central Florida | Go Pro"
  description="Go Pro serves Kissimmee, Orlando, St. Cloud, Celebration, Poinciana & Central Florida with owner-operated home improvement. 15+ years of quality work."
>
  <Header />

  <section class="bg-gopro-charcoal text-white py-16 border-b-4 border-gopro-orange">
    <div class="container-custom text-center">
      <h1 class="text-4xl md:text-5xl font-display font-black uppercase mb-4 tracking-tight">Where We Work</h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto font-sans">
        Based in Kissimmee, serving Central Florida with owner-operated home improvement.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto mb-16">
        <p class="text-xl text-gray-700 text-center leading-relaxed mb-6 font-sans">
          Based in Kissimmee, Go Pro Home Improvements serves homeowners throughout Central Florida. 15+ years of local experience, owner-operated quality.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        <a href="/areas/kissimmee" class="group bg-white border-2 border-gray-200 hover:border-gopro-orange rounded-lg p-8 transition-all hover:shadow-xl">
          <h2 class="text-2xl font-display font-bold uppercase mb-4 group-hover:text-gopro-orange transition-colors tracking-wide">
            Kissimmee
          </h2>
          <p class="text-gray-600 mb-4 font-sans">
            Our home base. Owner-operated contractor serving Kissimmee & Osceola County.
          </p>
          <span class="text-gopro-orange font-display font-semibold uppercase text-sm group-hover:underline inline-flex items-center tracking-wide">
            View Details
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>

        <a href="/areas/orlando" class="group bg-white border-2 border-gray-200 hover:border-gopro-orange rounded-lg p-8 transition-all hover:shadow-xl">
          <h2 class="text-2xl font-display font-bold uppercase mb-4 group-hover:text-gopro-orange transition-colors tracking-wide">
            Orlando
          </h2>
          <p class="text-gray-600 mb-4 font-sans">
            Painting, power washing, remodeling & more throughout Orlando & Orange County.
          </p>
          <span class="text-gopro-orange font-display font-semibold uppercase text-sm group-hover:underline inline-flex items-center tracking-wide">
            View Details
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>

        <a href="/areas/st-cloud" class="group bg-white border-2 border-gray-200 hover:border-gopro-orange rounded-lg p-8 transition-all hover:shadow-xl">
          <h2 class="text-2xl font-display font-bold uppercase mb-4 group-hover:text-gopro-orange transition-colors tracking-wide">
            St. Cloud
          </h2>
          <p class="text-gray-600 mb-4 font-sans">
            Serving St. Cloud homes and rental properties with quality interior & exterior work.
          </p>
          <span class="text-gopro-orange font-display font-semibold uppercase text-sm group-hover:underline inline-flex items-center tracking-wide">
            View Details
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>

        <a href="/areas/celebration" class="group bg-white border-2 border-gray-200 hover:border-gopro-orange rounded-lg p-8 transition-all hover:shadow-xl">
          <h2 class="text-2xl font-display font-bold uppercase mb-4 group-hover:text-gopro-orange transition-colors tracking-wide">
            Celebration
          </h2>
          <p class="text-gray-600 mb-4 font-sans">
            Painting, trim work, murals & upgrades for Celebration's master-planned homes.
          </p>
          <span class="text-gopro-orange font-display font-semibold uppercase text-sm group-hover:underline inline-flex items-center tracking-wide">
            View Details
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>

        <a href="/areas/poinciana" class="group bg-white border-2 border-gray-200 hover:border-gopro-orange rounded-lg p-8 transition-all hover:shadow-xl">
          <h2 class="text-2xl font-display font-bold uppercase mb-4 group-hover:text-gopro-orange transition-colors tracking-wide">
            Poinciana
          </h2>
          <p class="text-gray-600 mb-4 font-sans">
            Painting, power washing, home theaters & repairs in Poinciana's growing subdivisions.
          </p>
          <span class="text-gopro-orange font-display font-semibold uppercase text-sm group-hover:underline inline-flex items-center tracking-wide">
            View Details
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>

        <a href="/areas/central-florida" class="group bg-white border-2 border-gray-200 hover:border-gopro-orange rounded-lg p-8 transition-all hover:shadow-xl">
          <h2 class="text-2xl font-display font-bold uppercase mb-4 group-hover:text-gopro-orange transition-colors tracking-wide">
            Central Florida
          </h2>
          <p class="text-gray-600 mb-4 font-sans">
            Osceola, Orange & Polk counties. Call to confirm service in your area.
          </p>
          <span class="text-gopro-orange font-display font-semibold uppercase text-sm group-hover:underline inline-flex items-center tracking-wide">
            View Details
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>
      </div>

      <div class="bg-gray-50 rounded-lg p-8 text-center">
        <h2 class="text-2xl font-display font-bold uppercase mb-4 tracking-wide">Not Listed?</h2>
        <p class="text-gray-600 mb-6 max-w-2xl mx-auto font-sans">
          If you're in Central Florida and need home improvement, call us. We'll let you know if we can help.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:4072446873" class="btn-secondary">
            Call (407) 244-6873
          </a>
          <a href="/estimate" class="btn-primary">
            Request Estimate
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTASection />

  <Footer />
</BaseLayout>
