        "publisher": {
          "@type": "Organization",
          "name": "GO PRO HOME IMPROVEMENTS INC.",
          "logo": {
            "@type": "ImageObject",
            "url": "https://goprohomeimprovements.com/images/logo.png"
          }
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://goprohomeimprovements.com/guides/stucco-and-humidity-central-florida/#breadcrumbs",
        "itemListElement": [
          {
