  },
  {
    href: '/guides/cabinet-painting-vs-replacement-kissimmee',
    title: 'Cabinet Painting vs Replacement in Kissimmee',
    description: 'Cost comparison, durability, and when each option makes sense for Central Florida kitchens.',
    icon: '🚪'
  },
  {
    href: '/guides/roof-black-streaks-osceola',
    title: 'Roof Black Streaks in Osceola County',
    description: 'What causes black streaks and how soft washing removes them safely without damaging shingles or tile.',
