---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';

const guides = [
  {
    href: '/guides/power-washing-before-painting-florida',
    title: 'Power Washing Before Painting in Florida',
    description: 'Why Central Florida exteriors need a thorough wash and dry time before paint. Sun, mildew, and stucco prep explained.',
    icon: '🏠'
  },
  {
    href: '/guides/kissimmee-vacation-rental-refresh',
    title: 'Kissimmee Vacation Rental Refresh Guide',
    description: 'Paint, trim, TV mounting, and murals for short-term rentals near Disney. What a refresh actually includes.',
    icon: '🏖️'
  },
  {
    href: '/guides/tv-mounting-vs-home-theater',
    title: 'TV Mounting vs. Full Home Theater',
    description: 'When a simple wall mount is enough versus building a dedicated theater room. Budget and space considerations.',
    icon: '📺'
  },
  {
    href: '/guides/how-much-does-painting-cost-kissimmee',
    title: 'How Much Does Painting Cost in Kissimmee?',
    description: 'Honest ranges for interior and exterior painting. What drives price, what to expect, and how to get an accurate estimate.',
    icon: '🎨'
  },
  {
    href: '/guides/choosing-a-home-improvement-contractor-kissimmee',
    title: 'Choosing a Home Improvement Contractor in Kissimmee',
    description: 'Owner-operated vs. franchise. Questions to ask, red flags to avoid, and what matters when hiring for your home.',
    icon: '🔨'
  },
  {
    href: '/guides/stucco-and-humidity-central-florida',
    title: 'Stucco & Humidity in Central Florida',
    description: 'How humidity affects stucco homes. Mildew, cracking, paint failure, and proper maintenance in Central Florida.',
    icon: '🏘️'
  },
  {
    href: '/guides/hiding-tv-wires-without-cutting-drywall',
    title: 'Hiding TV Wires Without Cutting Drywall',
    description: 'Clean wire-hiding options. Cable channels, raceways, and when in-wall wiring is worth the investment.',
    icon: '📱'
  },
  {
    href: '/guides/kids-room-mural-ideas-kissimmee',
    title: 'Kids\' Room Mural Ideas for Kissimmee',
    description: 'Popular mural themes near Disney. Star Wars, Harry Potter, space, and ideas that grow with your child.',
    icon: '🎨'
  },
  {
    href: '/guides/hoa-and-exterior-paint-osceola',
    title: 'HOA & Exterior Paint in Osceola County',
    description: 'HOA approval process, color restrictions, and avoiding violations in Kissimmee and Central Florida communities.',
    icon: '🏡'
  },
  {
    href: '/guides/pressure-washing-cost-kissimmee',
    title: 'How Much Does Pressure Washing Cost in Kissimmee?',
    description: 'Real cost ranges for driveways, houses, pool decks, and patios. What drives price in Central Florida.',
    icon: '💧'
  },
  {
    href: '/guides/soft-wash-vs-pressure-wash-kissimmee',
    title: 'Soft Wash vs Pressure Wash for Kissimmee Stucco & Roofs',
    description: 'When to use soft wash vs pressure wash on stucco, roofs, and painted surfaces. Protect your home from damage.',
    icon: '🏠'
  },
  {
    href: '/guides/fireplace-tv-mounting-orlando',
    title: 'Fireplace TV Mounting in Orlando & Kissimmee',
    description: 'Heat management, viewing height, wire concealment, and when mounting above the fireplace makes sense.',
    icon: '🔥'
  },
  {
    href: '/guides/tv-mounting-cost-orlando',
