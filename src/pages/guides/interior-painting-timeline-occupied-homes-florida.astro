        },
        "publisher": {
          "@type": "Organization",
          "name": "GO PRO HOME IMPROVEMENTS INC.",
          "logo": {
            "@type": "ImageObject",
            "url": "https://goprohomeimprovements.com/images/logo.png"
          }
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://goprohomeimprovements.com/guides/interior-painting-timeline-occupied-homes-florida/#breadcrumbs",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
