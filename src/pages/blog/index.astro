---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { defaultTitle } from '../../lib/seo';
import { Image } from 'astro:assets';

const posts = await getCollection('posts');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = defaultTitle('Blog & Resources');
const description = 'Expert tips, cost guides, and advice for home improvement projects in Central Florida.';
---

<Base title={title} description={description} path="/blog/">
	<section class="bg-cream/40 px-4 py-16 md:px-6 md:py-24 lg:px-8 border-b border-line">
		<div class="mx-auto max-w-content text-center">
			<h1 class="font-display text-4xl font-semibold text-ink md:text-5xl">Home Improvement Blog</h1>
			<p class="mt-4 text-lg text-slate max-w-2xl mx-auto">
				Expert guides, pricing insight, and tips for maintaining and upgrading your Florida home.
			</p>
		</div>
	</section>

	<section class="px-4 py-16 md:px-6 md:py-24 lg:px-8">
		<div class="mx-auto max-w-content">
			{posts.length > 0 ? (
				<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
					{posts.map((post) => (
						<article class="group flex flex-col overflow-hidden rounded-sm border border-line bg-paper transition-shadow hover:border-orange/50 hover:shadow-sm">
							<a href={`/blog/${post.id}/`} class="relative aspect-video overflow-hidden bg-cream block">
								<Image
									src={post.data.heroImage}
									alt={post.data.title}
									width={600}
									height={338}
									class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
								/>
							</a>
							<div class="flex flex-1 flex-col p-5">
								<time class="text-xs font-medium uppercase tracking-wide text-slate mb-2">
									{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
								</time>
								<h2 class="font-display text-xl font-semibold text-ink group-hover:text-orange">
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h2>
								<p class="mt-3 flex-1 text-sm leading-relaxed text-slate">
									{post.data.excerpt}
								</p>
								<div class="mt-5">
									<a href={`/blog/${post.id}/`} class="font-semibold text-orange text-sm inline-flex items-center">
										Read article <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
									</a>
								</div>
							</div>
						</article>
					))}
				</div>
			) : (
				<div class="text-center py-20 bg-cream rounded-sm border border-line">
					<p class="text-slate text-lg">Blog posts are coming soon.</p>
				</div>
			)}
		</div>
	</section>
</Base>
