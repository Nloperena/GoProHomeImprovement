---
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-900.css';
import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import '@fontsource/outfit/latin-600.css';
import barlow900 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-900-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: object;
  variant?: 'default' | 'home';
}

const { title, description, canonical, ogImage, schema, variant = 'default' } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site);
const defaultOgImage = new URL('/images/trim-navy-wall.jpg', Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : defaultOgImage;

const defaultSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HomeAndConstructionBusiness",
      "@id": "https://goprohomeimprovements.com/#business",
      "name": "Go Pro Home Improvements",
      "legalName": "GO PRO HOME IMPROVEMENTS INC.",
      "url": "https://goprohomeimprovements.com",
      "telephone": "(407) 244-6873",
      "email": "gopro4good@gmail.com",
      "foundingDate": "2014",
      "image": "https://goprohomeimprovements.com/images/logo.png",
      "logo": {
        "@type": "ImageObject",
        "url": "https://goprohomeimprovements.com/images/logo.png"
      },
      "priceRange": "$$",
      "areaServed": [
        { "@type": "City", "name": "Kissimmee" },
        { "@type": "City", "name": "Orlando" },
        { "@type": "City", "name": "St. Cloud" },
        { "@type": "City", "name": "Celebration" },
        { "@type": "City", "name": "Poinciana" },
        { "@type": "City", "name": "Davenport" },
        { "@type": "AdministrativeArea", "name": "Osceola County" },
        { "@type": "AdministrativeArea", "name": "Orange County" }
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "07:00",
          "closes": "17:00"
        }
      ],
      "knowsAbout": [
        "Power Washing",
        "Interior Painting",
        "Exterior Painting",
        "Demolition",
        "Trim Installation",
        "Crown Molding",
        "Wallpaper Installation",
        "Custom Murals",
        "TV Mounting",
        "Home Theater Installation",
        "Drywall Installation",
        "Drywall Repair"
      ],
      "sameAs": [
        "https://www.instagram.com/gopro4good/",
        "https://share.google/mxf7aR650uFCQUTab",
        "https://www.google.com/maps?cid=11832173553199565594"
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>
  <meta name="robots" content="index, follow">
  
  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageURL}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="Go Pro Home Improvements">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageURL}>
  
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="preload" as="font" type="font/woff2" href={barlow900} crossorigin />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta name="theme-color" content="#0F0F0F" />
  {variant === 'home' && (
    <>
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset="/images/generated/hero-480.avif 480w, /images/generated/hero-768.avif 768w, /images/generated/hero-960.avif 960w, /images/generated/hero-1280.avif 1280w"
        imagesizes="100vw"
        fetchpriority="high"
      />
    </>
  )}
  
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(schema || defaultSchema)} />
</head>
<body class={variant === 'home' ? 'home' : undefined}>
  <slot />
</body>
</html>
