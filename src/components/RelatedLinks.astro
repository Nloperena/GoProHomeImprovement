---
import { relatedLinks } from '../lib/seo/links';

const groups = relatedLinks(Astro.url.pathname);
---

{groups.length > 0 && (
  <nav aria-label="Related pages" class="bg-gray-50 border-t border-gray-200">
    <div class="container-custom py-10 space-y-8">
      {groups.map((group) => (
        <div>
          <p class="font-display font-bold uppercase tracking-wide text-lg mb-3">{group.heading}</p>
          <ul class="flex flex-wrap gap-x-6 gap-y-2">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="text-gopro-orange hover:underline font-semibold">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </nav>
)}
