---
const steps = [
  {
    num: '01',
    title: 'The owner answers',
    text: 'Call and you get Mike. Monday through Friday, 7 AM to 5 PM.',
  },
  {
    num: '02',
    title: 'A written quote',
    text: 'He walks the job and sends a written quote. Free.',
  },
  {
    num: '03',
    title: 'Mask, spray, pull',
    text: 'Prep, then the sprayed finish. The tape comes off clean.',
  },
];
---

<section class="process" aria-labelledby="process-title">
  <p class="kicker">How a job goes</p>
  <h2 id="process-title">Three <em>moves.</em></h2>
  <ol class="steps">
    {steps.map((step) => (
      <li>
        <p class="num">{step.num}</p>
        <h3>{step.title}</h3>
        <p>
          {step.num === '01' ? (
            <>
              Call <a href="tel:4072446873">(407) 244-6873</a> and you get Mike. Monday through Friday, 7 AM to 5 PM.
            </>
          ) : (
            step.text
          )}
        </p>
      </li>
    ))}
  </ol>
</section>
