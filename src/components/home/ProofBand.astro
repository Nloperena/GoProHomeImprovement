---
import { GOOGLE_REVIEWS_URL } from '../../data/reviews';
---

<section class="proof" aria-label="5.0 on Google, 12 years since 2014, workmanship satisfaction guarantee, Monday through Friday 7 to 5">
  <ul>
    <li class="reveal">
      <a href={GOOGLE_REVIEWS_URL} rel="noopener noreferrer">
        <strong data-count="5" data-decimals="1">5.0</strong>
        <span>on Google</span>
      </a>
    </li>
    <li class="reveal">
      <strong data-count="12">12</strong>
      <span>years since 2014</span>
    </li>
    <li class="reveal">
      <strong>Satisfaction</strong>
      <span>guarantee</span>
    </li>
    <li class="reveal">
      <strong>M-F</strong>
      <span>7-5</span>
    </li>
  </ul>
</section>
