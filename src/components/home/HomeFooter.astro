---
import { areas, company, services } from '../../data/home';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <a class="footer-phone" href="tel:4072446873">(407) 244-6873</a>
  <a class="footer-mail" href="mailto:gopro4good@gmail.com">gopro4good@gmail.com</a>
  <div class="footer-grid">
    <div>
      <h2>Services</h2>
      <ul>
        {services.map((service) => (
          <li><a href={service.href}>{service.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2>Areas</h2>
      <ul>
        {areas.map((area) => (
          <li><a href={area.href}>{area.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2>Company</h2>
      <ul>
        {company.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li>
          <a href="https://www.instagram.com/gopro4good/" rel="noopener noreferrer">Instagram</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="footer-base">
    <p>Go Pro Home Improvements · Florida corporation, established 2014 · Kissimmee</p>
    <p>Monday–Friday, 7 AM–5 PM · Workmanship satisfaction guarantee</p>
    <p>© {year} Go Pro Home Improvements</p>
  </div>
</footer>
<div class="mobile-bar">
  <a href="tel:4072446873">Call Mike</a>
  <a href="#estimate">Estimate</a>
</div>
