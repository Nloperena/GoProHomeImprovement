---
import { services } from '../../data/home';
---

<section class="section" aria-labelledby="deck-title">
  <div class="section-head">
    <p class="kicker">The fan deck</p>
    <h2 id="deck-title">Nine lines of <em>work.</em></h2>
    <p class="lede">
      Slide the chips. Each one is a service Mike does, with a photograph from the work.
    </p>
  </div>
  <ul class="deck">
    {services.map((service) => (
      <li class="swatch">
        <a href={service.href}>
          <span class="swatch-chip" style={`--swatch:${service.swatch}`} aria-hidden="true"></span>
          <img
            src={service.image}
            width={service.width}
            height={service.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <span class="swatch-meta">
            <span>{service.num}</span>
            <strong>{service.name}</strong>
          </span>
          <span class="sr-only">{service.text}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
