---
import GeneratedImage from './GeneratedImage.astro';
---

<section class="band wash" aria-labelledby="wash-title">
  <div class="band-head">
    <p class="kicker">Before the paint</p>
    <h2 id="wash-title">Pressure Washing Driveways, Pavers &amp; Stucco Before Painting</h2>
    <p>Florida film, mildew, and loose paint come off the surface before a coat goes on.</p>
  </div>
  <div class="wash-frame">
    <GeneratedImage
      name="powerwash"
      widths={[480, 768, 1280]}
      width={1280}
      height={720}
      sizes="100vw"
      alt="Pressure washer cleaning pavers in front of a stucco house"
    />
    <div class="wash-wipe" data-wipe aria-hidden="true"></div>
  </div>
</section>
