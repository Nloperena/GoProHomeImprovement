---
import GeneratedImage from './GeneratedImage.astro';

const cities = [
  { href: '/areas/kissimmee', label: 'Kissimmee' },
  { href: '/areas/st-cloud', label: 'St. Cloud' },
  { href: '/areas/celebration', label: 'Celebration' },
  { href: '/areas/poinciana', label: 'Poinciana' },
  { href: '/areas/orlando', label: 'Orlando' },
];
---

<section class="areas" aria-labelledby="areas-title">
  <div class="areas-media">
    <GeneratedImage
      name="areas"
      widths={[640, 960, 1280]}
      width={1280}
      height={720}
      sizes="(max-width: 959px) 100vw, 50vw"
      alt="Aerial view of a Central Florida neighborhood of houses, lakes, and trees at sunset"
    />
  </div>
  <div class="areas-copy">
    <p class="kicker">Where</p>
    <h2 id="areas-title">Service Areas: Kissimmee, St. Cloud, Celebration, Poinciana, and Orlando</h2>
    <ul class="city-chips">
      {cities.map((city) => (
        <li><a class="wipe" href={city.href}>{city.label}</a></li>
      ))}
    </ul>
    <h3>Workmanship satisfaction guarantee</h3>
    <p>
      The sprayed finish, the trim, the repair — the job stands behind that promise. Go Pro Home Improvements, Kissimmee. Established 2014.
    </p>
  </div>
</section>
