---
import GeneratedImage from './GeneratedImage.astro';
---

<section class="band split" aria-labelledby="exterior-title">
  <div class="split-copy">
    <p class="kicker">Exterior</p>
    <h2 id="exterior-title">Exterior House Painting &amp; Stucco Repair in Kissimmee</h2>
    <p>
      An illustrative example of cracked, stained stucco next to a sprayed finish — not a real job photo. Drag the handle, or focus it and use the arrow keys.
    </p>
  </div>
  <div class="compare-frame" data-compare style="--pos: 54%">
    <GeneratedImage
      name="before"
      widths={[480, 640]}
      width={640}
      height={720}
      sizes="(max-width: 900px) 100vw, 36rem"
      alt="Illustrative example of a cracked and stained stucco wall beside a dark window, not a real job photo"
    />
    <div class="compare-after">
      <GeneratedImage
        name="after"
        widths={[480, 640]}
        width={640}
        height={720}
        sizes="(max-width: 900px) 100vw, 36rem"
        alt="Illustrative example of the same stucco wall with a smooth white painted finish, not a real job photo"
      />
    </div>
    <span class="compare-tag compare-tag-before">Before</span>
    <span class="compare-tag compare-tag-after">After</span>
    <p class="compare-note">Example illustration</p>
    <span class="compare-handle" aria-hidden="true"></span>
    <input
      class="compare-range"
      type="range"
      min="0"
      max="100"
      value="54"
      aria-label="Compare an illustrative before-and-after example of stucco painting, not a real job"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="54"
      aria-valuetext="54% of the illustrative after example"
    />
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-compare]').forEach(function (frame) {
    var input = frame.querySelector('.compare-range');
    if (!input) return;

    var sync = function () {
      var value = input.value;
      frame.style.setProperty('--pos', value + '%');
      input.setAttribute('aria-valuenow', value);
      input.setAttribute('aria-valuetext', value + '% of the illustrative after example');
    };

    input.addEventListener('input', sync);
    input.addEventListener('change', sync);
    sync();
  });
</script>
