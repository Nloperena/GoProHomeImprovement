---
const serviceOptions = [
  ['interior-exterior-painting', 'Painting (interior & exterior)'],
  ['movie-rooms', 'Movie room'],
  ['drywall', 'Drywall'],
  ['power-washing', 'Power washing'],
  ['trim-crown-molding', 'Trim & crown molding'],
  ['murals', 'Mural'],
  ['tv-mounting', 'TV mounting'],
  ['wallpaper', 'Wallpaper'],
  ['demolition', 'Demolition'],
  ['other', 'Something else'],
];
---

<section class="ticket" id="estimate" aria-labelledby="ticket-title">
  <div class="ticket-copy">
    <p class="kicker">03 — The price</p>
    <h2 id="ticket-title">The price, in <em>writing.</em></h2>
    <p class="lede">
      Tell Mike the room, the rough size, and what you want done. He calls you back.
      Monday through Friday, 7 AM to 5 PM. Free.
    </p>
  </div>
  <div>
    <form id="estimate-form" class="ticket-form" novalidate>
      <p class="tape-label">Free estimate</p>
      <p class="display ticket-lead">Tell Mike the job.</p>
      <div class="fields">
        <label>
          Full name <span class="req">*</span>
          <input id="ticket-name" name="name" type="text" autocomplete="name" required maxlength="80" />
        </label>
        <label>
          Phone <span class="req">*</span>
          <input id="ticket-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="(407) 555-0100" />
        </label>
        <label>
          Email <span class="req">*</span>
          <input id="ticket-email" name="email" type="email" autocomplete="email" inputmode="email" required />
        </label>
        <label>
          Service <span class="req">*</span>
          <select id="ticket-service" name="service" required>
            <option value="">Select a service</option>
            {serviceOptions.map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
        </label>
        <label>
          City <span class="req">*</span>
          <input id="ticket-city" name="city" type="text" autocomplete="address-level2" required maxlength="60" />
        </label>
        <label>
          What needs doing? <span class="req">*</span>
          <textarea id="ticket-message" name="message" required rows="5" placeholder="Room, rough size, and what you want done."></textarea>
        </label>
      </div>
      <div class="hp" aria-hidden="true">
        <label>
          Website
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <p class="ticket-note">You can also text photos to <a href="tel:4072446873">(407) 244-6873</a>.</p>
      <button class="btn-deep" type="submit">Request the estimate</button>
    </form>
    <div id="form-success" class="ticket-success" hidden>
      <h2 tabindex="-1">It’s in.</h2>
      <p>Mike has the request and will call you about the job.</p>
      <p>If you’d rather not wait: <a href="tel:4072446873">(407) 244-6873</a>.</p>
    </div>
    <p id="form-error" class="ticket-error" hidden role="alert"></p>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#estimate-form');
  const success = document.querySelector<HTMLElement>('#form-success');
  const errorBox = document.querySelector<HTMLElement>('#form-error');
  const started = Date.now();
  let token = '';

  async function loadToken() {
    const response = await fetch('/api/form-token', { headers: { Accept: 'application/json' } });
    if (!response.ok) throw new Error('token');
    const payload = await response.json();
    token = payload.token || '';
  }

  loadToken().catch(() => {
    token = '';
  });

  function showError(message: string) {
    if (!errorBox) return;
    errorBox.hidden = false;
    errorBox.textContent = message;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !success || !errorBox) return;
    errorBox.hidden = true;

    if (!form.reportValidity()) return;

    if (!token) {
      try {
        await loadToken();
      } catch {
        showError('The form could not start. Call (407) 244-6873 and Mike will take it from there.');
        return;
      }
    }

    if (Date.now() - started < 2600) {
      showError('Give it a second, then send it again.');
      return;
    }

    const data = Object.fromEntries(new FormData(form));
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;

    try {
      const response = await fetch('/api/estimate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...data, formToken: token, formStartedAt: started, website: data.website || '' }),
      });

      if (response.ok) {
        form.hidden = true;
        success.hidden = false;
        success.querySelector('h2')?.focus();
        return;
      }

      let message = 'Something went wrong. Call (407) 244-6873 and Mike will take the job details.';
      try {
        const payload = await response.json();
        if (typeof payload.error === 'string' && payload.error.length < 240) {
          message = payload.error;
        }
      } catch {
        /* keep the spoken fallback */
      }
      showError(message);
    } catch {
      showError('Something went wrong. Call (407) 244-6873 and Mike will take the job details.');
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
