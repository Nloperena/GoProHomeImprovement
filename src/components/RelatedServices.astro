---
interface Props {
  services: Array<{
    name: string;
    url: string;
  }>;
  includeEstimate?: boolean;
}

const { services, includeEstimate = true } = Astro.props;
---

<div class="bg-gopro-orange/10 border-l-4 border-gopro-orange p-6 my-12">
  <h3 class="text-xl font-display font-bold uppercase mb-4 tracking-wide">Related Services</h3>
  <div class="space-y-3">
    {services.map(service => (
      <div>
        <a href={service.url} class="text-gopro-orange hover:underline font-semibold text-lg">
          {service.name} →
        </a>
      </div>
    ))}
    {includeEstimate && (
      <div class="mt-4 pt-4 border-t border-gopro-orange/30">
        <a href="/estimate" class="text-gopro-orange hover:underline font-semibold text-lg">
          Get Free Estimate →
        </a>
      </div>
    )}
  </div>
</div>
