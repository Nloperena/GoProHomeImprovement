---
interface Props {
  services: Array<{
    name: string;
    url: string;
  }>;
  includeEstimate?: boolean;
}

const { services, includeEstimate = true } = Astro.props;
---

<aside class="related">
  <h3>Related services</h3>
  {services.map((service) => (
    <a href={service.url}>
      <span>{service.name}</span>
      <span aria-hidden="true">→</span>
    </a>
  ))}
  {includeEstimate && (
    <a href="/estimate">
      <span>Request a free estimate</span>
      <span aria-hidden="true">→</span>
    </a>
  )}
</aside>
