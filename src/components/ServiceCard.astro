---
import { Image } from 'astro:assets';

type Props = {
	title: string;
	slug: string;
	excerpt: string;
	image: string;
	imageAlt?: string;
};

const { title, slug, excerpt, image, imageAlt = title } = Astro.props;
---

<a
	href={`/services/${slug}/`}
	class="group flex flex-col overflow-hidden rounded-sm border border-line bg-paper transition-shadow hover:border-orange/50 hover:shadow-sm"
>
	<div class="relative aspect-video overflow-hidden bg-cream">
		<Image
			src={image}
			alt={imageAlt}
			width={600}
			height={338}
			class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
		/>
	</div>
	<div class="flex flex-1 flex-col p-5">
		<h3 class="font-display text-xl font-semibold text-ink group-hover:text-orange">
			{title}
		</h3>
		<p class="mt-2 flex-1 text-sm leading-relaxed text-slate">
			{excerpt}
		</p>
		<div class="mt-4 flex items-center font-semibold text-orange text-sm">
			Learn more <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
		</div>
	</div>
</a>
