---
import { absoluteUrl } from '../lib/seo';

type Crumb = {
	label: string;
	href?: string;
};

type Props = {
	crumbs: Crumb[];
};

const { crumbs } = Astro.props;

// Build schema
const breadcrumbItems = [
	{ label: 'Home', href: '/' },
	...crumbs,
].map((crumb, index) => {
	const url = crumb.href ? absoluteUrl(crumb.href, Astro.site) : Astro.url.href;
	return {
		'@type': 'ListItem',
		position: index + 1,
		name: crumb.label,
		item: url,
	};
});

const schema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: breadcrumbItems,
};
---

<nav aria-label="Breadcrumb" class="py-4">
	<ol class="flex flex-wrap items-center space-x-2 text-sm text-slate">
		<li>
			<a href="/" class="hover:text-ink hover:underline">Home</a>
		</li>
		{crumbs.map((crumb, index) => {
			const isLast = index === crumbs.length - 1;
			return (
				<li class="flex items-center space-x-2">
					<span class="text-line">/</span>
					{isLast || !crumb.href ? (
						<span class="font-medium text-ink" aria-current="page">
							{crumb.label}
						</span>
					) : (
						<a href={crumb.href} class="hover:text-ink hover:underline">
							{crumb.label}
						</a>
					)}
				</li>
			);
		})}
	</ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

