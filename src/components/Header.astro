---
import TrustBar from './TrustBar.astro';

const nav = [
	{ href: '/services/', label: 'Services' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/service-areas/', label: 'Service areas' },
	{ href: '/about/', label: 'About' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/contact/', label: 'Contact' },
] as const;
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur">
	<div
		class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-3 md:px-6 lg:px-8"
	>
		<a href="/" class="flex items-center">
			<!-- Using the PNG fallback for now; replace with logo-wordmark.svg when available -->
			<img src="/logo.png" alt="Go Pro Home Improvements" class="h-10 w-auto" />
			<span class="sr-only">Go Pro Home Improvements</span>
		</a>
		<nav class="hidden items-center gap-6 text-sm font-medium text-slate md:flex">
			{nav.map((item) => (
				<a
					href={item.href}
					class="transition-colors hover:text-ink"
				>
					{item.label}
				</a>
			))}
		</nav>
		<a
			href="/estimate/"
			class="rounded-sm bg-orange px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-orange-deep"
		>
			Free Estimate
		</a>
	</div>
	<TrustBar />
</header>

<!-- Sticky Mobile CTAs - Dual buttons for Call and Estimate -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 bg-ink shadow-2xl z-40 border-t-2 border-orange" style="padding-bottom: env(safe-area-inset-bottom, 0);">
	<div class="grid grid-cols-2 gap-2 p-2">
		<a href="tel:4072446873" class="bg-orange text-white hover:bg-orange-deep font-display font-bold uppercase py-3 text-center rounded-sm transition-colors text-sm tracking-wide">
			Call (407) 244-6873
		</a>
		<a href="/estimate/" class="bg-paper text-orange hover:bg-cream font-display font-bold uppercase py-3 text-center rounded-sm transition-colors text-sm tracking-wide border-2 border-orange">
			Get Estimate
		</a>
	</div>
</div>

