---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Our Work' },
  { href: '/about', label: 'About' },
  { href: '/areas', label: 'Areas' },
  { href: '/reviews', label: 'Reviews' },
];
---

<header class="bg-white shadow-sm sticky top-0 z-50 border-b-2 border-gopro-orange/20">
  <div class="container-custom">
    <div class="flex items-center justify-between py-3">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <img src="/images/logo.png" alt="Go Pro Home Improvements" class="h-14 md:h-16 w-auto" />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`font-semibold transition-colors ${
              currentPath === item.href || currentPath.startsWith(item.href + '/')
                ? 'text-gopro-orange'
                : 'text-gray-700 hover:text-gopro-orange'
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- CTA Button -->
      <div class="hidden lg:block">
        <a href="/estimate" class="bg-gopro-orange hover:bg-orange-600 text-white font-bold px-6 py-3 rounded-lg transition-colors inline-block">
          Get Free Estimate
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden p-2 text-gray-700 hover:text-gopro-orange"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t">
    <nav class="container-custom py-4 flex flex-col space-y-4">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`font-semibold ${
            currentPath === item.href || currentPath.startsWith(item.href + '/')
              ? 'text-gopro-orange'
              : 'text-gray-700'
          }`}
        >
          {item.label}
        </a>
      ))}
      <a href="/estimate" class="btn-primary text-center">
        Get Free Estimate
      </a>
    </nav>
  </div>
</header>

<!-- Sticky Mobile CTA -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 bg-gradient-to-r from-gopro-orange to-orange-600 shadow-2xl z-40 p-3">
  <a href="tel:4072446873" class="bg-white text-gopro-orange hover:bg-gray-100 font-bold py-4 text-center block rounded-lg transition-colors text-lg shadow-lg">
    Call (407) 244-6873
  </a>
</div>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
