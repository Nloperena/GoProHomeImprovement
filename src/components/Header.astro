---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Our Work' },
  { href: '/about', label: 'About' },
  { href: '/areas', label: 'Areas' },
  { href: '/reviews', label: 'Reviews' },
];

const isCurrent = (href: string) =>
  href === '/'
    ? currentPath === '/'
    : currentPath === href || currentPath.startsWith(href + '/');
---

<header class:list={['site-header', currentPath === '/' && 'is-overlay']}>
  <a class="skip" href="#main">Skip to content</a>
  <div class="container-custom header-bar">
    <a href="/" class="logo-link">
      <img src="/images/logo.png" alt="Go Pro Home Improvements" width="290" height="97" />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <a class="header-phone" href="tel:4072446873">(407) 244-6873</a>
    <a class="btn-primary header-cta" href="/estimate">Free estimate</a>

    <button
      id="mobile-menu-button"
      class="menu-btn"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav class="container-custom" aria-label="Mobile">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <div class="menu-meta">
        <a href="tel:4072446873">(407) 244-6873</a>
        <a href="/estimate">Request a free estimate</a>
      </div>
    </nav>
  </div>
</header>

  <div class="mobile-dock" role="navigation" aria-label="Call or estimate">
  <a class="btn-ghost" href="tel:4072446873">Call (407) 244-6873</a>
  <a class="btn-primary" href="/estimate">Free estimate</a>
</div>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const header = document.querySelector('.site-header');

  document.addEventListener('DOMContentLoaded', () => {
    if (document.getElementById('main')) return;
    let node = document.querySelector('header')?.nextElementSibling ?? null;
    while (node && (node.tagName === 'SCRIPT' || node.classList.contains('mobile-dock'))) {
      node = node.nextElementSibling;
    }
    if (node) node.id = 'main';
  });

  const setOpen = (open: boolean) => {
    if (!mobileMenu || !menuButton) return;
    mobileMenu.hidden = !open;
    menuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
    if (header?.classList.contains('is-overlay')) {
      header.classList.toggle('is-solid', open || window.scrollY > 24);
    }
  };

  if (header?.classList.contains('is-overlay')) {
    const onScroll = () => {
      const menuOpen = mobileMenu?.hidden === false;
      header.classList.toggle('is-solid', menuOpen || window.scrollY > 24);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  menuButton?.addEventListener('click', () => {
    setOpen(mobileMenu?.hidden !== false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
