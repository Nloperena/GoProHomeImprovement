---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Our Work' },
  { href: '/about', label: 'About' },
  { href: '/areas', label: 'Areas' },
  { href: '/reviews', label: 'Reviews' },
];

const services = [
  { href: '/services/interior-exterior-painting', label: 'Painting' },
  { href: '/services/movie-rooms', label: 'Home Theaters' },
  { href: '/services/drywall', label: 'Drywall' },
  { href: '/services/power-washing', label: 'Power Washing' },
  { href: '/services/trim-crown-molding', label: 'Trim & Molding' },
  { href: '/services/murals', label: 'Murals' },
  { href: '/services/wallpaper', label: 'Wallpaper' },
  { href: '/services/tv-mounting', label: 'TV Mounting' },
  { href: '/services/demolition', label: 'Demolition' },
];

function isCurrent(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}

const onEstimatePage = currentPath === '/estimate';
---

<a href="#page-content" class="skip-link">Skip to content</a>

<header class="bg-gopro-charcoal sticky top-0 z-50 border-b-4 border-gopro-orange shadow-lg">
  <div class="container-custom">
    <div class="flex items-center justify-between gap-4 py-3">
      <a href="/" class="flex items-center shrink-0 rounded-sm">
        <img src="/images/logo.png" alt="Go Pro Home Improvements" class="h-14 md:h-16 w-auto" />
      </a>

      <nav class="hidden lg:flex items-center gap-5" aria-label="Primary">
        {navItems.map((item) => item.href === '/services' ? (
          <div class="relative group">
            <a
              href="/services"
              aria-current={isCurrent('/services') ? 'page' : undefined}
              aria-haspopup="true"
              class={`inline-flex items-center gap-1 font-display font-bold uppercase text-sm tracking-wide transition-colors ${
                isCurrent('/services') ? 'text-gopro-orange' : 'text-white hover:text-gopro-orange'
              }`}
            >
              Services
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path>
              </svg>
            </a>
            <div class="absolute left-0 top-full pt-3 hidden group-hover:block group-focus-within:block z-50">
              <div class="w-72 bg-gopro-black border border-white/10 rounded-lg shadow-2xl p-2 grid grid-cols-1">
                {services.map((service) => (
                  <a
                    href={service.href}
                    aria-current={isCurrent(service.href) ? 'page' : undefined}
                    class={`px-3 py-2 rounded text-sm font-sans font-semibold ${
                      isCurrent(service.href)
                        ? 'text-gopro-orange bg-white/5'
                        : 'text-white hover:text-gopro-orange hover:bg-white/5'
                    }`}
                  >
                    {service.label}
                  </a>
                ))}
                <a href="/services" class="px-3 py-2 mt-1 border-t border-white/10 text-sm font-display font-bold uppercase tracking-wide text-gopro-orange">
                  All services
                </a>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class={`font-display font-bold uppercase text-sm tracking-wide transition-colors ${
              isCurrent(item.href)
                ? 'text-gopro-orange'
                : 'text-white hover:text-gopro-orange'
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="hidden lg:flex items-center gap-3 shrink-0">
        <a
          href="tel:4072446873"
          class="inline-flex items-center gap-2 text-white hover:text-gopro-orange border border-white/40 hover:border-gopro-orange rounded px-3 py-2 font-sans font-semibold transition-colors"
        >
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
          </svg>
          <span>(407) 244-6873</span>
        </a>
        <a href="/estimate" class="bg-gopro-orange hover:bg-orange-600 text-gopro-black font-display font-bold uppercase px-6 py-3 rounded transition-colors inline-block tracking-wide">
          Free Estimate
        </a>
      </div>

      <button
        id="mobile-menu-button"
        type="button"
        class="lg:hidden p-3 -mr-1 text-white hover:text-gopro-orange rounded"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6 menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg class="w-6 h-6 menu-icon-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/20 bg-gopro-black max-h-[calc(100dvh-4.5rem)] overflow-y-auto" hidden>
    <nav class="container-custom py-2 flex flex-col" aria-label="Mobile">
      {navItems.map((item) => item.href === '/services' ? (
        <details class="border-b border-white/10">
          <summary class={`font-display font-bold uppercase text-base tracking-wide py-3 cursor-pointer list-none flex items-center justify-between ${
            isCurrent('/services') ? 'text-gopro-orange' : 'text-white'
          }`}>
            Services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="pb-3 flex flex-col">
            <a href="/services" class="py-3 pl-3 text-base font-sans font-semibold text-gopro-orange">All services</a>
            {services.map((service) => (
              <a
                href={service.href}
                aria-current={isCurrent(service.href) ? 'page' : undefined}
                class={`py-3 pl-3 text-base font-sans font-semibold ${
                  isCurrent(service.href) ? 'text-gopro-orange' : 'text-white'
                }`}
              >
                {service.label}
              </a>
            ))}
          </div>
        </details>
      ) : (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class={`font-display font-bold uppercase text-base tracking-wide py-3 border-b border-white/10 ${
            isCurrent(item.href) ? 'text-gopro-orange' : 'text-white'
          }`}
        >
          {item.label}
        </a>
      ))}
      <a href="tel:4072446873" class="mt-4 bg-gopro-orange text-gopro-black font-display font-bold uppercase py-4 text-center rounded tracking-wide">
        Call (407) 244-6873
      </a>
      <a href="/estimate" class="mt-3 mb-2 bg-white text-gopro-charcoal font-display font-bold uppercase py-4 text-center rounded tracking-wide">
        Free Estimate
      </a>
    </nav>
  </div>
</header>

<div id="page-content" tabindex="-1"></div>

<div class="site-call-bar lg:hidden fixed bottom-0 left-0 right-0 bg-gopro-charcoal shadow-2xl z-40 border-t-2 border-gopro-orange" style="padding-bottom: env(safe-area-inset-bottom, 0);">
  <div class="grid grid-cols-2 gap-2 p-2">
    <a
      href="tel:4072446873"
      class:list={[
        'bg-gopro-orange text-gopro-black hover:bg-orange-600 font-display font-bold uppercase py-2 px-2 text-center rounded transition-colors leading-tight flex flex-col items-center justify-center min-h-14',
        onEstimatePage && 'col-span-2',
      ]}
      aria-label="Call (407) 244-6873"
    >
      <span class="text-[11px] tracking-wide">Call now</span>
      <span class="text-sm tracking-normal normal-case font-sans">(407) 244-6873</span>
    </a>
    {!onEstimatePage && (
      <a
        href="/estimate"
        class="bg-white text-gopro-charcoal hover:bg-gray-100 font-display font-bold uppercase py-2 px-2 text-center rounded transition-colors text-sm tracking-wide border-2 border-gopro-orange flex items-center justify-center min-h-14"
      >
        Free Estimate
      </a>
    )}
  </div>
</div>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = menuButton?.querySelector('.menu-icon-open');
  const closeIcon = menuButton?.querySelector('.menu-icon-close');

  function setMenuOpen(open: boolean) {
    if (!mobileMenu || !menuButton) return;
    mobileMenu.classList.toggle('hidden', !open);
    mobileMenu.toggleAttribute('hidden', !open);
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    document.body.classList.toggle('nav-open', open);
  }

  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!open);
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });
</script>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 80;
    background: #fff;
    color: #1a1a1a;
    font-weight: 700;
    padding: 0.75rem 1rem;
    border-radius: 0.25rem;
  }

  .skip-link:focus {
    top: 0.75rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  :global(body.nav-open) .site-call-bar {
    visibility: hidden;
  }
</style>
