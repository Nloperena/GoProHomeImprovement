---
const currentYear = new Date().getFullYear();

const services = [
  { href: '/services/power-washing', label: 'Power Washing' },
  { href: '/services/interior-exterior-painting', label: 'Interior & Exterior Painting' },
  { href: '/services/demolition', label: 'Demolition' },
  { href: '/services/trim-crown-molding', label: 'Trim & Crown Molding' },
  { href: '/services/wallpaper', label: 'Wallpaper' },
  { href: '/services/murals', label: 'Murals' },
  { href: '/services/tv-mounting', label: 'TV Mounting' },
  { href: '/services/movie-rooms', label: 'Movie Rooms' },
  { href: '/services/drywall', label: 'Drywall' },
];

const areas = [
  { href: '/areas/kissimmee', label: 'Kissimmee' },
  { href: '/areas/orlando', label: 'Orlando' },
  { href: '/areas/central-florida', label: 'Central Florida' },
];

const company = [
  { href: '/about', label: 'About Us' },
  { href: '/work', label: 'Our Work' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/estimate', label: 'Get Estimate' },
];
---

<footer class="bg-gopro-black text-white border-t-4 border-gopro-orange">
  <div class="container-custom py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      <!-- Company Info -->
      <div>
        <div class="mb-4">
          <img src="/images/footer-logo.png" alt="Go Pro Home Improvements" class="h-10 w-auto" />
        </div>
        <p class="text-gray-300 mb-4">
          Owner-operated home improvement services in Central Florida with over 15 years of experience.
        </p>
        <div class="space-y-2 text-sm">
          <p>
            <a href="tel:4072446873" class="hover:text-gopro-orange transition-colors">
              (407) 244-6873
            </a>
          </p>
          <p>
            <a href="mailto:gopro4good@gmail.com" class="hover:text-gopro-orange transition-colors">
              gopro4good@gmail.com
            </a>
          </p>
          <p class="text-gray-400">Serving All of Central Florida</p>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-bold text-lg mb-4">Our Services</h3>
        <ul class="space-y-2">
          {services.map((service) => (
            <li>
              <a href={service.href} class="text-gray-300 hover:text-gopro-orange transition-colors text-sm">
                {service.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Service Areas -->
      <div>
        <h3 class="font-bold text-lg mb-4">Service Areas</h3>
        <ul class="space-y-2 mb-6">
          {areas.map((area) => (
            <li>
              <a href={area.href} class="text-gray-300 hover:text-gopro-orange transition-colors text-sm">
                {area.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="font-bold text-lg mb-4">Company</h3>
        <ul class="space-y-2 mb-6">
          {company.map((item) => (
            <li>
              <a href={item.href} class="text-gray-300 hover:text-gopro-orange transition-colors text-sm">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <div>
          <a
            href="https://www.instagram.com/gopro4good/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-gopro-orange transition-colors"
            aria-label="Follow us on Instagram"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-700 pt-8 text-center text-sm text-gray-400">
      <p>&copy; {currentYear} Go Pro Home Improvements. All rights reserved.</p>
    </div>
  </div>
</footer>
