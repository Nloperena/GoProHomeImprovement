---
const currentYear = new Date().getFullYear();

const services = [
  { href: '/services/power-washing', label: 'Power Washing' },
  { href: '/services/interior-exterior-painting', label: 'Interior & Exterior Painting' },
  { href: '/services/demolition', label: 'Demolition' },
  { href: '/services/trim-crown-molding', label: 'Trim & Crown Molding' },
  { href: '/services/wallpaper', label: 'Wallpaper' },
  { href: '/services/murals', label: 'Murals' },
  { href: '/services/tv-mounting', label: 'TV Mounting' },
  { href: '/services/movie-rooms', label: 'Movie Rooms' },
  { href: '/services/drywall', label: 'Drywall' },
];

const areas = [
  { href: '/areas/kissimmee', label: 'Kissimmee' },
  { href: '/areas/orlando', label: 'Orlando' },
  { href: '/areas/st-cloud', label: 'St. Cloud' },
  { href: '/areas/celebration', label: 'Celebration' },
  { href: '/areas/poinciana', label: 'Poinciana' },
  { href: '/areas/central-florida', label: 'Central Florida' },
];

const company = [
  { href: '/about', label: 'About Us' },
  { href: '/work', label: 'Our Work' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/guides', label: 'Guides' },
  { href: '/estimate', label: 'Get Estimate' },
];
---

<footer class="site-footer">
  <div class="container-custom py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <div>
        <a href="/" class="footer-logo">
          <img src="/images/logo.png" alt="Go Pro Home Improvements" width="290" height="97" />
        </a>
        <p class="mb-4 text-[0.98rem]">
          Owner-operated home improvement in Kissimmee. Florida corporation since 2014.
        </p>
        <p class="fine">Go Pro Home Improvements</p>
        <p class="mt-2">
          <a href="tel:4072446873">(407) 244-6873</a>
        </p>
        <p>
          <a href="mailto:gopro4good@gmail.com">gopro4good@gmail.com</a>
        </p>
        <p class="mt-2">
          <a href="https://www.instagram.com/gopro4good/" target="_blank" rel="noopener noreferrer">@gopro4good</a>
        </p>
        <p class="fine mt-3">Mon–Fri 7 AM–5 PM</p>
        <p class="fine mt-1">Kissimmee, Orlando, St. Cloud, Celebration, Poinciana & Central Florida</p>
      </div>

      <div>
        <h2>Services</h2>
        <ul>
          {services.map((service) => (
            <li><a href={service.href}>{service.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2>Service areas</h2>
        <ul>
          {areas.map((area) => (
            <li><a href={area.href}>{area.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2>Company</h2>
        <ul>
          {company.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p>&copy; {currentYear} Go Pro Home Improvements. All rights reserved. Florida corporation est. 2014</p>
    </div>
  </div>
</footer>
