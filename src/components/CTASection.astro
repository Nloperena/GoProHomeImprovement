---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  title = "Ready to Transform Your Home?",
  description = "Get a free, no-obligation estimate today. Our team is ready to bring your vision to life.",
  buttonText = "Get Free Estimate",
  buttonHref = "/estimate"
} = Astro.props;
---

<section class="bg-gopro-orange text-white section-padding">
  <div class="container-custom text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">{title}</h2>
    <p class="text-xl mb-8 max-w-2xl mx-auto">{description}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={buttonHref} class="btn-secondary">
        {buttonText}
      </a>
      <a href="tel:4072446873" class="bg-white text-gopro-orange hover:bg-gray-100 font-semibold px-6 py-3 rounded-lg transition-colors duration-200 inline-block">
        Call (407) 244-6873
      </a>
    </div>
  </div>
</section>
