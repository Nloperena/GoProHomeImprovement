---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  title = "Want a price for the job?",
  description = "Tell us what the house needs. We'll call you back with a free estimate, or call (407) 244-6873. Monday through Friday, 7 AM to 5 PM.",
  buttonText = "Request a free estimate",
  buttonHref = "/estimate"
} = Astro.props;
---

<section class="cta-band section-padding">
  <img
    class="cta-photo"
    src="/images/star-wars-theater-1100.jpg"
    alt=""
    width="1100"
    height="826"
    loading="lazy"
    decoding="async"
  />
  <div class="cta-shade" aria-hidden="true"></div>
  <div class="container-custom">
    <p class="kicker">Kissimmee · Mon–Fri, 7 AM to 5 PM</p>
    <h2>{title}</h2>
    <p class="lede">{description}</p>
    <div class="cta-actions">
      <a href={buttonHref} class="btn-primary">{buttonText}</a>
      <a href="tel:4072446873" class="btn-ghost">Call (407) 244-6873</a>
    </div>
  </div>
</section>
