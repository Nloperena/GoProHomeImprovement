---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  title = "Ready to Transform Your Home?",
  description = "Get a free, no-obligation estimate today. Our team is ready to bring your vision to life.",
  buttonText = "Get Free Estimate",
  buttonHref = "/estimate"
} = Astro.props;
---

<section class="bg-gopro-orange text-white section-padding relative overflow-hidden border-y-4 border-gopro-black">
  <div class="container-custom text-center relative">
    <h2 class="text-4xl md:text-5xl font-display font-black uppercase mb-6 tracking-tight">{title}</h2>
    <p class="text-xl md:text-2xl mb-10 max-w-3xl mx-auto font-sans">{description}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={buttonHref} class="bg-gopro-charcoal hover:bg-gopro-black text-white font-display font-bold uppercase px-10 py-5 rounded transition-all inline-block text-lg shadow-2xl hover:shadow-xl tracking-wide">
        {buttonText}
      </a>
      <a href="tel:4072446873" class="bg-white text-gopro-charcoal hover:bg-gray-100 font-display font-bold uppercase px-10 py-5 rounded transition-all inline-block text-lg shadow-2xl hover:shadow-xl tracking-wide">
        Call (407) 244-6873
      </a>
    </div>
  </div>
</section>
