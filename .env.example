# Nexrena Form API Secret
# Required for estimate form submissions to reach the Nexrena portal
# Get this value from the GOPRO_FORM_SECRET environment variable on nexrena-api (Heroku)
GOPRO_FORM_SECRET=your-secret-here

# Form Token Secret (for HMAC signing)
# Generate a secure random string (e.g., openssl rand -hex 32)
FORM_TOKEN_SECRET=your-token-secret-here

# Cloudflare Turnstile (Optional - set to 'true' to enable)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=your-turnstile-secret-here
TURNSTILE_SITE_KEY=your-turnstile-site-key-here
